# Всё едет на роутер и исполняется busybox ash. Клон на Windows без этой
# строки отдаёт файлы с CRLF, и тогда /usr/sbin/netkit получает шебанг
# "#!/bin/sh\r" — ядро ищет интерпретатор с возвратом каретки в имени и
# отвечает "not found". Значения в kit.conf получают хвостовой \r, из-за
# чего [ "$PROXY_ENABLE" = 1 ] ложно и половина кита тихо выключается.
* text=auto eol=lf
