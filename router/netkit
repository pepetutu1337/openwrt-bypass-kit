#!/bin/sh
# ============================================================
#  netkit — движок кита, живёт на роутере (OpenWrt, busybox ash).
#  Всё делает здесь; с компа его дёргает netctl по SSH.
#  Конфиги: /etc/netkit/{kit.conf,nodes.list,domains.list,
#                        telegram-cidr.list,zapret.conf}
# ============================================================
set -eu
export LC_ALL=C

CFG=/etc/netkit
[ -f "$CFG/kit.conf" ] || { echo "нет $CFG/kit.conf (сначала netctl push/install)"; exit 1; }
. "$CFG/kit.conf"
[ -f "$CFG/zapret.conf" ] && . "$CFG/zapret.conf"

: "${REDIRECT_PORT:=1100}"; : "${DOH_PORT:=5053}"; : "${LAN_IFACE:=br-lan}"
: "${PROXY_ENABLE:=1}"; : "${DOH_ENABLE:=1}"; : "${ZAPRET_ENABLE:=1}"
: "${FAILOVER:=1}"; : "${FAILOVER_INTERVAL:=15m}"; : "${BLOCK_QUIC:=1}"
: "${DOH_UPSTREAM:=https://1.1.1.1/dns-query}"; : "${ZAPRET_VERSION:=v72.12}"
# второй DoH-резолвер (резервирование DNS; пусто = не создавать)
: "${DOH_UPSTREAM2:=https://8.8.8.8/dns-query}"; : "${DOH_PORT2:=5054}"
# split-DNS: РФ-зоны через российский резолвер (чинит VTB и пр., что прячут DNS от иностранцев)
: "${SPLIT_RU_ENABLE:=1}"; : "${RU_DNS:=77.88.8.8}"; : "${RU_DNS2:=77.88.8.1}"
: "${RU_DOH_ENABLE:=1}"; : "${RU_DOH_PORT:=5055}"; : "${RU_DOH_UPSTREAM:=https://77.88.8.8/dns-query}"
# Порт резолвера, который ходит через ноду: запасной путь для dnsmasq на случай,
# когда до публичных DoH-адресов не достучаться.
: "${NODE_DNS_PORT:=5056}"
# авто-список ушедших из РФ сервисов
: "${GEOBLOCK_ENABLE:=1}"; : "${GEOBLOCK_CRON:=15 4 * * *}"
: "${GEOBLOCK_URL:=https://raw.githubusercontent.com/itdoginfo/allow-domains/refs/heads/main/Categories/geoblock.lst}"
: "${GEOBLOCK_URL2:=https://cdn.jsdelivr.net/gh/itdoginfo/allow-domains@main/Categories/geoblock.lst}"
: "${GEOBLOCK_URL3:=https://gh-proxy.com/https://raw.githubusercontent.com/itdoginfo/allow-domains/refs/heads/main/Categories/geoblock.lst}"
: "${GEOBLOCK_MAXAGE:=1209600}"
# сторож нод (авто-восстановление прокси)
: "${WATCHDOG_ENABLE:=1}"; : "${WATCHDOG_CRON:=*/3 * * * *}"
# авто-обновление CIDR Telegram (MTProto ходит по IP, список протухает)
# звонки в Telegram: голос ходит по UDP, а redirect ловит только TCP
: "${CALLS_ENABLE:=1}"; : "${TPROXY_PORT:=1101}"; : "${TPROXY_MARK:=1}"; : "${TPROXY_TABLE:=100}"
: "${TELEGRAM_CIDR_AUTOUPDATE:=1}"; : "${TELEGRAM_CIDR_CRON:=30 4 * * 0}"
: "${TELEGRAM_CIDR_URL:=https://core.telegram.org/resources/cidr.txt}"
# --- обновление подписок через netpult (несколько ссылок, банк живых нод,
#     дистанционный канал: бот + запечатанный манифест). Вся секция за
#     SUB_ENABLE; без неё ноды правятся только руками через nodes.list.
: "${SUB_ENABLE:=0}"
: "${NETPULT_VERSION:=v0.5.0}"
: "${SUB_UPDATE_CRON:=45 4 * * *}"     # полный refresh: перечитать все подписки + sync
: "${SUB_POLL_CRON:=*/7 * * * *}"      # забор новых ссылок из бота/манифеста
: "${SUB_BOT_TOKEN:=}"                 # токен Telegram-бота (пусто = бот выключен)
: "${SUB_BOT_CHAT:=}"                  # твой chat_id — команды слушаются только оттуда
: "${SUB_MANIFEST_URL:=}"             # URL запечатанного манифеста (гист/pastebin/свой VPS)
: "${SUB_HMAC_KEY:=}"                  # общий секрет: шифр и подпись манифеста
NETPULT_DIR=/etc/netkit/netpult       # XDG_DATA_HOME: список подписок, банк, offset бота
SBOX=/etc/sing-box/config.json
NFT=/etc/nftables.d/20-proxy.nft
DNSD=/etc/dnsmasq.d/netkit.conf
SPLITD=/etc/dnsmasq.d/split-ru.conf
GEOBLOCKD=/etc/dnsmasq.d/geoblock.conf
MARKD=/etc/dnsmasq.d/netkit-mark.conf
SOCKS_DIAG=10800; CLASH=127.0.0.1:9090; CLASH_PORT=9090

say()  { printf '\033[1;36m::\033[0m %s\n' "$*"; }
ok()   { printf '  \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[1;33m!\033[0m %s\n' "$*"; }
err()  { printf '  \033[1;31m✗\033[0m %s\n' "$*"; }
have() { command -v "$1" >/dev/null 2>&1; }
PKG=$(have apk && echo apk || echo opkg)
pkg_add() { if [ "$PKG" = apk ]; then apk add --no-cache "$@"; else opkg update >/dev/null 2>&1; opkg install "$@"; fi; }

# все НЕпустые, НЕкомментарии строки файла.
# Комментарий — только строка целиком (# в начале); # внутри строки НЕ трогаем,
# иначе поломаются vless://…#Имя (фрагмент с названием ноды).
lines() { grep -v '^[[:space:]]*#' "$1" 2>/dev/null | sed 's/[[:space:]]*$//' | grep -v '^[[:space:]]*$' || true; }

# ---------- зависимости: проверяет каждую и докачивает недостающее ----------
need_pkg() {  # $1=команда/признак  $2=имя пакета  $3=описание
  if have "$1"; then ok "$3 — есть"; return 0; fi
  warn "$3 — нет, ставлю ($2)…"
  if pkg_add "$2" >/dev/null 2>&1 && have "$1"; then ok "$3 — поставлен"; return 0; fi
  err "$3 — НЕ удалось поставить ($2). Проверь интернет на роутере / фиды."; return 1
}
ensure_deps() {
  say "проверяю зависимости ($PKG), недостающее докачаю"
  [ "$PKG" = opkg ] && { opkg update >/dev/null 2>&1 || warn "opkg update не прошёл (нет инета?)"; }
  miss=0
  need_pkg curl curl "curl"                     || miss=1
  need_pkg jq   jq   "jq"                        || miss=1
  [ "$PROXY_ENABLE" = 1 ] && { need_pkg sing-box sing-box "sing-box"; [ $? = 0 ] || miss=1; }
  if [ "$DOH_ENABLE" = 1 ] && ! have https-dns-proxy; then
    warn "https-dns-proxy — нет, ставлю…"
    pkg_add https-dns-proxy >/dev/null 2>&1
    have https-dns-proxy && ok "https-dns-proxy — поставлен" || { err "https-dns-proxy — не поставился"; miss=1; }
  else [ "$DOH_ENABLE" = 1 ] && ok "https-dns-proxy — есть"; fi
  # dnsmasq-full нужен для nftset-наборов (обычный собран без них)
  if dnsmasq --help 2>&1 | grep -q -- '--nftset'; then ok "dnsmasq-full (nftset) — есть"
  else
    warn "dnsmasq без nftset — меняю на dnsmasq-full (иначе наборы не заведутся)"
    # DNS на время подмены пакета. Провайдерский резолвер оставляем первым:
    # открытый 53 наружу теперь перехватывает ТСПУ, а репозиторий OpenWrt
    # никто не блокирует — свой резолвер отдаст его вернее чужого.
    { cat /tmp/resolv.conf.d/resolv.conf.auto 2>/dev/null | grep '^nameserver'
      echo 'nameserver 1.1.1.1'; } > /etc/resolv.conf
    if [ "$PKG" = apk ]; then apk del dnsmasq 2>/dev/null || true; apk add --no-cache dnsmasq-full >/dev/null 2>&1
    else opkg remove dnsmasq 2>/dev/null || true; opkg install dnsmasq-full >/dev/null 2>&1; fi
    ln -sf /tmp/resolv.conf.d/resolv.conf.auto /etc/resolv.conf 2>/dev/null || ln -sf /tmp/resolv.conf /etc/resolv.conf 2>/dev/null || true
    /etc/init.d/dnsmasq restart 2>/dev/null || true
    dnsmasq --help 2>&1 | grep -q -- '--nftset' && ok "dnsmasq-full — поставлен" || { err "dnsmasq-full не встал"; miss=1; }
  fi
  [ "$miss" = 0 ] && ok "все зависимости на месте" || { err "часть зависимостей не встала — см. выше"; return 1; }
}

# ---------- один VLESS-URL → JSON-outbound для sing-box ----------
vless_outbound() {  # $1=tag  $2=url  ->  compact JSON
  tag="$1"; url="$2"
  b="${url#vless://}"; b="${b%%#*}"
  uuid="${b%%@*}"; rest="${b#*@}"
  hp="${rest%%\?*}"; q="${rest#*\?}"; [ "$q" = "$rest" ] && q=""
  host="${hp%%:*}"; port="${hp##*:}"
  qp() { printf '%s' "$q" | tr '&' '\n' | sed -n "s/^$1=//p" | head -n1; }
  sni=$(qp sni); pbk=$(qp pbk); sid=$(qp sid); fp=$(qp fp)
  flow=$(qp flow); typ=$(qp type); svc=$(qp serviceName)
  [ -z "$fp" ] && fp=chrome
  case "$port" in ''|*[!0-9]*) err "нода '$tag': кривой порт '$port'"; return 1;; esac
  jq -cn --arg tag "$tag" --arg s "$host" --argjson p "$port" --arg u "$uuid" \
     --arg sni "$sni" --arg pbk "$pbk" --arg sid "$sid" --arg fp "$fp" \
     --arg flow "$flow" --arg typ "$typ" --arg svc "$svc" '
     {type:"vless",tag:$tag,server:$s,server_port:$p,uuid:$u,
      tls:{enabled:true,server_name:$sni,
           utls:{enabled:true,fingerprint:$fp},
           reality:({enabled:true,public_key:$pbk} + (if $sid=="" then {} else {short_id:$sid} end))},
      packet_encoding:"xudp"}
     + (if ($flow=="" or $typ=="grpc") then {} else {flow:$flow} end)
     + (if $typ=="grpc" then {transport:{type:"grpc",service_name:(if $svc=="" then "vless" else $svc end)}} else {} end)'
}

node_tags() { i=0; lines "$CFG/nodes.list" | while IFS= read -r u; do i=$((i+1)); echo "node$i"; done; }

# ---------- генерация /etc/sing-box/config.json ----------
gen_singbox() {
  tmp=$(mktemp); : > "$tmp"; n=0
  while IFS= read -r url; do
    n=$((n+1)); vless_outbound "node$n" "$url" >> "$tmp" || { rm -f "$tmp"; return 1; }
  done <<EOF
$(lines "$CFG/nodes.list")
EOF
  [ "$n" -gt 0 ] || { err "в nodes.list нет ни одной ноды"; rm -f "$tmp"; return 1; }
  tags=$(node_tags | jq -R . | jq -cs .)
  if [ "$FAILOVER" = 1 ]; then defo=auto; else defo=node1; fi
  mkdir -p /etc/sing-box
  jq -n \
    --slurpfile outs "$tmp" \
    --argjson tags "$tags" \
    --arg def "$defo" \
    --argjson rport "$REDIRECT_PORT" \
    --argjson sport "$SOCKS_DIAG" \
    --arg interval "$FAILOVER_INTERVAL" \
    --argjson fo "$([ "$FAILOVER" = 1 ] && echo true || echo false)" \
    --argjson dnsport "$NODE_DNS_PORT" \
    --argjson calls "$( [ "$CALLS_ENABLE" = 1 ] && echo true || echo false )" \
    --argjson tport "$TPROXY_PORT" \
    --arg rudns "$RU_DNS" \
    --arg rudns2 "${RU_DNS2:-$RU_DNS}" '
    {
      log:{level:"warn",timestamp:true},
      experimental:{clash_api:{external_controller:"127.0.0.1:9090"}},
      # Резолвер, который ходит ЧЕРЕЗ ноду. Он нужен не вместо https-dns-proxy,
      # а на случай, когда тот перестанет работать: адреса публичных резолверов
      # известны наперечёт, и закрыть к ним 443 — работа на полчаса. Запрос
      # внутри туннеля так закрыть нельзя, не закрыв туннель.
      #
      # Второй резолвер, doh-direct, нужен самому ядру: часть нод задана
      # именем, и его надо чем-то разрешать ДО того, как нода поднята. Отсюда и
      # правило маршрута ниже — российский резолвер ходит только напрямую,
      # иначе получается круг: чтобы поднять ноду, нужно имя, а чтобы получить
      # имя, нужна нода. detour:"direct" тут не годится, ядро отвергает
      # «detour в пустой direct» (проверено живьём на 1.12.17).
      dns:{
        servers:[
          {type:"https",tag:"doh-node",server:"1.1.1.1",detour:"proxy"},
          {type:"https",tag:"doh-direct",server:$rudns}
        ],
        final:"doh-node",
        strategy:"ipv4_only"
      },
      inbounds:[
        # sniff_override_destination:true — соединение уходит на ноду доменом,
        # а не локально нарезолвленным адресом. Иначе проксируемый сайт может
        # не открываться из-за протухшего или подменённого локального ответа DNS.
        {type:"redirect",tag:"redir",listen:"0.0.0.0",listen_port:$rport,sniff:true,sniff_override_destination:true},
        {type:"socks",tag:"diag",listen:"127.0.0.1",listen_port:$sport},
        {type:"direct",tag:"dns-in",listen:"127.0.0.1",listen_port:$dnsport,network:"udp"}
      ]
        # Голос звонков — UDP, и redirect его не ловит: redirect умеет только
        # TCP. tproxy забирает UDP, не трогая маршрут по умолчанию, — в отличие
        # от TUN, который на слабом железе кладёт роутер целиком.
        + (if $calls then [ {type:"tproxy",tag:"tproxy-in",listen:"0.0.0.0",listen_port:$tport,network:"udp",sniff:true} ] else [] end),
      outbounds:
        ($outs)
        + [ {type:"selector",tag:"proxy",outbounds:(($tags)+(if $fo then ["auto"] else [] end)),default:$def} ]
        + (if $fo then [ {type:"urltest",tag:"auto",outbounds:$tags,url:"https://www.gstatic.com/generate_204",interval:$interval,tolerance:80} ] else [] end)
        + [ {type:"direct",tag:"direct"} ],
      route:{
        default_domain_resolver:{server:"doh-direct"},
        rules:[
          {inbound:["dns-in"],action:"hijack-dns"},
          {ip_is_private:true,outbound:"direct"},
          {ip_cidr:[($rudns+"/32"),($rudns2+"/32")],outbound:"direct"}
        ],
        final:"proxy",
        auto_detect_interface:true
      }
    }' > "$SBOX"
  rm -f "$tmp"
  if have sing-box && ! sing-box check -c "$SBOX" 2>/tmp/sbox.err; then
    err "sing-box забраковал конфиг:"; cat /tmp/sbox.err; return 1
  fi
  ok "sing-box config сгенерирован ($n нод)"
}

# ---------- nftables: наборы proxy4/proxy6 + redirect-цепочка ----------
#
# Сам файл правил пишет отдельный скрипт на роутере: его же зовёт ночное
# обновление CIDR Telegram. Два места, писавшие один и тот же файл своими
# руками, разъезжались — в одном появлялась цепочка, в другом нет.
deploy_nft_gen() {
  cat > /usr/sbin/kit-nft-gen <<EOF
#!/bin/sh
# генерируется netkit — правь config/*, не тут.
# Собирает $NFT из списка сетей Telegram и настроек кита.
set -eu
LIST="$CFG/telegram-cidr.list"
OUT="$NFT"
LANIF="$LAN_IFACE"
RPORT="$REDIRECT_PORT"
CALLS="$CALLS_ENABLE"
TPORT="$TPROXY_PORT"
MARK="$TPROXY_MARK"
lines() { grep -v '^#' "\$1" 2>/dev/null | sed 's/[[:space:]]*\$//' | grep -v '^\$' || true; }
# Склейка через tr, а не paste: paste в стоковой busybox не собран
# (BUSYBOX_DEFAULT_PASTE=n), и на чистом роутере его просто нет. Раньше
# «paste: not found» гасился через || true, наборы tg4/tg6 оставались
# пустыми, и Telegram — который ходит по IP, а не по домену — навсегда шёл
# мимо ноды. Снаружи выглядело как «работает всё, кроме телеги».
v4=\$(lines "\$LIST" | grep -F . | grep -v : | tr '\n' ',' || true); v4=\${v4%,}
v6=\$(lines "\$LIST" | grep -F : | tr '\n' ',' || true); v6=\${v6%,}
tmp="\$(dirname "\$OUT")/.20-proxy.tmp"
{
  echo "# генерируется netkit (kit-nft-gen) — правь config/telegram-cidr.list, не тут"
  echo "set proxy4 { type ipv4_addr; flags interval; auto-merge;"
  [ -n "\$v4" ] && echo "  elements = { \$v4 };"
  echo "}"
  echo "set proxy6 { type ipv6_addr; flags interval; auto-merge;"
  [ -n "\$v6" ] && echo "  elements = { \$v6 };"
  echo "}"
  # Телеграм держим отдельным набором: в proxy4 dnsmasq досыпает адреса
  # заблокированных сайтов, а голос звонков надо отличать от них.
  echo "set tg4 { type ipv4_addr; flags interval; auto-merge;"
  [ -n "\$v4" ] && echo "  elements = { \$v4 };"
  echo "}"
  echo "set tg6 { type ipv6_addr; flags interval; auto-merge;"
  [ -n "\$v6" ] && echo "  elements = { \$v6 };"
  echo "}"
  echo "chain proxy_redirect {"
  echo "  type nat hook prerouting priority -1; policy accept;"
  echo "  iifname \"\$LANIF\" ip  daddr @proxy4 tcp dport {80,443} redirect to :\$RPORT"
  echo "  iifname \"\$LANIF\" ip6 daddr @proxy6 tcp dport {80,443} redirect to :\$RPORT"
  echo "}"
  if [ "\$CALLS" = 1 ]; then
    echo "chain tg_tproxy {"
    echo "  type filter hook prerouting priority mangle; policy accept;"
    # В семействе inet у tproxy обязателен указатель семейства адресов
    # («tproxy ip to», не «tproxy to»): без него nft молча не грузит правило,
    # и цепочка остаётся пустой — ловилось на живом роутере.
    echo "  iifname \"\$LANIF\" ip  daddr @tg4 meta l4proto udp tproxy ip  to :\$TPORT meta mark set \$MARK accept"
    echo "  iifname \"\$LANIF\" ip6 daddr @tg6 meta l4proto udp tproxy ip6 to :\$TPORT meta mark set \$MARK accept"
    echo "}"
  fi
} > "\$tmp"
mv "\$tmp" "\$OUT"
EOF
  chmod +x /usr/sbin/kit-nft-gen
}

gen_nft() {
  mkdir -p /etc/nftables.d
  deploy_nft_gen
  /usr/sbin/kit-nft-gen
  ok "nft-наборы и цепочки записаны ($NFT)"
}

# ---------- звонки: policy-routing для tproxy ----------
#
# tproxy отдаёт пакет локальному сокету, но ядро довезёт его туда только если
# помеченный пакет уходит в таблицу с локальным маршрутом. Правило и маршрут
# живут в памяти, поэтому восстанавливаются при каждом подъёме интерфейса.
setup_calls() {
  [ "$CALLS_ENABLE" = 1 ] || { rm -f /etc/hotplug.d/iface/99-kit-tproxy; return 0; }
  if ! lsmod 2>/dev/null | grep -q nft_tproxy; then
    apk add kmod-nft-tproxy >/dev/null 2>&1 || opkg install kmod-nft-tproxy >/dev/null 2>&1 || true
  fi
  mkdir -p /etc/hotplug.d/iface
  cat > /etc/hotplug.d/iface/99-kit-tproxy <<EOF
#!/bin/sh
# генерируется netkit. Метка $TPROXY_MARK -> таблица $TPROXY_TABLE с локальным
# маршрутом: без этого tproxy молча роняет пакеты.
[ "\$ACTION" = ifup ] || exit 0
ip rule show | grep -q "fwmark $TPROXY_MARK lookup $TPROXY_TABLE" || \
  ip rule add fwmark $TPROXY_MARK lookup $TPROXY_TABLE
ip route replace local 0.0.0.0/0 dev lo table $TPROXY_TABLE
EOF
  chmod +x /etc/hotplug.d/iface/99-kit-tproxy
  ip rule show | grep -q "fwmark $TPROXY_MARK lookup $TPROXY_TABLE" || \
    ip rule add fwmark "$TPROXY_MARK" lookup "$TPROXY_TABLE"
  ip route replace local 0.0.0.0/0 dev lo table "$TPROXY_TABLE"
  ok "звонки: tproxy на :$TPROXY_PORT, метка $TPROXY_MARK -> таблица $TPROXY_TABLE"
}

# ---------- https-dns-proxy: 1-2 чистых зарубежных DoH-резолвера ----------
_doh_instance() {  # $1=port $2=url [$3=bootstrap]
  s=$(uci add https-dns-proxy https-dns-proxy)
  uci set https-dns-proxy.$s.listen_addr='127.0.0.1'
  uci set https-dns-proxy.$s.listen_port="$1"
  # Бутстрап нужен только чтобы разрезолвить имя самого DoH-сервера. У нас все
  # URL в IP-форме, так что он не используется, но https-dns-proxy требует
  # непустое значение. Российскому инстансу даём российский бутстрап: если
  # зарубежный 53 однажды заглушат целиком, он не должен утянуть за собой
  # резолв банков.
  uci set https-dns-proxy.$s.bootstrap_dns="${3:-1.1.1.1,8.8.8.8}"
  uci set https-dns-proxy.$s.resolver_url="$2"
  uci set https-dns-proxy.$s.user='nobody'; uci set https-dns-proxy.$s.group='nogroup'
}
gen_doh() {
  [ "$DOH_ENABLE" = 1 ] || return 0
  while uci -q delete https-dns-proxy.@https-dns-proxy[0]; do :; done 2>/dev/null || true
  _doh_instance "$DOH_PORT"  "$DOH_UPSTREAM"
  msg="127.0.0.1:$DOH_PORT ($DOH_UPSTREAM)"
  if [ -n "$DOH_UPSTREAM2" ] && [ -n "$DOH_PORT2" ]; then
    _doh_instance "$DOH_PORT2" "$DOH_UPSTREAM2"
    msg="$msg + 127.0.0.1:$DOH_PORT2 ($DOH_UPSTREAM2)"
  fi
  # Российский DoH — отдельным инстансом, на него смотрит split-DNS.
  if [ "$SPLIT_RU_ENABLE" = 1 ] && [ "$RU_DOH_ENABLE" = 1 ] && [ -n "$RU_DOH_UPSTREAM" ]; then
    _doh_instance "$RU_DOH_PORT" "$RU_DOH_UPSTREAM" "$RU_DNS,${RU_DNS2:-$RU_DNS}"
    msg="$msg + 127.0.0.1:$RU_DOH_PORT ($RU_DOH_UPSTREAM, РФ-зоны)"
  fi
  uci -q set https-dns-proxy.config.update_dnsmasq_config='-'  # не перехватывать весь DNS сами
  uci -q set https-dns-proxy.config.force_dns='0'
  uci commit https-dns-proxy
  /etc/init.d/https-dns-proxy enable 2>/dev/null || true
  /etc/init.d/https-dns-proxy restart 2>/dev/null || true
  ok "DoH-резолверы: $msg"
}

# ---------- политика резолвера: весь DNS через чистый DoH по умолчанию ----------
gen_dns_upstream() {
  [ "$DOH_ENABLE" = 1 ] || return 0
  # снимаем прежние дефолтные апстримы, ставим DoH-петли, игнорируем провайдерский resolv
  uci -q delete dhcp.@dnsmasq[0].server 2>/dev/null || true
  uci add_list dhcp.@dnsmasq[0].server="127.0.0.1#$DOH_PORT"
  [ -n "$DOH_PORT2" ] && uci add_list dhcp.@dnsmasq[0].server="127.0.0.1#$DOH_PORT2"
  # Третьим — резолвер, уходящий через ноду. dnsmasq сам предпочитает тот
  # апстрим, что отвечает быстрее, поэтому в обычное время он туда почти не
  # ходит: путь через туннель заведомо длиннее. Но если до публичных
  # DoH-адресов однажды не достучаться — а закрыть 443 к десятку известных
  # адресов дело недолгое, — дом останется с DNS, потому что запрос внутри
  # туннеля так не закрыть, не закрыв туннель.
  [ "$PROXY_ENABLE" = 1 ] && uci add_list dhcp.@dnsmasq[0].server="127.0.0.1#$NODE_DNS_PORT"
  uci set dhcp.@dnsmasq[0].noresolv='1'
  uci commit dhcp
}

# ---------- split-DNS: РФ-зоны и РФ-сервисы через российский резолвер ----------
gen_splitdns() {
  [ "$SPLIT_RU_ENABLE" = 1 ] || { rm -f "$SPLITD"; return 0; }
  mkdir -p /etc/dnsmasq.d
  {
    echo "# генерируется netkit — РФ-зоны/сервисы через российский DNS,"
    echo "# т.к. зарубежный DoH их не видит (VTB и пр. прячут DNS от иностранцев)."
    lines "$CFG/ru-split.list" | while IFS= read -r z; do
      if [ "$RU_DOH_ENABLE" = 1 ]; then
        echo "server=/$z/127.0.0.1#$RU_DOH_PORT"
      else
        echo "server=/$z/$RU_DNS"
        [ -n "$RU_DNS2" ] && echo "server=/$z/$RU_DNS2"
      fi
    done
  } > "$(dirname "$SPLITD")/.$(basename "$SPLITD").tmp"
  # mv в той же папке атомарен. Имя временного файла — с точки: dnsmasq читает
  # conf-dir целиком, и обрубок с обычным именем стал бы живым куском конфига.
  mv "$(dirname "$SPLITD")/.$(basename "$SPLITD").tmp" "$SPLITD"
  if [ "$RU_DOH_ENABLE" = 1 ]; then
    ok "split-DNS: $(lines "$CFG/ru-split.list" | wc -l) РФ-зон/сервисов → DoH 127.0.0.1:$RU_DOH_PORT"
  else
    ok "split-DNS: $(lines "$CFG/ru-split.list" | wc -l) РФ-зон/сервисов → $RU_DNS (открытый 53)"
  fi
}

# Адрес РФ-имени так, как его увидит любой домашний клиент: спрашиваем dnsmasq,
# а не резолвер напрямую. Спрашивать напрямую бессмысленно — проверять надо ту
# дорогу, по которой пойдёт трафик.
ru_ip() {
  nslookup "${1:-www.vtb.ru}" 127.0.0.1 2>/dev/null |
    awk '/^Address/{print $NF}' | grep -v '#' | grep '\.' | tail -1
}

# После переключения РФ-зон на DoH проверяем, что они вообще резолвятся, и
# откатываемся на открытый 53, если нет. Рабочий DNS важнее шифрованного:
# без него банки просто не открываются, а это худшая из двух бед.
verify_ru_doh() {
  [ "$SPLIT_RU_ENABLE" = 1 ] && [ "$RU_DOH_ENABLE" = 1 ] || return 0
  i=0
  while [ "$i" -lt 5 ]; do
    rip=$(ru_ip)
    [ -n "$rip" ] && { ok "РФ-резолв через DoH работает (www.vtb.ru → $rip)"; return 0; }
    i=$((i + 1)); sleep 2
  done
  warn "РФ-имена не резолвятся через DoH — возвращаю открытый 53"
  RU_DOH_ENABLE=0
  gen_splitdns
  /etc/init.d/dnsmasq restart 2>/dev/null || true
  sleep 2
  rip=$(ru_ip)
  [ -n "$rip" ] && warn "откатился на открытый 53, РФ-резолв жив (www.vtb.ru → $rip)" \
                || err "РФ-имена не резолвятся ни через DoH, ни напрямую — смотри logread -e dnsmasq"
  return 0
}

# ---------- метка «это роутер кита» ----------
# Раскладка доменов по маршрутам держится на том, что dnsmasq видит DNS-запросы
# клиентов: имя спросили — адрес попал в набор — трафик свернул в туннель.
# Машина со своим шифрованным резолвером обходит dnsmasq стороной, роутер нужных
# адресов не видит, и её сайты уходят напрямую мимо ноды. Внешне это выглядит
# как «сайт не грузится без VPN», а не как поломка DNS, и ищется долго.
#
# По этой метке netpult на клиенте узнаёт такой роутер и отдаёт DNS ему, вместо
# того чтобы поднимать своё поверх. Зона .invalid (RFC 2606) не существует по
# определению, поэтому ответ может прийти только отсюда. Адрес — из
# документационной сети 192.0.2.0/24 (RFC 5737): защита от DNS-rebind режет
# ответы в 127.0.0.0/8 и в частных сетях, и метка на таком адресе не доезжает.
gen_mark() {
  mkdir -p /etc/dnsmasq.d
  {
    echo "# генерируется netkit — метка кита для netpult на клиентах"
    echo "address=/kit.netpult.invalid/192.0.2.7"
  } > "$MARKD"
  ok "метка кита: kit.netpult.invalid → 192.0.2.7"
}

# ---------- dnsmasq: проксируемые домены → наборы proxy4/6 ----------
gen_dns() {
  mkdir -p /etc/dnsmasq.d
  {
    echo "# генерируется netkit — правь config/domains.list"
    lines "$CFG/domains.list" | while IFS= read -r d; do
      echo "nftset=/$d/4#inet#fw4#proxy4"
      echo "nftset=/$d/6#inet#fw4#proxy6"
    done
  } > "$DNSD"
  gen_mark
  gen_dns_upstream
  gen_splitdns
  # заставляем dnsmasq читать нашу папку
  uci -q set dhcp.@dnsmasq[0].confdir='/etc/dnsmasq.d'
  uci commit dhcp
  /etc/init.d/dnsmasq restart
  ok "dnsmasq: $(lines "$CFG/domains.list" | wc -l) проксируемых доменов в наборы"
  verify_ru_doh
}

# ---------- IPv6 на LAN: гасим, чтобы не текло мимо IPv4-ноды ----------
gen_ipv6() {
  [ "${LAN_IPV6:-disabled}" = disabled ] || { ok "IPv6 на LAN не трогаю (LAN_IPV6=keep)"; return 0; }
  uci -q set dhcp.lan.ra='disabled'
  uci -q set dhcp.lan.dhcpv6='disabled'
  uci -q set dhcp.lan.ndp='disabled'
  uci -q delete network.lan.ip6assign 2>/dev/null || true
  uci commit dhcp; uci commit network
  /etc/init.d/odhcpd restart 2>/dev/null || true
  ok "IPv6 на LAN отключён (нет утечек заблокированных сайтов мимо ноды)"
}

# ---------- QUIC-блок (чтобы плееры откатывались на пробитый TCP) ----------
gen_quic() {
  uci -q delete firewall.netkit_quic 2>/dev/null || true
  if [ "$BLOCK_QUIC" = 1 ]; then
    uci set firewall.netkit_quic=rule
    uci set firewall.netkit_quic.name='netkit-block-quic'
    uci set firewall.netkit_quic.src='lan'; uci set firewall.netkit_quic.dest='wan'
    uci set firewall.netkit_quic.proto='udp'; uci set firewall.netkit_quic.dest_port='443'
    uci set firewall.netkit_quic.target='REJECT'
    ok "QUIC (udp/443 lan→wan) режется"
  fi
  uci commit firewall
}

# ---------- zapret ----------
zapret_present() { [ -x /opt/zapret/init.d/openwrt/zapret ] || [ -f /opt/zapret/config ]; }
zapret_install() {
  zapret_present && return 0
  say "качаю и ставлю zapret $ZAPRET_VERSION в /opt/zapret"
  t=/tmp/zapret.tar.gz
  curl -fL "https://github.com/bol-van/zapret/releases/download/${ZAPRET_VERSION}/zapret-${ZAPRET_VERSION}.tar.gz" -o "$t" \
    || { err "не скачался релиз zapret — поставь вручную (см. README)"; return 1; }
  mkdir -p /opt; tar -xzf "$t" -C /opt; mv /opt/zapret-* /opt/zapret 2>/dev/null || true
  # ставим сервис и firewall-хук неинтерактивно
  yes '' | /opt/zapret/install_easy.sh >/tmp/zapret-install.log 2>&1 || warn "install_easy.sh отработал с оговорками, см. /tmp/zapret-install.log"
  ok "zapret распакован"
}
zapret_apply() {
  [ "$ZAPRET_ENABLE" = 1 ] || { /etc/init.d/zapret stop 2>/dev/null || true; return 0; }
  zapret_install || return 1
  cfg=/opt/zapret/config
  cp "$cfg" "$cfg.bak.$(date +%s)" 2>/dev/null || true
  # бэкапы лежат на флеше и копятся с каждым apply — держим три последних
  ls -t "$cfg".bak.* 2>/dev/null | tail -n +4 | while read -r old; do rm -f "$old"; done
  # срезаем прошлый netkit-блок
  sed -i '/# >>> netkit/,/# <<< netkit/d' "$cfg" 2>/dev/null || true
  {
    echo "# >>> netkit — не редактируй руками, правь config/zapret.conf"
    echo "NFQWS_ENABLE=1"
    echo "NFQWS_PORTS_TCP=${ZAPRET_PORTS_TCP:-80,443}"
    echo "NFQWS_PORTS_UDP=${ZAPRET_PORTS_UDP:-443,50000-50099}"
    # hostlist, а не autohostlist: автосписок учится ТОЛЬКО на сломавшихся
    # соединениях, поэтому каждый новый заблокированный домен обязан сначала
    # отвалиться, а ложные срабатывания (долгие вебсокеты, VK long-poll)
    # копятся сотнями и заставляют дурить трафик, который дурить не надо.
    echo "MODE_FILTER=${ZAPRET_MODE_FILTER:-hostlist}"
    echo "DISABLE_IPV6=1"
    printf 'NFQWS_OPT="%s"\n' "$ZAPRET_NFQWS_OPT"
    echo "# <<< netkit"
  } >> "$cfg"
  # пользовательский hostlist
  printf '%s\n' "$ZAPRET_HOSTS" | sed '/^[[:space:]]*$/d' > /opt/zapret/ipset/zapret-hosts-user.txt
  /etc/init.d/zapret enable 2>/dev/null || true
  /etc/init.d/zapret restart 2>/dev/null || /opt/zapret/init.d/openwrt/zapret restart 2>/dev/null || true
  sleep 2
  # Рапортовать «перезапущен», не посмотрев, поднялся ли он, — это как раз тот
  # случай, когда установка «прошла успешно», а обхода нет.
  if pidof nfqws >/dev/null 2>&1; then
    ok "zapret настроен и перезапущен"
  else
    warn "zapret настроен, но nfqws не запустился — смотри logread -e zapret"
  fi
}

# ---------- сервисы прокси-стека ----------
restart_proxy() {
  [ "$PROXY_ENABLE" = 1 ] || { /etc/init.d/sing-box stop 2>/dev/null || true; return 0; }
  /etc/init.d/sing-box enable 2>/dev/null || true
  /etc/init.d/sing-box restart
  fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1 || true
  ok "sing-box перезапущен, firewall перезагружен"
}

# ---------- geoblock: авто-список ушедших из РФ сервисов ----------
deploy_geoblock() {
  # Гугл раздаёт своим сервисам адреса из общих /24. Если в proxy-набор попадёт
  # news.google.com, туда же по совпадению IP уедет ютуб — и гугл встретит
  # клиента бот-проверкой с датацентрового адреса ноды. Поэтому гугловые домены
  # из списка вычищаем: ютуб и так ходит напрямую через zapret.
  [ -f /etc/geoblock-exclude.txt ] || cat > /etc/geoblock-exclude.txt <<'EOF'
# Домены, которые НЕ пускаем в proxy4/proxy6 (расширенные регулярки, # — комментарий).
\.google\.com$
\.googleapis\.com$
\.gstatic\.com$
\.googleusercontent\.com$
\.googlevideo\.com$
\.ytimg\.com$
\.ggpht\.com$
^youtube\.
\.youtube\.com$
EOF
  cat > /usr/sbin/geoblock-update <<EOF
#!/bin/sh
# генерируется netkit. Тянет список ушедших-из-РФ сервисов в наборы proxy4/6.
set -eu
URLS="$GEOBLOCK_URL $GEOBLOCK_URL2 $GEOBLOCK_URL3"
MAXAGE=$GEOBLOCK_MAXAGE
OUT="$GEOBLOCKD"
EXCL=/etc/geoblock-exclude.txt
TMP=/tmp/geoblock.lst
STAMP=/etc/geoblock.stamp
TOLD=/tmp/geoblock.told
QUEUE=/tmp/notify.queue
log() { logger -t geoblock "\$*"; echo "\$*"; }

# Сказать хозяину через общую очередь: её разбирает proxy-watchdog первым
# здоровым заходом. Не чаще раза в сутки — беда тут тянется неделями.
tell() {
  now=\$(date +%s); last=\$(cat "\$TOLD" 2>/dev/null || echo 0)
  [ \$((now - last)) -gt 86400 ] || return 0
  printf '%s %s\\n' "\$(date '+%d.%m %H:%M') —" "\$1" >> "\$QUEUE"
  echo "\$now" > "\$TOLD"
}

# Зеркала по очереди. Одного источника мало: список — единственное, откуда
# роутер узнаёт о новых уехавших сервисах, и его молчание не видно никак.
# Обход продолжает работать, просто перестаёт узнавать новое, и это тянется,
# пока однажды не окажется, что половина нужного идёт мимо ноды.
got=0
for u in \$URLS; do
  [ -n "\$u" ] || continue
  if curl -fsSL -m 40 "\$u" -o "\$TMP" 2>/dev/null && [ -s "\$TMP" ]; then got=1; break; fi
  log "зеркало молчит: \$u"
done
if [ "\$got" = 0 ]; then
  log "ни одно зеркало не ответило, оставляю старый список"
  now=\$(date +%s); had=\$(cat "\$STAMP" 2>/dev/null || echo 0)
  if [ "\$had" = 0 ]; then
    tell "Список геоблока ни разу не скачался — новые уехавшие сервисы пойдут мимо ноды."
  elif [ \$((now - had)) -gt "\$MAXAGE" ]; then
    tell "Список геоблока не обновляется \$(( (now - had) / 86400 )) сут: все зеркала молчат. Обход работает, но о новых уехавших сервисах роутер не узнаёт."
  fi
  exit 1
fi
tmpd=\$(mktemp); tmpe=\$(mktemp)
trap 'rm -f "\$tmpd" "\$tmpe"' EXIT
grep -vE '^[[:space:]]*(#|\$)' "\$EXCL" 2>/dev/null > "\$tmpe" || true
if [ -s "\$tmpe" ]; then
  grep -E '^[a-z0-9._-]+\.[a-z]{2,}\$' "\$TMP" | grep -vEf "\$tmpe" | sort -u > "\$tmpd"
else
  grep -E '^[a-z0-9._-]+\.[a-z]{2,}\$' "\$TMP" | sort -u > "\$tmpd"
fi
n=\$(wc -l < "\$tmpd")
[ "\$n" -ge 100 ] || { log "список подозрительно мал (\$n), откат"; exit 1; }
tmpc=\$(mktemp)
while IFS= read -r d; do
  printf 'nftset=/%s/4#inet#fw4#proxy4\n' "\$d"
  printf 'nftset=/%s/6#inet#fw4#proxy6\n' "\$d"
done < "\$tmpd" > "\$tmpc"
# Копия для отката ложится в /tmp, а НЕ рядом с конфигом. dnsmasq читает
# conf-dir целиком, без фильтра по расширению: geoblock.conf.bak рядом с
# geoblock.conf — это не бэкап, а второй живой список, который тихо
# подмешивается к первому. Ловил на живом роутере.
[ -f "\$OUT" ] && cp "\$OUT" /tmp/geoblock.conf.bak
# Подмена через файл в той же папке и mv: mv атомарен, а mv из /tmp — это
# копирование через границу файловых систем, и обрыв питания оставит обрубок.
gtmp="\$(dirname "\$OUT")/.geoblock.conf.tmp"
if cp "\$tmpc" "\$gtmp"; then
  rm -f "\$tmpc"; mv "\$gtmp" "\$OUT"
else
  log "не смог записать \$OUT (места на флеше нет?) — оставляю прежний список"
  rm -f "\$gtmp" "\$tmpc"; exit 1
fi
if /etc/init.d/dnsmasq restart 2>/dev/null && sleep 2 && pgrep -x dnsmasq >/dev/null; then
  log "geoblock обновлён: \$n доменов"
  date +%s > "\$STAMP"
else
  log "dnsmasq не поднялся — откат"; [ -f /tmp/geoblock.conf.bak ] && cp /tmp/geoblock.conf.bak "\$OUT" || rm -f "\$OUT"
  /etc/init.d/dnsmasq restart 2>/dev/null || true; exit 1
fi
EOF
  chmod +x /usr/sbin/geoblock-update
  cron_line "/usr/sbin/geoblock-update" "$GEOBLOCK_CRON" "$GEOBLOCK_ENABLE"
}

# ---------- сторож нод: авто-восстановление прокси ----------
deploy_watchdog() {
  cat > /usr/sbin/proxy-watchdog <<EOF
#!/bin/sh
# генерируется netkit. Следит за тем, что через ноду реально ходит трафик.
#
# Прежняя версия спрашивала у clash задержку группы auto. Но селектор обычно
# закреплён на конкретной ноде, и auto меряет ту, через которую не идёт ни
# одного пакета: нода лежит, сайты не открываются, а сторож рапортует «всё
# хорошо». Ловилось живьём. Поэтому проверка идёт тем же socks, которым идёт
# трафик, а лечение начинается с пересадки на живую ноду — перезапуск ядра
# только если это не помогло.
API=127.0.0.1:$CLASH_PORT
SOCKS=127.0.0.1:$SOCKS_DIAG

# Имена функций латиницей не для красоты: busybox ash не принимает в них
# кириллицу — вызов молча становится «not found».
via_node() {
  curl -s -o /dev/null -m 12 -w '%{http_code}' --socks5-hostname "\$SOCKS" "\$1" 2>/dev/null
}
passes() {
  c=\$(via_node https://www.gstatic.com/generate_204)
  case "\$c" in 2??|3??) return 0 ;; esac
  c=\$(via_node https://www.cloudflare.com/cdn-cgi/trace)
  case "\$c" in 2??|3??) return 0 ;; esac
  return 1
}
active_node() {
  n=\$(curl -s -m 4 "http://\$API/proxies/proxy" | sed -n 's/.*"now": *"\([^"]*\)".*/\1/p')
  [ "\$n" = auto ] && n=\$(curl -s -m 4 "http://\$API/proxies/auto" | sed -n 's/.*"now": *"\([^"]*\)".*/\1/p')
  echo "\$n"
}
passes && exit 0
sleep 4
passes && exit 0

was=\$(active_node)
logger -t proxy-watchdog "через ноду (\$was) трафик не идёт — ищу живую"

# 1. Пересесть на живую: это лечит причину, а не симптом.
d=\$(curl -s -m 30 "http://\$API/group/proxy/delay?url=http://www.gstatic.com/generate_204&timeout=3000")
best=\$(printf '%s' "\$d" | tr ',' '\n' | grep '"' | sed -n 's/.*"\([^"]*\)": *\([0-9][0-9]*\).*/\2 \1/p' | sort -n | head -1 | cut -d' ' -f2-)
if [ -n "\$best" ] && [ "\$best" != "\$was" ]; then
  curl -s -o /dev/null -X PUT "http://\$API/proxies/proxy" -d "{\"name\":\"\$best\"}"
  sleep 3
  if passes; then
    logger -t proxy-watchdog "помогло: \$was -> \$best"
    exit 0
  fi
fi

# 2. Не помогло — перезапустить ядро.
logger -t proxy-watchdog "смена ноды не помогла — перезапускаю sing-box"
/etc/init.d/sing-box restart >/dev/null 2>&1
sleep 8
passes && logger -t proxy-watchdog "восстановлено" \
       || logger -t proxy-watchdog "ни одна нода не пропускает трафик — проверь подписку"
EOF
  chmod +x /usr/sbin/proxy-watchdog
  cron_line "/usr/sbin/proxy-watchdog" "$WATCHDOG_CRON" "$WATCHDOG_ENABLE"
}

# ---------- telegram-cidr: авто-обновление офиц. CIDR Telegram ----------
deploy_telegram_cidr() {
  cat > /usr/sbin/telegram-cidr-update <<EOF
#!/bin/sh
# генерируется netkit. Тянет офиц. CIDR Telegram (MTProto ходит по IP, не по домену)
# и перекатывает наборы proxy4/proxy6 + redirect-цепочку.
set -eu
URL="$TELEGRAM_CIDR_URL"
OUT="$CFG/telegram-cidr.list"
NFTF="$NFT"
LANIF="$LAN_IFACE"
RPORT="$REDIRECT_PORT"
TMP=/tmp/tg-cidr.txt
log() { logger -t telegram-cidr "\$*"; echo "\$*"; }
cerr=\$(curl -fsSL -m 30 "\$URL" -o "\$TMP" 2>&1); crc=\$?
if [ "\$crc" != 0 ]; then
  log "download FAILED (curl код \$crc): \$cerr, оставляю старый список"; exit 1
fi
v4n=\$(grep -cE '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}\$' "\$TMP" || echo 0)
[ "\$v4n" -ge 5 ] || { log "список подозрительно мал (v4=\$v4n), откат"; exit 1; }
tmpc=\$(mktemp)
{
  echo "# telegram-cidr.list — авто-обновлено \$(date +%F) с \$URL"
  grep -E '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}\$' "\$TMP"
  grep -E '^[0-9a-fA-F:]+/[0-9]{1,3}\$' "\$TMP"
} > "\$tmpc"
# Копия для отката ложится в /tmp, а НЕ рядом с конфигом. dnsmasq читает
# conf-dir целиком, без фильтра по расширению: geoblock.conf.bak рядом с
# geoblock.conf — это не бэкап, а второй живой список, который тихо
# подмешивается к первому. Ловил на живом роутере.
[ -f "\$OUT" ] && cp "\$OUT" /tmp/telegram-cidr.list.bak
# Подмена через файл в той же папке и mv: mv атомарен, а mv из /tmp — это
# копирование через границу файловых систем, и обрыв питания оставит обрубок.
gtmp="\$(dirname "\$OUT")/.telegram-cidr.tmp"
if cp "\$tmpc" "\$gtmp"; then
  rm -f "\$tmpc"; mv "\$gtmp" "\$OUT"
else
  log "не смог записать \$OUT (места на флеше нет?) — оставляю прежний список"
  rm -f "\$gtmp" "\$tmpc"; exit 1
fi
/usr/sbin/kit-nft-gen
if fw4 reload >/dev/null 2>&1 || /etc/init.d/firewall reload >/dev/null 2>&1; then
  log "Telegram CIDR обновлён: v4=\$v4n записей"
else
  # Откат берётся из /tmp: рядом с конфигом копию класть нельзя, dnsmasq
  # читает папку целиком и подхватил бы её как второй живой список.
  log "firewall reload не прошёл — откат"
  [ -f /tmp/telegram-cidr.list.bak ] && cp /tmp/telegram-cidr.list.bak "\$OUT" || true
  /usr/sbin/kit-nft-gen || true
  fw4 reload >/dev/null 2>&1 || true
  exit 1
fi
EOF
  chmod +x /usr/sbin/telegram-cidr-update
  cron_line "/usr/sbin/telegram-cidr-update" "$TELEGRAM_CIDR_CRON" "$TELEGRAM_CIDR_AUTOUPDATE"
}

# добавить/убрать строку крона (идемпотентно)
cron_line() {  # $1=команда $2=расписание $3=вкл(1/0)
  cr=/etc/crontabs/root; mkdir -p /etc/crontabs; touch "$cr"
  grep -vF "$1" "$cr" > "$cr.tmp" 2>/dev/null || true; mv "$cr.tmp" "$cr"
  [ "$3" = 1 ] && echo "$2 $1" >> "$cr"
  /etc/init.d/cron enable 2>/dev/null || true; /etc/init.d/cron restart 2>/dev/null || true
}

# ---------- netpult: бинарь для обновления подписок ----------
# Скачивает статический бинарь из релиза netpult и кладёт в /usr/sbin/netpult.
# GitHub из РФ отдаёт нестабильно — те же зеркала, что и в get.sh.
sub_fetch() {  # $1=url $2=out ; 0 при успехе
  for m in ${KIT_MIRROR:-} "" https://gh-proxy.com/ https://ghfast.top/; do
    curl -fsL --connect-timeout 8 --max-time 180 --speed-time 25 --speed-limit 1024 \
      -o "$2" "$m$1" && return 0
  done
  return 1
}

deploy_netpult() {
  arch=$(uname -m)
  case "$arch" in
    aarch64|arm64) asset=netpult-linux-aarch64.tar.gz ;;
    x86_64)        asset=netpult-linux-x86_64.tar.gz ;;
    *) warn "netpult: нет сборки под $arch — подписки через пульт недоступны"; return 1 ;;
  esac
  have=$(/usr/sbin/netpult version 2>/dev/null | head -1)
  # Уже нужная версия — не качаем многомегабайтный tarball на каждый apply.
  case "$have" in
    *"${NETPULT_VERSION#v}"*) mkdir -p "$NETPULT_DIR"; ok "netpult: $have (актуален)"; return 0 ;;
  esac
  base="https://github.com/pepetutu1337/netpult/releases/download/${NETPULT_VERSION}"

  tmp=$(mktemp -d) || return 1
  if ! sub_fetch "$base/$asset" "$tmp/n.tgz"; then
    rm -rf "$tmp"
    [ -x /usr/sbin/netpult ] && { warn "netpult ${NETPULT_VERSION} не скачался — оставляю установленный ($have)"; return 0; }
    err "netpult не скачался — подписки не заработают"; return 1
  fi
  # sha256 проверяем, если он приложен к релизу; нет — ставим без проверки.
  if sub_fetch "$base/$asset.sha256" "$tmp/n.sha" 2>/dev/null; then
    want=$(awk '{print $1; exit}' "$tmp/n.sha")
    got=$(sha256sum "$tmp/n.tgz" | awk '{print $1}')
    [ "$want" = "$got" ] || { err "netpult: sha256 не сошёлся, не ставлю"; rm -rf "$tmp"; return 1; }
  else
    warn "netpult: контрольная сумма недоступна, ставлю без проверки"
  fi
  tar xzf "$tmp/n.tgz" -C "$tmp" || { err "netpult: архив не распаковался"; rm -rf "$tmp"; return 1; }
  [ -f "$tmp/netpult" ] || { err "netpult: в архиве нет бинаря"; rm -rf "$tmp"; return 1; }
  mv "$tmp/netpult" /usr/sbin/netpult || { err "netpult: не встал в /usr/sbin (места на флеше нет?)"; rm -rf "$tmp"; return 1; }
  chmod 755 /usr/sbin/netpult
  rm -rf "$tmp"
  mkdir -p "$NETPULT_DIR"
  new=$(/usr/sbin/netpult version 2>/dev/null | head -1)
  ok "netpult: ${new:-установлен}"
}

# ---------- обновление подписок: два крон-скрипта ----------
# sub-update — полный refresh раз в сутки (перечитать подписки, свести с
#   банком, пересобрать конфиг ядра с проверкой и откатом).
# sub-poll   — раз в несколько минут: только забрать новые ссылки из бота и
#   манифеста; netpult рестартит ядро лишь при реальном изменении списка.
# Секреты (токен, chat_id, ключ) скрипт читает из kit.conf при запуске —
# не вписываем в текст скрипта: одинарная кавычка в ключе иначе ломает его,
# и секрет не дублируется во второй файл.
deploy_sub_scripts() {
  socks="socks5h://127.0.0.1:${SOCKS_DIAG}"

  cat > /usr/sbin/sub-update <<EOF
#!/bin/sh
# генерируется netkit. Полный refresh подписок раз в сутки.
. /etc/netkit/kit.conf
export XDG_DATA_HOME="${NETPULT_DIR}"
export NETPULT_BOT_TOKEN="\$SUB_BOT_TOKEN" NETPULT_BOT_CHAT="\$SUB_BOT_CHAT" NETPULT_SUB_KEY="\$SUB_HMAC_KEY"
/usr/sbin/netpult vpn sync --config ${SBOX} --proxy ${socks} \\
  --restart /etc/init.d/sing-box restart 2>&1 | logger -t sub-update
EOF
  chmod 700 /usr/sbin/sub-update

  cat > /usr/sbin/sub-poll <<EOF
#!/bin/sh
# генерируется netkit. Забор новых ссылок из бота и манифеста; изменился
# список — тот же sync применяется сразу.
. /etc/netkit/kit.conf
export XDG_DATA_HOME="${NETPULT_DIR}"
export NETPULT_BOT_TOKEN="\$SUB_BOT_TOKEN" NETPULT_BOT_CHAT="\$SUB_BOT_CHAT" NETPULT_SUB_KEY="\$SUB_HMAC_KEY"
/usr/sbin/netpult vpn subs poll \${SUB_MANIFEST_URL:+--manifest "\$SUB_MANIFEST_URL"} \\
  --then-sync --config ${SBOX} --proxy ${socks} \\
  --restart /etc/init.d/sing-box restart 2>&1 | logger -t sub-poll
EOF
  chmod 700 /usr/sbin/sub-poll

  cron_line "/usr/sbin/sub-update" "$SUB_UPDATE_CRON" 1
  cron_line "/usr/sbin/sub-poll"   "$SUB_POLL_CRON"   1
}

sub_disable_cron() {
  cron_line "/usr/sbin/sub-update" "$SUB_UPDATE_CRON" 0
  cron_line "/usr/sbin/sub-poll"   "$SUB_POLL_CRON"   0
}

deploy_scripts() {
  deploy_geoblock; ok "geoblock-update развёрнут (крон: ${GEOBLOCK_CRON})"
  # Здесь стояло `[ "$PROXY_ENABLE" = 1 ] && { ... }` последней строкой функции.
  # При выключенном прокси функция возвращала 1, и весь установщик под set -e
  # умирал ровно тут — молча, не поставив ни zapret, ни geoblock-список. Тому,
  # кто ставит кит только ради zapret, не доставалось ничего.
  if [ "$PROXY_ENABLE" = 1 ]; then
    deploy_watchdog; ok "proxy-watchdog развёрнут (крон: ${WATCHDOG_CRON})"
    deploy_telegram_cidr; ok "telegram-cidr-update развёрнут (крон: ${TELEGRAM_CIDR_CRON}, вкл=${TELEGRAM_CIDR_AUTOUPDATE})"
    if [ "$SUB_ENABLE" = 1 ]; then
      if deploy_netpult; then
        deploy_sub_scripts
        ok "подписки: sub-update (${SUB_UPDATE_CRON}), sub-poll (${SUB_POLL_CRON})"
      else
        warn "подписки не развёрнуты — netpult не встал"
      fi
    elif grep -q '/usr/sbin/sub-update\|/usr/sbin/sub-poll' /etc/crontabs/root 2>/dev/null; then
      sub_disable_cron; ok "подписки выключены (SUB_ENABLE=0) — кроны сняты"
    fi
  fi
  return 0
}

# =================== КОМАНДЫ ===================
cmd_install() {
  ensure_deps || { err "останавливаюсь — сначала почини зависимости"; return 1; }
  if [ "$PROXY_ENABLE" = 1 ]; then gen_singbox || return 1; gen_nft; setup_calls; gen_doh; gen_dns; restart_proxy; fi
  gen_quic
  gen_ipv6
  deploy_scripts
  [ "$GEOBLOCK_ENABLE" = 1 ] && { say "тяну geoblock-список (первый раз)"; /usr/sbin/geoblock-update || warn "geoblock не скачался, попробуй позже: netctl geoblock update"; }
  if [ "$PROXY_ENABLE" = 1 ] && [ "$SUB_ENABLE" = 1 ] && [ -x /usr/sbin/sub-update ]; then
    say "первое обновление подписок"; /usr/sbin/sub-update || warn "sub-update не прошёл — повторится по крону"
  fi
  [ "$ZAPRET_ENABLE" = 1 ] && zapret_apply
  fw4 reload >/dev/null 2>&1 || true
  echo; say "готово. проверь: netctl status  и  netctl doctor"
}
cmd_apply() {
  if [ "$PROXY_ENABLE" = 1 ]; then gen_singbox || return 1; gen_nft; setup_calls; gen_doh; gen_dns; restart_proxy; fi
  gen_quic
  gen_ipv6
  deploy_scripts
  # gen_singbox пересобрал конфиг из nodes.list — ноды из подписок с него
  # слетели. Возвращаем их сразу, не дожидаясь суточного крона.
  if [ "$PROXY_ENABLE" = 1 ] && [ "$SUB_ENABLE" = 1 ] && [ -x /usr/sbin/sub-update ]; then
    say "подтягиваю подписки"; /usr/sbin/sub-update || warn "sub-update не прошёл — повторится по крону"
  fi
  [ "$ZAPRET_ENABLE" = 1 ] && zapret_apply
  fw4 reload >/dev/null 2>&1 || true
  say "применено."
}

cmd_domains() {
  act="${1:-list}"; shift 2>/dev/null || true
  f="$CFG/domains.list"
  case "$act" in
    list)
      lines "$f" | sort | awk '{printf "  %s\n",$0}'
      echo "  ── всего: $(lines "$f" | wc -l)"
      ;;
    add)
      [ $# -gt 0 ] || { err "укажи домен(ы)"; return 1; }
      for d in "$@"; do
        d=$(echo "$d" | sed 's#^https\?://##; s#/.*##; s/^www\.//')
        if lines "$f" | grep -qx "$d"; then warn "$d уже есть"; else echo "$d" >> "$f"; ok "добавлен $d"; fi
      done
      gen_dns
      ;;
    rm|del|remove)
      [ $# -gt 0 ] || { err "укажи домен(ы)"; return 1; }
      for d in "$@"; do
        d=$(echo "$d" | sed 's#^https\?://##; s#/.*##; s/^www\.//')
        if lines "$f" | grep -qx "$d"; then
          grep -vxF "$d" "$f" > "$f.tmp" && mv "$f.tmp" "$f"; ok "убран $d"
        else warn "$d не найден"; fi
      done
      gen_dns
      ;;
    *) err "domains: list | add <d…> | rm <d…>";;
  esac
}

_clash_switch() { curl -s -X PUT "http://$CLASH/proxies/proxy" -d "{\"name\":\"$1\"}" >/dev/null 2>&1; }
_exit_ip() { curl -s -m 8 --socks5-hostname 127.0.0.1:$SOCKS_DIAG https://ipinfo.io/json 2>/dev/null; }

cmd_nodes() {
  act="${1:-list}"; shift 2>/dev/null || true
  case "$act" in
    list)
      i=0
      lines "$CFG/nodes.list" | while IFS= read -r u; do
        i=$((i+1)); name="${u##*#}"; [ "$name" = "$u" ] && name="(без имени)"
        host="${u#*@}"; host="${host%%:*}"
        printf "  node%-2s  %-22s %s\n" "$i" "$host" "$name"
      done
      cur=$(curl -s -m 4 "http://$CLASH/proxies/proxy" 2>/dev/null | jq -r '.now // empty' 2>/dev/null || true)
      [ -n "$cur" ] && echo "  ── активна сейчас: $cur"
      ;;
    test)
      have jq || { err "нужен jq"; return 1; }
      cur=$(curl -s -m 4 "http://$CLASH/proxies/proxy" 2>/dev/null | jq -r '.now // "auto"')
      i=0
      for t in $(node_tags); do
        i=$((i+1))
        _clash_switch "$t"; sleep 1
        j=$(_exit_ip)
        if [ -n "$j" ]; then
          ip=$(echo "$j" | jq -r '.ip'); loc=$(echo "$j" | jq -r '"\(.city // "?"), \(.country // "?")"')
          printf "  %-7s \033[1;32mOK\033[0m  %-15s %s\n" "$t" "$ip" "$loc"
        else
          printf "  %-7s \033[1;31m—\033[0m   недоступна\n" "$t"
        fi
      done
      _clash_switch "$cur"
      ;;
    use)
      n="${1:-}"; case "$n" in ''|*[!0-9]*) err "netkit nodes use <номер>"; return 1;; esac
      _clash_switch "node$n" && ok "закреплена node$n" || err "не вышло (sing-box запущен? нода есть?)"
      ;;
    *) err "nodes: list | test | use <N>";;
  esac
}

# ---------- подписки (несколько ссылок, банк, дистанционный канал) ----------
# Тонкая обёртка над netpult: сам список, банк и каналы живут в нём, netkit
# только даёт единый вход и применяет изменения к живому конфигу ядра.
_netpult() {
  [ -x /usr/sbin/netpult ] || { err "netpult не установлен — SUB_ENABLE=1 и netctl install"; return 1; }
  XDG_DATA_HOME="$NETPULT_DIR" NETPULT_SUB_KEY="$SUB_HMAC_KEY" \
  NETPULT_BOT_TOKEN="$SUB_BOT_TOKEN" NETPULT_BOT_CHAT="$SUB_BOT_CHAT" \
    /usr/sbin/netpult "$@"
}

cmd_subs() {
  act="${1:-list}"; shift 2>/dev/null || true
  case "$act" in
    list|"") _netpult vpn subs list ;;
    bank)    _netpult vpn bank list ;;
    add)
      [ $# -gt 0 ] || { err "netkit subs add <url>"; return 1; }
      _netpult vpn subs add "$@" || return 1
      # ссылка уже в netpult; неудача применения не должна ронять команду
      [ -x /usr/sbin/sub-update ] && { /usr/sbin/sub-update || warn "применить не вышло — повторится по крону"; }
      return 0
      ;;
    rm|del|forget)
      [ $# -gt 0 ] || { err "netkit subs rm <url>"; return 1; }
      _netpult vpn subs rm "$@"
      ;;
    revive)
      [ $# -gt 0 ] || { err "netkit subs revive <url>"; return 1; }
      _netpult vpn subs revive "$@" || return 1
      [ -x /usr/sbin/sub-update ] && { /usr/sbin/sub-update || warn "применить не вышло — повторится по крону"; }
      return 0
      ;;
    update)
      [ -x /usr/sbin/sub-update ] || { err "sub-update не развёрнут (нужен SUB_ENABLE=1 и netctl install)"; return 1; }
      /usr/sbin/sub-update
      ;;
    poll)
      [ -x /usr/sbin/sub-poll ] || { err "sub-poll не развёрнут (нужен SUB_ENABLE=1 и netctl install)"; return 1; }
      /usr/sbin/sub-poll
      ;;
    log)    logread -e sub-update -e sub-poll | tail -40 ;;
    *) err "subs: list | add <url> | rm <url> | revive <url> | bank | update | poll | log" ;;
  esac
}

cmd_telegram_cidr() {
  case "${1:-}" in
    update|"") /usr/sbin/telegram-cidr-update 2>/dev/null || { deploy_telegram_cidr; /usr/sbin/telegram-cidr-update; };;
    on)  TELEGRAM_CIDR_AUTOUPDATE=1; deploy_telegram_cidr; /usr/sbin/telegram-cidr-update;;
    off) cron_line "/usr/sbin/telegram-cidr-update" "$TELEGRAM_CIDR_CRON" 0; ok "автообновление выключено (текущий список в telegram-cidr.list остаётся)";;
    count) echo "  telegram CIDR: $(lines "$CFG/telegram-cidr.list" | grep -c .) записей";;
    *) err "telegram-cidr: update | on | off | count";;
  esac
}

cmd_backup() {
  f="/tmp/netkit-backup-$(date +%Y%m%d-%H%M%S).tar.gz"
  say "sysupgrade-бэкап конфигов (НЕ прошивка) → $f"
  sysupgrade -b "$f" || { err "sysupgrade -b не прошёл"; return 1; }
  ok "готово, стяни на комп: netctl backup"
  echo "$f"
}

cmd_zapret() {
  case "${1:-}" in
    on)  ZAPRET_ENABLE=1; zapret_apply;;
    off) /etc/init.d/zapret stop 2>/dev/null; /etc/init.d/zapret disable 2>/dev/null; ok "zapret выключен";;
    check)
      say "blockcheck (сначала глушу zapret, чтобы не мешал)"
      /etc/init.d/zapret stop 2>/dev/null || true
      [ -x /opt/zapret/blockcheck.sh ] && /opt/zapret/blockcheck.sh || err "нет /opt/zapret/blockcheck.sh"
      zapret_apply;;
    edit) ${EDITOR:-vi} "$CFG/zapret.conf"; warn "не забудь: netctl apply (правки локальны, залей на роутер)";;
    *) err "zapret: on | off | check | edit";;
  esac
}

cmd_geoblock() {
  case "${1:-}" in
    update|"") /usr/sbin/geoblock-update 2>/dev/null || { deploy_geoblock; /usr/sbin/geoblock-update; };;
    on)  GEOBLOCK_ENABLE=1; deploy_geoblock; /usr/sbin/geoblock-update;;
    off) cron_line "/usr/sbin/geoblock-update" "$GEOBLOCK_CRON" 0; rm -f "$GEOBLOCKD"; /etc/init.d/dnsmasq restart 2>/dev/null; ok "geoblock выключен";;
    count) echo "  доменов в geoblock: $(grep -c 'proxy4' "$GEOBLOCKD" 2>/dev/null || echo 0)";;
    list)
      [ -f "$GEOBLOCKD" ] || { warn "список geoblock ещё не создан (netkit geoblock update)"; return 0; }
      d=$(sed -n 's|^nftset=/\([^/]*\)/.*|\1|p' "$GEOBLOCKD" | sort -u | grep .)
      say "geoblock: $(printf '%s\n' "$d" | grep -c .) доменов (авто-список ушедших из РФ)"
      printf '%s\n' "$d" | awk '{printf "%4d  %s\n", NR, $0}'
      ;;
    *) err "geoblock: update | on | off | count | list";;
  esac
}

# модель/хост/подсеть подключённого роутера — для автозаголовка панели
cmd_meta() {
  m=$(cat /tmp/sysinfo/model 2>/dev/null || echo OpenWrt)
  h=$(uci -q get system.@system[0].hostname 2>/dev/null)
  ip=$(uci -q get network.lan.ipaddr 2>/dev/null)
  case "$ip" in
    */*|"") lan="$ip";;
    *) nm=$(uci -q get network.lan.netmask 2>/dev/null); c=0
       for o in $(echo "${nm:-255.255.255.0}" | tr '.' ' '); do case $o in 255)c=$((c+8));;254)c=$((c+7));;252)c=$((c+6));;248)c=$((c+5));;240)c=$((c+4));;224)c=$((c+3));;192)c=$((c+2));;128)c=$((c+1));;esac; done
       lan="$ip/$c";;
  esac
  echo "model=$m"; echo "host=$h"; echo "lan=$lan"
}

cmd_info() {
  echo "=== роутер ==="
  echo "модель:   $(cat /tmp/sysinfo/model 2>/dev/null || echo ?)"
  echo "хост:     $(uci -q get system.@system[0].hostname 2>/dev/null)"
  d=$(. /etc/openwrt_release 2>/dev/null; echo "$DISTRIB_DESCRIPTION"); echo "прошивка: ${d:-?}"
  echo "ядро:     $(uname -r)"
  up=$(cut -d. -f1 /proc/uptime 2>/dev/null); [ -n "$up" ] && echo "аптайм:   $((up/86400))д $((up%86400/3600))ч $((up%3600/60))м"
  echo "нагрузка: $(cut -d' ' -f1-3 /proc/loadavg 2>/dev/null)"
  echo "память:   $(free 2>/dev/null | awk '/^Mem/{printf "%d/%d МБ занято", $3/1024, $2/1024}')"
  echo
  echo "=== сеть ==="
  lip=$(uci -q get network.lan.ipaddr); lnm=$(uci -q get network.lan.netmask)
  case "$lip" in */*) echo "LAN:      $lip";; *) echo "LAN:      $lip${lnm:+ / $lnm}";; esac
  w=$(ubus call network.interface.wan status 2>/dev/null | jq -r '.["ipv4-address"][0].address // empty' 2>/dev/null)
  echo "WAN IP:   ${w:-?}"
  echo
  echo "=== обход ==="
  echo "sing-box: $(sing-box version 2>/dev/null | head -1)"
  if [ "$PROXY_ENABLE" = 1 ]; then
    node=$(curl -s -m 4 "http://$CLASH/proxies/proxy" 2>/dev/null | jq -r '.now // empty' 2>/dev/null)
    [ "$node" = auto ] && node=$(curl -s -m 4 "http://$CLASH/proxies/auto" 2>/dev/null | jq -r '.now // empty' 2>/dev/null)
    echo "нода:     ${node:-?}"
  fi
  echo "домены:   прокси $(lines "$CFG/domains.list" | wc -l) + geoblock $(grep -c proxy4 "$GEOBLOCKD" 2>/dev/null || echo 0)"
  echo "zapret:   $(pidof nfqws 2>/dev/null | wc -w) nfqws-процессов"
}

cmd_proxy() {
  case "${1:-}" in
    on)  PROXY_ENABLE=1; gen_singbox; gen_nft; setup_calls; gen_doh; gen_dns; restart_proxy;;
    off) /etc/init.d/sing-box stop 2>/dev/null; /etc/init.d/sing-box disable 2>/dev/null
         rm -f "$NFT"; fw4 reload >/dev/null 2>&1 || true; ok "прокси выключен (zapret не тронут)";;
    *) err "proxy: on | off";;
  esac
}

svc_state() { if /etc/init.d/"$1" status 2>/dev/null | grep -qi running || pgrep -x "$2" >/dev/null 2>&1; then ok "$1 работает"; else err "$1 не запущен"; fi; }
cmd_status() {
  say "сервисы"
  [ "$PROXY_ENABLE" = 1 ] && svc_state sing-box sing-box
  [ "$DOH_ENABLE" = 1 ]   && svc_state https-dns-proxy https-dns-proxy
  svc_state dnsmasq dnsmasq
  [ "$ZAPRET_ENABLE" = 1 ] && { pgrep -x nfqws >/dev/null 2>&1 && ok "zapret (nfqws) работает" || err "zapret (nfqws) не запущен"; }
  echo
  say "наборы IP"
  c4=$(nft -j list set inet fw4 proxy4 2>/dev/null | jq '[.nftables[].set.elem[]?]|length' 2>/dev/null || echo 0)
  echo "  proxy4: ${c4:-0} элементов"
  say "домены в прокси: $(lines "$CFG/domains.list" | wc -l),  ноды: $(lines "$CFG/nodes.list" | wc -l)"
  if [ "$SUB_ENABLE" = 1 ] && [ -x /usr/sbin/netpult ]; then
    # grep -c при нуле совпадений выходит с кодом 1 — под set -e это оборвёт
    # cmd_status на свежем роутере, поэтому || true в каждой подстановке.
    subs_out=$(XDG_DATA_HOME="$NETPULT_DIR" /usr/sbin/netpult vpn subs list 2>/dev/null || true)
    n=$(printf '%s\n' "$subs_out" | grep -c '●' || true)
    r=$(printf '%s\n' "$subs_out" | grep -c '○' || true)
    b=$(XDG_DATA_HOME="$NETPULT_DIR" /usr/sbin/netpult vpn bank list 2>/dev/null | grep -cE '●|○' || true)
    say "подписки: активных ${n:-0}, в отставке ${r:-0};  банк нод: ${b:-0}"
  fi
}

cmd_doctor() {
  test_dom="${1:-claude.ai}"
  say "чекап (тест-домен: $test_dom)"
  cmd_status; echo
  say "DNS: резолвится ли $test_dom через чистый DoH"
  ip=$(nslookup "$test_dom" 127.0.0.1 2>/dev/null | awk '/^Address/{print $NF}' | grep -v '#' | grep '\.' | tail -1)
  if [ -n "$ip" ]; then
    ok "$test_dom → $ip"
    if nft get element inet fw4 proxy4 "{ $ip }" >/dev/null 2>&1; then ok "$ip лежит в наборе proxy4 (пойдёт через ноду)"
    else err "$ip НЕ в proxy4 — домен резолвится, но не проксируется (dnsmasq/nftset?)"; fi
  else err "не резолвится через 127.0.0.1 — проверь dnsmasq"; fi
  echo
  if [ "$PROXY_ENABLE" = 1 ]; then
    say "выходной IP через активную ноду"
    j=$(_exit_ip)
    if [ -n "$j" ] && have jq; then
      echo "  $(echo "$j" | jq -r '"\(.ip)  \(.city // "?"), \(.country // "?")  (\(.org // "?"))"')"
      cc=$(echo "$j" | jq -r '.country // ""')
      [ "$cc" = RU ] && err "выход в РФ — нода не поднялась/не выбрана" || ok "выход за рубеж — ок"
    else err "нода не отвечает через диагностический SOCKS (sing-box/нода?)"; fi
    echo
  fi
  say "QUIC-блок"
  if [ "$BLOCK_QUIC" = 1 ]; then
    nft list ruleset 2>/dev/null | grep -q 'netkit-block-quic\|udp dport 443.*reject' && ok "udp/443 режется" || warn "правило QUIC не найдено"
  else warn "QUIC-блок выключен в kit.conf"; fi
  echo
  if [ "$SPLIT_RU_ENABLE" = 1 ]; then
    if [ "$RU_DOH_ENABLE" = 1 ] && grep -q "127.0.0.1#$RU_DOH_PORT" "$SPLITD" 2>/dev/null; then
      way="DoH 127.0.0.1:$RU_DOH_PORT → $RU_DOH_UPSTREAM"
    else
      way="$RU_DNS, открытый 53 — ТСПУ такой перехватывает"
    fi
    say "split-DNS: РФ-сайт должен резолвиться ($way)"
    rip=$(ru_ip)
    [ -n "$rip" ] && ok "www.vtb.ru → $rip (РФ-резолв работает)" || err "www.vtb.ru не резолвится — проверь split-ru.list / $way"
  fi
  echo
  say "IPv6-утечка (заблок. сайты мимо ноды через v6)"
  if [ "${LAN_IPV6:-disabled}" = disabled ]; then
    ra=$(uci -q get dhcp.lan.ra); [ "$ra" = disabled ] && ok "IPv6 на LAN отключён — утечки нет" || warn "LAN_IPV6=disabled, но dhcp.lan.ra='$ra' — примени: netctl apply"
  else warn "LAN_IPV6=keep — v6 включён, возможны утечки заблок. сайтов мимо ноды"; fi
  echo
  say "geoblock-список: $({ grep -c 'proxy4' "$GEOBLOCKD" 2>/dev/null || echo 0; } | head -1) доменов, крон/сторож:"
  grep -q geoblock-update /etc/crontabs/root 2>/dev/null && ok "geoblock-update в кроне" || warn "geoblock-update не в кроне"
  { [ "$PROXY_ENABLE" != 1 ] || grep -q proxy-watchdog /etc/crontabs/root 2>/dev/null; } && ok "сторож нод в кроне" || warn "proxy-watchdog не в кроне"
  echo
  say "telegram-cidr: $(lines "$CFG/telegram-cidr.list" | grep -c .) записей"
  if [ "$TELEGRAM_CIDR_AUTOUPDATE" = 1 ]; then
    grep -q telegram-cidr-update /etc/crontabs/root 2>/dev/null && ok "telegram-cidr-update в кроне" || warn "telegram-cidr-update не в кроне (netkit apply починит)"
  else warn "автообновление telegram-cidr выключено в kit.conf"; fi
  echo
  if [ "$SUB_ENABLE" = 1 ]; then
    say "подписки через netpult"
    [ -x /usr/sbin/netpult ] && ok "netpult: $(/usr/sbin/netpult version 2>/dev/null | head -1)" || err "netpult не установлен (netctl install)"
    grep -q '/usr/sbin/sub-update' /etc/crontabs/root 2>/dev/null && ok "sub-update в кроне ($SUB_UPDATE_CRON)" || warn "sub-update не в кроне (netctl apply)"
    grep -q '/usr/sbin/sub-poll' /etc/crontabs/root 2>/dev/null && ok "sub-poll в кроне ($SUB_POLL_CRON)" || warn "sub-poll не в кроне (netctl apply)"
    [ -n "$SUB_BOT_TOKEN" ] && [ -n "$SUB_BOT_CHAT" ] && ok "бот настроен" || warn "бот не настроен (SUB_BOT_TOKEN/SUB_BOT_CHAT)"
    [ -n "$SUB_MANIFEST_URL" ] && [ -n "$SUB_HMAC_KEY" ] && ok "манифест-канал настроен" || warn "манифест-канал не настроен (SUB_MANIFEST_URL/SUB_HMAC_KEY)"
    XDG_DATA_HOME="$NETPULT_DIR" /usr/sbin/netpult vpn subs list 2>/dev/null | grep -E '●|○' | sed 's/^/  /'
  fi
}

cmd_logs() {
  case "${1:-sing-box}" in
    sing-box) logread -e sing-box | tail -40;;
    zapret)   logread -e zapret | tail -40; pgrep -af nfqws | head -2;;
    dns)      logread -e dnsmasq -e https-dns-proxy | tail -40;;
    *) logread | tail -40;;
  esac
}

case "${1:-}" in
  install) cmd_install;;
  apply)   cmd_apply;;
  domains) shift; cmd_domains "$@";;
  nodes)   shift; cmd_nodes "$@";;
  subs)    shift; cmd_subs "$@";;
  zapret)  shift; cmd_zapret "$@";;
  proxy)   shift; cmd_proxy "$@";;
  geoblock) shift; cmd_geoblock "$@";;
  telegram-cidr) shift; cmd_telegram_cidr "$@";;
  backup)  cmd_backup;;
  status)  cmd_status;;
  doctor)  shift; cmd_doctor "$@";;
  info)    cmd_info;;
  meta)    cmd_meta;;
  logs)    shift; cmd_logs "$@";;
  *) echo "netkit: install|apply|status|doctor|info|meta|domains|nodes|subs|zapret|proxy|geoblock|telegram-cidr|backup|logs"; exit 1;;
esac
