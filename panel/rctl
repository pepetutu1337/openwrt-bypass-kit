# Тест ютуба. Меряем то, что реально измеримо с роутера:
# ссылка на видеопоток из watch-страницы подписана и без расшифровки n-параметра
# отдаёт 403, поэтому скорость снимаем на самой странице (1+ МБ с youtube.com,
# тот же DPI-путь), а до googlevideo проверяем связность и задержку.
R_YTTEST='
echo ":: тест ютуба"
echo ""
echo "=== куда идёт трафик ==="
mine=0
for d in www.youtube.com i.ytimg.com youtubei.googleapis.com; do
  ips=$(nslookup "$d" 127.0.0.1 2>/dev/null | grep -A20 "Name:" | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}" | grep -v "^127\." | head -4)
  [ -n "$ips" ] || { echo "  ✗ $d не резолвится — смотри DoH/dnsmasq"; continue; }
  bad=""
  for ip in $ips; do
    nft get element inet fw4 proxy4 "{ $ip }" >/dev/null 2>&1 && bad="$bad $ip"
  done
  if [ -n "$bad" ]; then
    echo "  ✗ $d уехал в прокси:$bad"
    echo "     гугл ответит бот-проверкой, видео не стартует. Лечится: geoblock google-чисткой"
    mine=1
  else
    echo "  ✓ $d идёт напрямую (через zapret)"
  fi
done
echo ""
echo "=== обход ==="
if pidof nfqws >/dev/null 2>&1; then echo "  ✓ zapret работает ($(pidof nfqws | wc -w) процессов)"; else echo "  ✗ zapret НЕ работает — вот и причина"; fi
if grep -qi googlevideo /opt/zapret/ipset/zapret-hosts-user.txt 2>/dev/null; then echo "  ✓ googlevideo в списке zapret"; else echo "  ! googlevideo НЕ в списке zapret — десинк не применяется"; fi
if [ "$(uci -q get firewall.block_quic 2>/dev/null)" = "rule" ] && [ "$(uci -q get firewall.block_quic.enabled 2>/dev/null)" != "0" ]; then echo "  ✓ QUIC блокируется, браузер уходит на TCP"; else echo "  ! QUIC не блокируется — браузер может залипнуть на UDP/443"; fi
echo ""
echo "=== скорость (страница youtube.com, ~1 МБ, тот же DPI-путь что и видео) ==="
w=/tmp/yttest.html
st=$(curl -sS -m 30 "https://www.youtube.com/watch?v=aqz-KE-bpKQ" -o "$w" -w "%{http_code} %{size_download} %{speed_download} %{time_total}" 2>/dev/null) || st=""
if [ -z "$st" ]; then
  echo "  ✗ страница не открылась вообще — ютуб недоступен с роутера"
else
  set -- $st
  code=$1; size=$2; sp=$3; tt=$4
  kb=$((sp/1024))
  echo "  код $code, $((size/1024)) КБ за ${tt}с = ${kb} КБ/с"
  if [ "$code" = "200" ]; then
    if [ "$kb" -lt 100 ]; then echo "  ✗ медленно — похоже на душилово"; elif [ "$kb" -lt 300 ]; then echo "  ! средне, на 1080p может не хватить"; else echo "  ✓ нормально"; fi
  fi
  grep -q streamingData "$w" 2>/dev/null && echo "  ✓ плеерные данные в странице есть (видео должно стартовать)" || echo "  ! в странице нет streamingData — ютуб отдал заглушку или бот-проверку"
fi
echo ""
echo "=== googlevideo (сам видеопоток) ==="
h=$(grep -o "https://rr[0-9a-z-]*\.googlevideo\.com" "$w" 2>/dev/null | head -1)
[ -n "$h" ] || h="https://rr1---sn-4g5edndd.googlevideo.com"
gt=$(curl -sS -m 15 "$h/generate_204" -o /dev/null -w "%{http_code} %{time_appconnect}" 2>/dev/null) || gt=""
if [ -n "$gt" ]; then
  set -- $gt
  echo "  ✓ $h отвечает (код $1, TLS за ${2}с)"
else
  echo "  ✗ $h недоступен — видеопоток не пойдёт"
fi
rm -f "$w"
echo ""
[ "$mine" = 1 ] && echo "ИТОГ: ютуб уехал в прокси — это и ломает старт видео." || echo "ИТОГ: маршрутизация верная, ютуб идёт напрямую через zapret."
'

# «Починить» одной кнопкой — то, что должно помогать родителям без вникания.
# Ничего не ломает: перезапускает только упавшее, ноду меняет только если она
# мертва или совсем медленная. FIX_MAX_MS — порог «совсем медленная».
R_FIX='
'"$NODE_HELPERS"'
API="'"$API"'"
b="http://$API"
MAX=${FIX_MAX_MS:-600}
changed=0
echo ":: чиню"
echo ""
for p in "sing-box:sing-box" "zapret:nfqws" "https-dns-proxy:https-dns-proxy" "dnsmasq:dnsmasq"; do
  s=${p%%:*}; bin=${p##*:}
  if pidof "$bin" >/dev/null 2>&1; then
    echo "  ✓ $s работает"
  else
    echo "  ! $s лежал — поднимаю"
    /etc/init.d/"$s" restart >/dev/null 2>&1
    sleep 2
    if pidof "$bin" >/dev/null 2>&1; then echo "    ✓ поднялся"; changed=1; else echo "    ✗ не поднялся, нужен человек"; fi
  fi
done
echo ""
sel=$(curl -s --max-time 4 "$b/proxies/proxy" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
if [ -z "$sel" ]; then
  echo "  ✗ прокси не отвечает даже после рестарта — дальше руками"
else
  active=$sel
  [ "$sel" = "auto" ] && active=$(curl -s --max-time 4 "$b/proxies/auto" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
  ms=$(curl -s --max-time 8 "$b/proxies/$(urlenc "$active")/delay?url=http://www.gstatic.com/generate_204&timeout=3000" | sed -n "s/.*\"delay\": *\([0-9][0-9]*\).*/\1/p")
  if [ -n "$ms" ] && [ "$ms" -le "$MAX" ]; then
    echo "  ✓ сервер $active отвечает за ${ms} мс — менять не буду"
  else
    [ -n "$ms" ] && echo "  ! сервер $active тормозит (${ms} мс) — ищу лучше" || echo "  ! сервер $active не отвечает — ищу живой"
    d=$(curl -s --max-time 30 "$b/group/proxy/delay?url=http://www.gstatic.com/generate_204&timeout=3000")
    all=$(nodelist "$b")
    best=""; bestms=0
    tmpb="/tmp/rctl-heal.$$"; printf "%s\n" "$all" > "$tmpb"
    while IFS= read -r n; do
      [ "$n" = "auto" ] && continue
      v=$(delay_of "$d" "$n")
      [ -n "$v" ] || continue
      if [ -z "$best" ] || [ "$v" -lt "$bestms" ]; then best=$n; bestms=$v; fi
    done < "$tmpb"
    rm -f "$tmpb"
    if [ -n "$best" ]; then
      r=$(curl -s -o /dev/null -w "%{http_code}" -X PUT "$b/proxies/proxy" -d "{\"name\":\"$best\"}")
      if [ "$r" = "204" ]; then
        echo "    ✓ переключил на $best (${bestms} мс)"; changed=1
        # Пинг у clash — это его собственная проба, а не дорога пользователя.
        # Нода отвечает на неё и при этом не пропускает ничего: так селектор
        # однажды и сел на мёртвую. Проверяем тем же socks, которым идёт трафик.
        sleep 2
        c=$(curl -s -o /dev/null -m 12 -w "%{http_code}" --socks5-hostname 127.0.0.1:1180 https://www.gstatic.com/generate_204 2>/dev/null)
        case "$c" in
          2??|3??) echo "    ✓ через неё трафик идёт" ;;
          *) echo "    ✗ пинг есть, а трафик через неё не идёт (код ${c:-000}) — попробуй другую ноду вручную" ;;
        esac
      else
        echo "    ✗ переключить не вышло (код $r)"
      fi
    else
      echo "    ✗ ни один сервер не ответил — похоже, проблема с интернетом целиком"
    fi
  fi
fi
echo ""
if ping -c1 -W3 1.1.1.1 >/dev/null 2>&1; then echo "  ✓ интернет у роутера есть"; else echo "  ✗ интернета у роутера нет — дело не в обходе, звони провайдеру"; fi

# Службы живы, нода живая — а видео всё равно стоит. Это отдельная поломка:
# её лечит не нода, а стратегия обхода. Раньше «Починить» про неё вообще не
# спрашивал и бодро отвечал «чинить было нечего» человеку, у которого ютуб
# висит. Спрашиваем и, если видео режут, зовём лечение — оно само решит, есть
# ли повод и не рано ли после прошлого раза.
echo ""
live=0; total=0
for h in rr1---sn-4g5e6nzz rr2---sn-4g5ednse rr3---sn-4g5edned redirector; do
  total=$((total + 1))
  c=$(curl -4 -o /dev/null -sS -m 6 -w "%{http_code}" "https://$h.googlevideo.com/generate_204" 2>/dev/null) || c=000
  case "$c" in 200|204) live=$((live + 1)) ;; esac
done
if [ "$total" -gt 0 ] && [ $((live * 100 / total)) -lt 60 ]; then
  echo "  ! до видео пробилось $live из $total узлов — режут поток, а не ноду"
  if [ -x /usr/sbin/ytwatch ]; then
    /usr/sbin/ytwatch heal 2>&1 | sed "s/^/    /"
    changed=1
  fi
else
  echo "  ✓ путь до видео открыт ($live из $total узлов)"
fi
echo ""
[ "$changed" = 1 ] && echo "ГОТОВО: что-то починил, попробуй ещё раз." || echo "ГОТОВО: чинить было нечего, всё и так работало."
'

R_QUIC_ON='uci set firewall.block_quic.enabled="1"; uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1; echo "✓ QUIC-блок включён"'
R_QUIC_OFF='uci set firewall.block_quic.enabled="0"; uci commit firewall; /etc/init.d/firewall reload >/dev/null 2>&1; echo "✓ QUIC-блок выключен"'

svc_ok() { case "$1" in sing-box|zapret|dnsmasq|https-dns-proxy|firewall) return 0;; *) return 1;; esac; }

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  status)   remote "$R_STATUS" ;;
  doctor)   remote "$R_DOCTOR" "${1:-$DOCTOR_DOMAIN}" ;;
  restart)
    s="${1:-}"; svc_ok "$s" || { echo "нельзя рестартить: $s"; exit 1; }
    remote "/etc/init.d/$s restart && echo \"✓ $s перезапущен\"" ;;
  toggle)
    s="${1:-}"; on="${2:-}"; svc_ok "$s" || { echo "нельзя переключать: $s"; exit 1; }
    case "$on" in
      on)  remote "/etc/init.d/$s start && echo \"✓ $s включён\"" ;;
      off) remote "/etc/init.d/$s stop && echo \"✓ $s выключен (до рестарта роутера или обратного вкл)\"" ;;
      *) echo "rctl toggle СЛУЖБА on|off"; exit 1 ;;
    esac ;;
  nodes)
    case "${1:-list}" in
      list) remote "$R_NODES" ;;
      test) remote "$R_NODE_TEST" ;;
      auto) remote "$R_NODE_AUTO" ;;
      best) remote "$R_NODES_BEST" ;;
      names) remote "$R_NODE_NAMES" ;;
      use)  shift; [ $# -ge 1 ] || { echo "rctl nodes use ИМЯ"; exit 1; }; remote "$R_NODE_USE" "$1" ;;
      *) echo "nodes list|names|test|best|use ИМЯ|auto"; exit 1 ;;
    esac ;;
  domains)
    case "${1:-list}" in
      list) remote "$R_DOMAINS_LIST" ;;
      add)  shift; [ $# -ge 1 ] || { echo "rctl domains add ДОМЕН…"; exit 1; }; remote "$R_DOMAINS_ADD" "$@" ;;
      rm)   shift; [ $# -ge 1 ] || { echo "rctl domains rm ДОМЕН"; exit 1; }; remote "$R_DOMAINS_RM" "$@" ;;
      check) shift; [ $# -ge 1 ] || { echo "rctl domains check ДОМЕН"; exit 1; }; remote "$R_DOM_CHECK" "$1" ;;
      scout) shift; remote "$R_DOM_SCOUT" "${1:-45}" "${2:-}" ;;
      *) echo "domains list|add ДОМЕН…|rm ДОМЕН|check ДОМЕН|scout [СЕК]"; exit 1 ;;
    esac ;;
  geoblock)
    case "${1:-count}" in update) remote "$R_GEO_UPDATE" ;; count) remote "$R_GEO_COUNT" ;; list) remote "$R_GEO_LIST" ;; *) echo "geoblock update|count|list"; exit 1;; esac ;;
  telegram-cidr)
    case "${1:-count}" in update) remote "$R_TGCIDR_UPDATE" ;; count) remote "$R_TGCIDR_COUNT" ;; *) echo "telegram-cidr update|count"; exit 1;; esac ;;
  tune)     # подбор стратегии zapret; сам скрипт лежит на роутере
    a="${1:-status}"; shift 2>/dev/null || true
    case "$a" in
      start)  remote '/usr/sbin/zapret-tune start "$@"' "${1:-youtube.com}" "${2:-standard}" ;;
      apply)  [ $# -ge 1 ] || { echo "rctl tune apply \"СТРАТЕГИЯ\""; exit 1; }
              remote '/usr/sbin/zapret-tune apply "$1"' "$1" ;;
      status|result|stop|log) remote "/usr/sbin/zapret-tune $a" ;;
      *) echo "tune start [домен] [quick|standard|force] | status | result | apply СТРАТЕГИЯ | stop | log"; exit 1 ;;
    esac ;;
  yttest)   remote "$R_YTTEST" ;;
  twitch)   remote "$R_TWITCH" "${1:-jynxzi}" ;;
  fix)      remote "$R_FIX" ;;
  backup)   remote "$R_BACKUP" ;;
  fetch-backup)
    p="${1:-}"
    case "$p" in
      /tmp/rctl-backup-*.tar.gz|/tmp/netkit-backup-*.tar.gz) : ;;
      *) echo "путь не похож на бэкап, отказ: $p" 1>&2; exit 1 ;;
    esac
    rcat "$p" ;;
  info)     remote "$R_INFO" ;;
  meta)     remote "$R_META" ;;
  getconfig) rcat "$SBOX" ;;                            # выдать текущий sing-box config.json
  putconfig)                                            # залить новый config (с бэкапом/проверкой/откатом)
    f="${1:-}"; [ -f "$f" ] || { echo "нет файла: $f"; exit 1; }
    # льём через ssh 'cat >' (не scp — на dropbear-роутере нет sftp-server)
    rput /tmp/sb-new.json < "$f" || { echo "✗ не удалось передать config на роутер"; exit 1; }
    remote '
      ts=$(date +%Y%m%d-%H%M%S)
      if sing-box check -c /tmp/sb-new.json 2>/tmp/sbchk.err; then
        cp /etc/sing-box/config.json /etc/sing-box/config.json.bak-$ts
        # Бэкапы копятся по одному на каждую заливку и никем не убирались:
        # к августу их набралось полтора десятка на флеше в 60 МБ. Чистим
        # только свои, с датой в имени, — именованные вручную не трогаем.
        ls -1t /etc/sing-box/config.json.bak-20* 2>/dev/null | tail -n +6 | while IFS= read -r o; do rm -f "$o"; done
        mv /tmp/sb-new.json /etc/sing-box/config.json
        /etc/init.d/sing-box restart >/dev/null 2>&1; sleep 2
        if pidof sing-box >/dev/null 2>&1; then
          echo "✓ config обновлён, sing-box поднялся (бэкап: config.json.bak-$ts)"
        else
          echo "✗ sing-box НЕ поднялся — откатываю"
          cp /etc/sing-box/config.json.bak-$ts /etc/sing-box/config.json
          /etc/init.d/sing-box restart >/dev/null 2>&1; echo "  откат готов"
        fi
      else
        echo "✗ новый config не прошёл sing-box check — НЕ применяю:"; cat /tmp/sbchk.err; rm -f /tmp/sb-new.json
      fi
    ' ;;
  rotate)                                               # ротация подписки: gazvpn меняет только uuid — переписать его в нодах
    new="${1:-}"; old="${2:-}"
    U='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
    echo "$new" | grep -qE "$U" \
      || { echo "rotate НОВЫЙ-UUID [СТАРЫЙ-UUID]   (старый нужен, если в конфиге ноды разных подписок)"; exit 1; }
    [ -z "$old" ] || echo "$old" | grep -qE "$U" || { echo "кривой СТАРЫЙ-UUID: $old"; exit 1; }
    remote '
      new="$1"; old="${2:-}"
      ts=$(date +%Y%m%d-%H%M%S)
      distinct=$(grep -o "\"uuid\": *\"[0-9a-fA-F-]\{36\}\"" /etc/sing-box/config.json | sort -u | wc -l)
      if [ -z "$old" ] && [ "$distinct" -gt 1 ]; then
        echo "✗ в конфиге $distinct разных uuid (несколько подписок?) — укажи, какой менять: rctl rotate НОВЫЙ СТАРЫЙ"
        exit 1
      fi
      [ -z "$old" ] && old="[0-9a-fA-F-]{36}"
      n=$(grep -cE "\"uuid\": *\"$old\"" /etc/sing-box/config.json || true)
      cp /etc/sing-box/config.json /etc/sing-box/config.json.bak-$ts
      sed -r "s/\"uuid\": *\"$old\"/\"uuid\": \"$new\"/g" /etc/sing-box/config.json.bak-$ts > /tmp/sb-new.json
      if cmp -s /tmp/sb-new.json /etc/sing-box/config.json; then
        echo "✓ uuid уже актуален во всех нодах — менять нечего"; rm -f /tmp/sb-new.json /etc/sing-box/config.json.bak-$ts; exit 0
      fi
      if sing-box check -c /tmp/sb-new.json 2>/tmp/sbchk.err; then
        mv /tmp/sb-new.json /etc/sing-box/config.json
        /etc/init.d/sing-box restart >/dev/null 2>&1; sleep 2
        if pidof sing-box >/dev/null 2>&1; then
          echo "✓ uuid обновлён ($n нод), sing-box поднялся (бэкап: config.json.bak-$ts)"
        else
          echo "✗ sing-box НЕ поднялся — откатываю"
          cp /etc/sing-box/config.json.bak-$ts /etc/sing-box/config.json
          /etc/init.d/sing-box restart >/dev/null 2>&1; echo "  откат готов"
        fi
      else
        echo "✗ config не прошёл sing-box check — НЕ применяю:"; cat /tmp/sbchk.err; rm -f /tmp/sb-new.json
      fi
    ' "$new" "$old" ;;
  watchdog) remote "$R_WATCHDOG" ;;
  quic)
    case "${1:-}" in on) remote "$R_QUIC_ON" ;; off) remote "$R_QUIC_OFF" ;; *) echo "quic on|off"; exit 1;; esac ;;
  logs)
    s="${1:-sing-box}"
    case "$s" in
      sing-box) remote 'logread -e sing-box | tail -60' ;;
      zapret)   remote 'logread -e zapret | tail -60; echo "--- nfqws ---"; ps w | grep -c "[n]fqws"' ;;
      dns)      remote 'logread -e dnsmasq | tail -60' ;;
      *) echo "logs sing-box|zapret|dns"; exit 1 ;;
    esac ;;
  ssh)
    if [ "$LOCAL" = 1 ]; then exec sh; else exec $SSH; fi ;;
  help|*) cat <<EOF
rctl — пульт к твоему живому роутеру ($ROUTER_IP).

  rctl status                состояние сервисов, активная нода, домены, QUIC
  rctl doctor [домен]        ПОЛНЫЙ чекап: сервисы→DNS→proxy4/6→нода→QUIC→split-RU→IPv6→домены→geoblock→telegram-cidr→WAN→краны
  rctl restart sing-box|zapret|dnsmasq|https-dns-proxy
  rctl toggle СЛУЖБА on|off  включить/выключить службу (без рестарта роутера)
  rctl fix                   починить одной командой: поднять упавшее, сменить мёртвую/тормозящую ноду
  rctl tune start|status|result|apply|stop  подбор стратегии zapret через blockcheck
                             (на время подбора обход отключается — blockcheck поднимает свой nfqws)
  rctl yttest                тест ютуба: не уехал ли в прокси, жив ли zapret, скорость, googlevideo
  rctl twitch [КАНАЛ]        тест твича: куда идёт usher и даёт ли он 1080p
  rctl nodes list|test|best|use ИМЯ|auto живые ноды через clash API :9090 (best = закрепить лучшую по пингу)
  rctl domains list|add ДОМЕН…|rm ДОМЕН  проксируемые домены (uci-ipset)
  rctl domains scout [СЕК] [IP|-]   разведка: какие ещё домены нужны сайту (открой сайт, пока идёт)
  rctl domains check ДОМЕН    разбор: заведён ли, куда резолвится, идёт ли в прокси
  rctl geoblock update|count|list        авто-список ушедших из РФ (list = все домены)
  rctl telegram-cidr update|count        офиц. CIDR Telegram (core.telegram.org), доп.файл, база не трогается
  rctl backup                 sysupgrade-бэкап конфигов (НЕ прошивка), путь во вывод — тянуть через панель/scp
  rctl info                  система: модель, прошивка, аптайм, WAN, версии
  rctl meta                  модель/хост/подсеть (для заголовка панели)
  rctl rotate UUID [СТАРЫЙ]  ротация подписки: сменить uuid в нодах (старый — если подписок несколько)
  rctl watchdog              прогнать сторож нод сейчас
  rctl quic on|off           блок QUIC (udp/443)
  rctl logs sing-box|zapret|dns
  rctl ssh                   шелл на роутер
EOF
  ;;
esac
