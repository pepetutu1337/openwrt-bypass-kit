#!/bin/sh
# ============================================================
#  rctl — пульт к ТВОЕМУ живому роутеру (AX3000T / OpenWrt 25.12.5).
#  Не кит: роутер настроен руками (sing-box redirect :1100, uci-ipset
#  proxy4/6, https-dns-proxy :5053/:5054, zapret в /opt/zapret,
#  geoblock-update + proxy-watchdog, split-ru, clash API :9090).
#  rctl просто ходит по SSH и дёргает эти реальные команды/пути.
#  Отдельно от репозитория (kit) — тут команды под конкретно этот роутер.
# ============================================================
set -eu
DIR="$(cd "$(dirname "$0")" && pwd)"
CONF="$DIR/panel.conf"

# Два режима работы:
#   LOCAL=1 — rctl лежит на самом роутере, команды выполняются напрямую (панель
#             на uhttpd, Telegram-бот). SSH не нужен и panel.conf не обязателен.
#   LOCAL=0 — rctl на Деке, ходит на роутер по SSH.
if [ "${RCTL_LOCAL:-}" = 1 ] || { [ -f /etc/openwrt_release ] && command -v uci >/dev/null 2>&1; }; then
  LOCAL=1
else
  LOCAL=0
fi

if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
elif [ "$LOCAL" = 0 ]; then
  echo "нет $CONF"; exit 1
fi

ROUTER_IP="${ROUTER_IP:-127.0.0.1}"
SBOX=/etc/sing-box/config.json
API="${CLASH_API:-127.0.0.1:9090}"
# без panel.conf (режим «rctl лежит на роутере») переменная не задана,
# а с set -u это роняло `rctl doctor` — кнопка «Полный чекап» в панели молчала
DOCTOR_DOMAIN="${DOCTOR_DOMAIN:-claude.ai}"

if [ "$LOCAL" = 1 ]; then
  SSH=""
else
  KEY_OPT=""; [ -n "${ROUTER_SSH_KEY:-}" ] && KEY_OPT="-i $ROUTER_SSH_KEY"
  # Мультиплексирование: одно живое соединение на минуту вместо рукопожатия
  # с dropbear на каждую подкоманду. status+nodes+info подряд экономят секунды.
  MUX="${TMPDIR:-/tmp}/rctl-mux-$(id -u)"
  mkdir -p "$MUX" 2>/dev/null || true
  chmod 700 "$MUX" 2>/dev/null || true
  SSH="ssh $KEY_OPT -p ${ROUTER_SSH_PORT:-22} -o ConnectTimeout=8 -o BatchMode=yes -o ControlMaster=auto -o ControlPath=$MUX/%r@%h:%p -o ControlPersist=60s ${ROUTER_SSH_USER}@${ROUTER_IP}"
fi

# выполнить sh-скрипт (из stdin), позиционные args после --
remote() {
  script="$1"; shift
  if [ "$LOCAL" = 1 ]; then
    printf '%s' "$script" | sh -s -- "$@"
  else
    # Аргументы уезжают через ещё один слой шелла (dropbear), поэтому каждый
    # заворачиваем в одинарные кавычки. Без этого имя ноды с пробелом —
    # «🇩🇪 Германия  GRPS», «🇺🇸 США - Нейросети » — приезжало на роутер
    # разорванным на куски, и селектор молча не переключался.
    q=""
    for a in "$@"; do q="$q '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"; done
    printf '%s' "$script" | $SSH "sh -s --$q"
  fi
}

# прочитать файл роутера в stdout / записать файл роутера из stdin
rcat() { if [ "$LOCAL" = 1 ]; then cat "$1"; else $SSH "cat '$1'"; fi; }
rput() { if [ "$LOCAL" = 1 ]; then cat > "$1"; else $SSH "cat > '$1'"; fi; }

# ---- удалённые скрипты (busybox sh, БЕЗ jq — парсим grep/sed) ----------------

R_STATUS='
echo ":: роутер $(uci -q get network.lan.ipaddr 2>/dev/null || echo ?)"
echo "=== сервисы ==="
for p in "sing-box:sing-box" "zapret:nfqws" "DoH:https-dns-proxy" "dnsmasq:dnsmasq"; do
  n=${p%%:*}; b=${p##*:}
  if pidof "$b" >/dev/null 2>&1; then echo "$n ● running"; else echo "$n ✗ stopped"; fi
done
echo "=== прокси ==="
API="'"$API"'"
sel=$(curl -s --max-time 4 "http://$API/proxies/proxy" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
node=$sel
[ "$sel" = "auto" ] && node=$(curl -s --max-time 4 "http://$API/proxies/auto" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
[ -n "$node" ] && echo "активная нода: $node" || echo "! clash API $API не ответил (sing-box запущен?)"
dc=$(uci -q get dhcp.@ipset[0].domain 2>/dev/null | wc -w)
echo "проксируемых доменов (uci): ${dc:-0}"
[ -f /etc/dnsmasq.d/geoblock.conf ] && echo "geoblock: $(grep -c proxy4 /etc/dnsmasq.d/geoblock.conf) доменов" || echo "geoblock: файла нет"
if [ "$(uci -q get firewall.block_quic 2>/dev/null)" = "rule" ] && [ "$(uci -q get firewall.block_quic.enabled 2>/dev/null)" != "0" ]; then echo "QUIC-блок: включён (REJECT udp/443 lan->wan)"; else echo "QUIC-блок: выключен"; fi
'

R_DOCTOR='
D=${1:-claude.ai}
API="'"$API"'"
echo ":: ПОЛНЫЙ чекап (тест-домен: $D)"
echo ""
echo "=== сервисы ==="
for p in "sing-box:sing-box" "zapret:nfqws" "dnsmasq:dnsmasq" "DoH:https-dns-proxy"; do
  n=${p%%:*}; b=${p##*:}
  if pidof "$b" >/dev/null 2>&1; then echo "  ✓ $n работает"; else echo "  ✗ $n НЕ запущен"; fi
done
echo ""
echo "=== DNS через DoH: $D ==="
res=$(nslookup "$D" 127.0.0.1 2>/dev/null)
v4=$(printf "%s" "$res" | grep -oE "([0-9]{1,3}\.){3}[0-9]{1,3}" | grep -v "^127\.0\.0\.1$" | head -1)
v6=$(printf "%s" "$res" | grep -oiE "([0-9a-f]{0,4}:){2,}[0-9a-f]{0,4}" | head -1)
[ -n "$v4" ] && echo "  ✓ A:    $v4" || echo "  ✗ нет A-записи (v4) — проверь dnsmasq/DoH"
[ -n "$v6" ] && echo "  · AAAA: $v6"
if [ -n "$v4" ]; then nft get element inet fw4 proxy4 "{ $v4 }" >/dev/null 2>&1 && echo "  ✓ $v4 в proxy4 (пойдёт через ноду)" || echo "  ! $v4 НЕ в proxy4 (домен добавлен в проксируемые?)"; fi
if [ -n "$v6" ]; then nft get element inet fw4 proxy6 "{ $v6 }" >/dev/null 2>&1 && echo "  ✓ $v6 в proxy6" || echo "  · $v6 не в proxy6 — ок, если у LAN-клиентов v6 выключен"; fi
echo ""
echo "=== активная нода ==="
sel=$(curl -s --max-time 4 "http://$API/proxies/proxy" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
node=$sel; [ "$sel" = "auto" ] && node=$(curl -s --max-time 4 "http://$API/proxies/auto" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
[ -n "$node" ] && echo "  ✓ selector=$sel  нода=$node" || echo "  ✗ clash API $API не ответил (sing-box запущен?)"
echo ""
echo "=== QUIC-блок ==="
if [ "$(uci -q get firewall.block_quic 2>/dev/null)" = "rule" ] && [ "$(uci -q get firewall.block_quic.enabled 2>/dev/null)" != "0" ]; then echo "  ✓ включён (REJECT udp/443 lan->wan)"; else echo "  ! выключен"; fi
echo ""
echo "=== split-DNS (РФ-сайты, тест www.vtb.ru) ==="
# Мало знать, что РФ-имя резолвится, — важно, каким путём. Открытый 53
# перехватывает ТСПУ и отвечает вместо того, кого спросили, так что «резолв
# жив» на открытом пути ещё не значит «ответ настоящий».
if grep -q "^server=/.*/127\.0\.0\.1#" /etc/dnsmasq.d/split-ru.conf 2>/dev/null; then
  echo "  путь: шифрованный DoH (свой https-dns-proxy)"
  [ -f /etc/rudns.fallback ] && echo "  ! сторож откатывал канал и ещё не вернул — смотри logread -t rudns-guard"
else
  echo "  ! путь: открытый 53 — такие ответы подменяет ТСПУ"
fi
# dnsmasq читает /etc/dnsmasq.d ЦЕЛИКОМ, без фильтра по расширению. Любой
# файл, оставленный тут «на всякий случай», — не бэкап, а живой кусок
# конфига. Один такой (split-ru.conf.bak-plain53) месяцами подмешивал
# открытый 53 рядом с DoH: в самом split-ru.conf было честно написано
# «через DoH», а запросы шли обоими путями, и dnsmasq выбирал быстрый.
# Проверять сам файл поэтому мало — надо смотреть всю папку.
stray=$(ls /etc/dnsmasq.d 2>/dev/null | grep -vE '\.conf$')
if [ -n "$stray" ]; then
  echo "  ! в /etc/dnsmasq.d лежит лишнее — dnsmasq читает это как конфиг:"
  echo "$stray" | sed 's/^/      /'
  echo "      убрать: rm /etc/dnsmasq.d/<файл> && /etc/init.d/dnsmasq restart"
fi
rip=$(nslookup www.vtb.ru 127.0.0.1 2>/dev/null | awk "/^Address/{print \$NF}" | grep -v "#" | grep "\." | tail -1)
[ -n "$rip" ] && echo "  ✓ www.vtb.ru -> $rip (РФ-резолв жив)" || echo "  ✗ www.vtb.ru не резолвится — проверь split-ru/дефолт DNS"
echo ""
echo "=== запасной DNS через ноду ==="
# Публичные резолверы известны наперечёт, и закрыть к ним 443 — работа на
# полчаса. Запрос внутри туннеля так не закрыть, не закрыв туннель, поэтому
# ядро держит свой резолвер, а dnsmasq знает о нём как о запасном апстриме.
if netstat -lnp 2>/dev/null | grep -q "127.0.0.1:5056"; then
  a=$(nslookup example.com 127.0.0.1:5056 2>/dev/null | awk "/^Address/{print \$NF}" | grep -v "#" | grep "\." | tail -1)
  [ -n "$a" ] && echo "  ✓ резолвер ядра на 5056 отвечает (example.com -> $a)" \
              || echo "  ! порт 5056 слушает, но ответа нет — нода лежит?"
  uci show dhcp 2>/dev/null | grep -q "127.0.0.1#5056" \
    && echo "  ✓ dnsmasq знает о нём как о запасном" \
    || echo "  ! dnsmasq о нём не знает: uci add_list dhcp.@dnsmasq[0].server=127.0.0.1#5056"
else
  echo "  ! не поднят — DNS держится только на публичных адресах резолверов"
fi
echo ""
echo "=== IPv6 на LAN (утечка мимо ноды) ==="
ra=$(uci -q get dhcp.lan.ra 2>/dev/null)
[ "$ra" = "disabled" ] && echo "  ✓ отключён — утечки нет" || echo "  ! dhcp.lan.ra=\"${ra:-?}\" — v6 может течь мимо ноды"
echo ""
echo "=== домены (uci-ipset) ==="
dc=$(uci -q get dhcp.@ipset[0].domain 2>/dev/null | wc -w)
echo "  проксируемых доменов: ${dc:-0}"
echo ""
echo "=== geoblock (ушедшие из РФ) ==="
if [ -f /etc/dnsmasq.d/geoblock.conf ]; then echo "  ✓ $(grep -c proxy4 /etc/dnsmasq.d/geoblock.conf) доменов"
else echo "  ✗ файла нет — geoblock update ни разу не запускался?"; fi
echo ""
echo "=== telegram CIDR (MTProto ходит по IP) ==="
f=/etc/nftables.d/20-proxy.nft; e=/etc/nftables.d/21-telegram-cidr-extra.nft
if [ -f "$f" ]; then
  v4c=$(grep -ohE "[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}" "$f" "$e" 2>/dev/null | sort -u | wc -l)
  echo "  ✓ $v4c диапазонов v4 (обновить: telegram-cidr update)"
else echo "  · $f нет — Telegram CIDR тут не заведён этим способом"; fi
echo ""
echo "=== WAN ==="
w=$(ubus call network.interface.wan status 2>/dev/null | sed -n "s/.*\"address\": *\"\([0-9.]*\)\".*/\1/p" | head -1)
[ -n "$w" ] && echo "  ✓ WAN IP: $w" || echo "  ✗ WAN без адреса — интернета на роутере нет?"
echo ""
echo "=== кроны ==="
crontab -l 2>/dev/null | grep -E "geoblock|watchdog|telegram-cidr" | sed "s/^/  /" || echo "  ! нет geoblock/watchdog/telegram-cidr в кроне"
echo ""
echo "готово — полный чекап завершён"
'

# Имена нод приходят из подписки и меняются вместе с ней: там пробелы, эмодзи
# и кириллица. Поэтому список берём построчно, а не через пробел, и всякое имя,
# уходящее в URL, кодируем — иначе запрос с пробелом внутри пути разваливается.
NODE_HELPERS='
nodelist() {
  curl -s --max-time 4 "$1/proxies/proxy" |
    sed -n "s/.*\"all\": *\[\([^]]*\)\].*/\1/p" |
    grep -o "\"[^\"]*\"" | sed "s/^\"//; s/\"$//"
}
urlenc() {
  # Побайтно: имя ноды приходит в UTF-8, и посимвольный разбор тут не годится.
  # od в этой сборке busybox нет, hexdump есть.
  printf "%s" "$1" | hexdump -v -e "1/1 \"%02x \"" | tr " " "\n" | grep -v "^$" | while read -r h; do
    c=$(printf "\\x$h")
    case "$c" in
      [a-zA-Z0-9.~_-]) printf "%s" "$c" ;;
      *) printf "%%%s" "$h" ;;
    esac
  done
}
delay_of() {
  # $1 — json группового замера, $2 — имя ноды. Имя ищем как есть, но берём
  # только цифры сразу за ним, иначе жадный разбор цепляет соседнюю ноду.
  printf "%s" "$1" | tr "," "\n" | grep -F "\"$2\"" | sed -n "s/.*: *\([0-9][0-9]*\).*/\1/p" | head -1
}
'

# полный список ВСЕХ серверов селектора с живым пингом (одним запросом /group/proxy/delay)
R_NODES='
'"$NODE_HELPERS"'
API="'"$API"'"
b="http://$API"
sel=$(curl -s --max-time 4 "$b/proxies/proxy" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
au=$(curl -s --max-time 4 "$b/proxies/auto" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
active=$sel; [ "$sel" = "auto" ] && active=$au
all=$(nodelist "$b")
[ -n "$all" ] || { echo "! clash API $API не ответил (sing-box запущен?)"; exit 1; }
echo ":: пингую все ноды через прокси (до gstatic /generate_204)…"
echo "   групповой замер идёт одним запросом, до 30 с — ждём"
d=$(curl -s --max-time 30 "$b/group/proxy/delay?url=http://www.gstatic.com/generate_204&timeout=3000")
# Групповой замер систематически молчит про часть живых нод (проверено: albania
# в группе "-", а одиночным запросом 388 мс). Дожимаем промолчавшие поштучно.
# Строго последовательно и с коротким таймаутом: sing-box обрабатывает delay-
# запросы по одному, параллельный запуск вешает всю команду на минуты.
tmp="/tmp/rctl-nodes.$$"; rm -rf "$tmp"; mkdir -p "$tmp"
# Имена кладём по номеру, а не в имя файла: в имени ноды бывают пробелы и
# косые, а файл с косой не создашь.
printf "%s\n" "$all" > "$tmp/names"
i=0
while IFS= read -r n; do
  i=$((i+1))
  [ "$n" = "auto" ] && continue
  ms=$(delay_of "$d" "$n")
  [ -n "$ms" ] && printf "%s" "$ms" > "$tmp/$i"
done < "$tmp/names"
# Групповой замер систематически молчит про часть живых нод — дожимаем их
# поштучно, строго по одной.
# Сколько нод придётся дожимать — считаем заранее, чтобы в ходе прогона
# было видно «сколько из скольких», а не безымянный поток строк.
todo=0; i=0
while IFS= read -r n; do
  i=$((i+1))
  [ "$n" = "auto" ] && continue
  [ -s "$tmp/$i" ] || todo=$((todo+1))
done < "$tmp/names"
i=0
miss=0
while IFS= read -r n; do
  i=$((i+1))
  [ "$n" = "auto" ] && continue
  [ -s "$tmp/$i" ] && continue
  miss=$((miss+1))
  [ "$miss" = 1 ] && echo ":: групповой замер промолчал про $todo нод — перепроверяю поштучно (до 3 с на ноду)…"
  curl -s --max-time 3 "$b/proxies/$(urlenc "$n")/delay?url=http://www.gstatic.com/generate_204&timeout=2500" |
    sed -n "s/.*\"delay\": *\([0-9][0-9]*\).*/\1/p" > "$tmp/$i"
  if [ -s "$tmp/$i" ]; then
    echo "   $miss/$todo  $n — $(cat "$tmp/$i") мс"
  else
    echo "   $miss/$todo  $n — молчит"
  fi
done < "$tmp/names"
echo ""
# Машинная строка для панели + строки таблицы. Колонки пробелами тут не
# выровнять: busybox считает ширину в байтах и кириллица уводит столбец.
echo "active: $active"
echo "selector: $sel"
echo "tbl|сервер|пинг|состояние"
up=0; down=0
i=0
while IFS= read -r n; do
  i=$((i+1))
  [ "$n" = "auto" ] && continue
  ms=$(cat "$tmp/$i" 2>/dev/null)
  if [ -n "$ms" ]; then
    q="хорошо"; [ "$ms" -gt 250 ] 2>/dev/null && q="ок"; [ "$ms" -gt 450 ] 2>/dev/null && q="медленно"
    [ "$n" = "$active" ] && q="$q, работаем через него"
    echo "tbl|$n|$ms мс|$q"; up=$((up+1))
  else
    echo "tbl|$n|нет|молчит"; down=$((down+1))
  fi
done < "$tmp/names"
rm -rf "$tmp"
echo ""
echo "живых: $up, молчат: $down. Работаем через: $active (selector=$sel; auto -> $au)"
'

# только имена серверов и активный — без замеров, чтобы панель могла
# показать полосу серверов сразу, не гоняя пинги на каждое открытие
R_NODE_NAMES='
'"$NODE_HELPERS"'
API="'"$API"'"
b="http://$API"
sel=$(curl -s --max-time 4 "$b/proxies/proxy" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
au=$(curl -s --max-time 4 "$b/proxies/auto" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
active=$sel; [ "$sel" = "auto" ] && active=$au
all=$(nodelist "$b")
[ -n "$all" ] || { echo "! clash API $API не ответил (sing-box запущен?)"; exit 1; }
echo "active: $active"
echo "selector: $sel"
printf "%s\n" "$all" | while IFS= read -r n; do [ "$n" = "auto" ] || echo "node: $n"; done
'

# алиас: то же самое (свежий пинг всех)
R_NODE_TEST="$R_NODES"

# выбрать живую ноду с лучшим пингом и закрепить селектор на ней
R_NODES_BEST='
'"$NODE_HELPERS"'
API="'"$API"'"
b="http://$API"
sel=$(curl -s --max-time 4 "$b/proxies/proxy" | sed -n "s/.*\"now\": *\"\([^\"]*\)\".*/\1/p")
all=$(nodelist "$b")
[ -n "$all" ] || { echo "! clash API $API не ответил (sing-box запущен?)"; exit 1; }
echo ":: меряю все ноды… (групповой замер, до 30 с)"
d=$(curl -s --max-time 30 "$b/group/proxy/delay?url=http://www.gstatic.com/generate_204&timeout=3000")
best=""; bestms=0
tmpb="/tmp/rctl-best.$$"; printf "%s\n" "$all" > "$tmpb"
while IFS= read -r n; do
  [ "$n" = "auto" ] && continue
  ms=$(delay_of "$d" "$n")
  [ -n "$ms" ] || continue
  if [ -z "$best" ] || [ "$ms" -lt "$bestms" ]; then best=$n; bestms=$ms; fi
done < "$tmpb"
rm -f "$tmpb"
[ -n "$best" ] || { echo "✗ ни одна нода не ответила — сеть роутера или подписка"; exit 1; }
if [ "$sel" = "$best" ]; then
  echo "✓ уже на лучшей: $best ($bestms ms)"
  exit 0
fi
r=$(curl -s -o /dev/null -w "%{http_code}" -X PUT "$b/proxies/proxy" -d "{\"name\":\"$best\"}")
if [ "$r" = "204" ]; then echo "✓ переключил: $sel -> $best ($bestms ms)"; else echo "✗ не переключилось (код $r)"; exit 1; fi
'

R_NODE_USE='
API="'"$API"'"
N=$1
r=$(curl -s -o /dev/null -w "%{http_code}" -X PUT "http://$API/proxies/proxy" -d "{\"name\":\"$N\"}")
[ "$r" = "204" ] && echo "✓ selector -> $N" || echo "✗ не переключилось (код $r, имя точное? нода в группе?)"
'

R_NODE_AUTO='
API="'"$API"'"
r=$(curl -s -o /dev/null -w "%{http_code}" -X PUT "http://$API/proxies/proxy" -d "{\"name\":\"auto\"}")
[ "$r" = "204" ] && echo "✓ selector -> auto (авто-выбор быстрейшей)" || echo "✗ код $r"
'

# Разведка спутников: какие ещё хосты нужны сайту, чтобы он заработал.
#
# Одного имени сайту почти никогда не хватает: страница лежит на одном домене,
# картинки на втором, а поток — на третьем, и третий часто не угадывается ни по
# имени, ни по вёрстке. Ловили на саундклауде: soundcloud.com и sndcdn.com были
# в списке, страница открывалась, а треки молчали — аудио идёт с
# playback.media-streaming.soundcloud.cloud, и этот адрес появляется только в
# ответе их API, ни в какой разметке его нет.
#
# Поэтому спрашиваем не разметку, а сам роутер: на время разведки включаем
# журнал DNS-запросов, человек открывает сайт и щёлкает по нему, а мы смотрим,
# какие имена dnsmasq спросили в это окно. Список получается настоящий.
R_DOM_SCOUT='
secs=${1:-45}
case "$secs" in *[!0-9]*|"") secs=45 ;; esac
[ "$secs" -gt 180 ] && secs=180
[ "$secs" -lt 10 ] && secs=10

# Роутер видит запросы всех устройств сразу, и в улов попадают телефон в
# кармане и телевизор в другой комнате. Поэтому по умолчанию слушаем только то
# устройство, с которого пришли: "-" — слушать всех.
who=${2:-}
[ -z "$who" ] && who=$(echo "${SSH_CLIENT:-}" | awk "{print \$1}")
[ "$who" = "-" ] && who=""

was=$(uci -q get dhcp.@dnsmasq[0].logqueries)
uci set dhcp.@dnsmasq[0].logqueries=1
uci commit dhcp
/etc/init.d/dnsmasq restart >/dev/null 2>&1
sleep 2

# отметка, от которой считаем: всё, что было в кольцевом журнале раньше, не наше
mark="netkit-scout-$(date +%s)"
logger -t netkit-scout "$mark"

echo ":: журнал DNS включён на $secs с"
[ -n "$who" ] && echo ":: слушаю только $who (все устройства: добавь \"-\" вторым доводом)" \
              || echo ":: слушаю все устройства сети"
echo ":: ОТКРОЙ САЙТ и погоняй его — включи трек, промотай, открой пару страниц"
echo ""
i=0
while [ "$i" -lt "$secs" ]; do
  sleep 5
  i=$((i + 5))
  # grep -c возвращает единицу, когда совпадений нет, поэтому связку через
  # || тут ставить нельзя: на пустом улове печатались обе ветки сразу.
  n=$(logread 2>/dev/null | sed -n "/$mark/,\$p" | grep "query\[A" |
      grep -c "${who:+from $who\$}${who:-.}")
  [ -n "$n" ] || n=0
  echo "   $i из $secs с — имён спрошено: $n"
done

logread 2>/dev/null | sed -n "/$mark/,\$p" | grep "query\[A" |
  grep "${who:+from $who\$}${who:-.}" |
  sed -n "s/.*query\[A\{1,4\}\] \([^ ]*\) from.*/\1/p" |
  tr "A-Z" "a-z" | sort -u > /tmp/scout-hosts.txt

# восстанавливаем журнал как было — он шумный и место в кольце не бесконечное
if [ -n "$was" ]; then uci set dhcp.@dnsmasq[0].logqueries="$was"
else uci -q delete dhcp.@dnsmasq[0].logqueries; fi
uci commit dhcp
/etc/init.d/dnsmasq restart >/dev/null 2>&1

cur=" $(uci -q get dhcp.@ipset[0].domain) "

# Схлопываем хосты до домена второго уровня: в список идёт он, dnsmasq сам
# накрывает все поддомены. Для доменов вида co.uk оставляем три уровня.
regd() {
  case "$1" in
    *.co.uk|*.com.br|*.co.jp|*.com.au|*.co.nz|*.com.tr)
      echo "$1" | awk -F. "{print \$(NF-2)\".\"\$(NF-1)\".\"\$NF}" ;;
    *) echo "$1" | awk -F. "{if (NF>=2) print \$(NF-1)\".\"\$NF; else print \$0}" ;;
  esac
}

echo ""
echo ":: спрошено имён: $(wc -l < /tmp/scout-hosts.txt)"
echo ""

: > /tmp/scout-new.txt
while IFS= read -r h; do
  [ -n "$h" ] || continue
  case "$h" in
    *.lan|*.local|*.arpa|*.invalid|localhost) continue ;;
  esac
  d=$(regd "$h")
  case " $(cat /tmp/scout-new.txt | tr "\n" " ") " in *" $d "*) continue ;; esac
  case "$cur" in
    *" $d "*) continue ;;                      # уже в списке — не показываем
  esac
  if [ -f /etc/dnsmasq.d/geoblock.conf ] && grep -q "^nftset=/$d/" /etc/dnsmasq.d/geoblock.conf; then
    continue                                    # накрыт автосписком геоблока
  fi
  echo "$d" >> /tmp/scout-new.txt
done < /tmp/scout-hosts.txt

if [ ! -s /tmp/scout-new.txt ]; then
  echo "Все спрошенные домены уже покрыты — добавлять нечего."
  exit 0
fi

echo "tbl|домен|имён|напрямую|через ноду"
while IFS= read -r d; do
  n=$(grep -c "\\.\\{0,\\}$d\$" /tmp/scout-hosts.txt)
  h=$(grep "$d\$" /tmp/scout-hosts.txt | head -1)
  [ -n "$h" ] || h=$d
  c1=$(curl -s -o /dev/null -w "%{http_code}" -m 8 "https://$h/" 2>/dev/null)
  c2=$(curl -s -o /dev/null -w "%{http_code}" -m 10 --socks5-hostname 127.0.0.1:1180 "https://$h/" 2>/dev/null)
  echo "tbl|$d|$n|${c1:-000}|${c2:-000}"
done < /tmp/scout-new.txt

echo ""
echo "Добавить все разом:  rctl domains add $(tr "\n" " " < /tmp/scout-new.txt)"
echo "Столбцы «напрямую» и «через ноду» — что ответил хост тем и другим путём."
echo "000 напрямую и код через ноду — как раз тот случай, когда домен нужен в списке."
'

R_DOMAINS_LIST='
n=$(uci -q get dhcp.@ipset[0].domain | tr " " "\n" | sort | grep .)
echo ":: проксируемых доменов (uci-ipset): $(printf "%s\n" "$n" | grep -c .)"
echo ""
printf "%s\n" "$n" | awk "{printf \"%4d  %s\n\", NR, \$0}"
'

# Общий кусок: резолв домена через локальный dnsmasq + проверка, что его адреса
# реально лежат в nft-наборе proxy4 (то есть трафик к ним пойдёт в прокси).
# Печатает строки-отчёт, наружу отдаёт "hit/miss/nodns" через $VERDICT.
R_DOM_VERIFY='
dom_verify() {
  _d="$1"
  _ips=$(nslookup "$_d" 127.0.0.1 2>/dev/null |
           sed -n "s/^Address: *//p; s/^Address [0-9]*: *//p" |
           grep -E "^([0-9]{1,3}\.){3}[0-9]{1,3}$" | grep -v "^127\." | sort -u)
  if [ -z "$_ips" ]; then
    echo "  ✗ $_d не резолвится с роутера (DNS/DoH лежит? домена не существует?)"
    VERDICT=nodns; return 0
  fi
  _in=0; _out=0
  for _ip in $_ips; do
    if nft get element inet fw4 proxy4 "{ $_ip }" >/dev/null 2>&1; then
      echo "  ✓ $_ip → в прокси"; _in=$((_in+1))
    else
      echo "  · $_ip → мимо прокси (напрямую)"; _out=$((_out+1))
    fi
  done
  if [ "$_in" -gt 0 ] && [ "$_out" = 0 ]; then VERDICT=hit
  elif [ "$_in" -gt 0 ]; then VERDICT=part
  else VERDICT=miss; fi
  return 0
}
'

R_DOMAINS_ADD="$R_DOM_VERIFY"'
added=""
cur=" $(uci -q get dhcp.@ipset[0].domain) "
for d in "$@"; do
  case "$cur" in
    *" $d "*) echo "  · $d уже в списке"; continue ;;
  esac
  uci add_list dhcp.@ipset[0].domain="$d"
  uci add_list dhcp.@ipset[1].domain="$d"
  uci add_list dhcp.@dnsmasq[0].server="/$d/127.0.0.1#5053"
  cur="$cur$d "
  added="$added $d"
  echo "  + $d"
done
if [ -z "$added" ]; then
  echo "✓ нечего добавлять — всё уже в списке"
else
  uci commit dhcp && /etc/init.d/dnsmasq restart && echo "✓ применено (dnsmasq перезапущен)"
  sleep 1
  echo ""
  echo "=== проверка ==="
  bad=0
  for d in $added; do
    VERDICT=""
    dom_verify "$d"
    case "$VERDICT" in
      hit)  echo "  ✓ $d поедет через прокси" ;;
      part) echo "  ! $d: часть адресов мимо — перезагрузи страницу и проверь ещё раз" ; bad=1 ;;
      miss) echo "  ! $d: адреса пока не в наборе (обычно это старый DNS-кэш) — см. ниже"; bad=1 ;;
      *)    bad=1 ;;
    esac
  done
  echo ""
  if [ "$bad" = 1 ]; then
    echo "Что делать: на устройстве сбросить DNS-кэш и перезайти на сайт."
    echo "  · телефон/ноут — выключить и включить Wi-Fi;"
    echo "  · Chrome держит свой кэш — chrome://net-internals/#dns → Clear host cache;"
    echo "  · если в браузере включён DoH (Secure DNS) — выключить, иначе роутер не видит запрос."
  else
    echo "Если сайт всё равно не открывается: на устройстве сбросить DNS-кэш"
    echo "(выкл/вкл Wi-Fi) и выключить Secure DNS в браузере — он ходит мимо роутера."
  fi
fi
'

R_DOMAINS_RM='
for d in "$@"; do
  uci del_list dhcp.@ipset[0].domain="$d" 2>/dev/null
  uci del_list dhcp.@ipset[1].domain="$d" 2>/dev/null
  uci del_list dhcp.@dnsmasq[0].server="/$d/127.0.0.1#5053" 2>/dev/null
  echo "  - $d"
done
uci commit dhcp && /etc/init.d/dnsmasq restart && echo "✓ убрано (dnsmasq перезапущен)"
'

# Разбор одного домена: где он числится, куда резолвится, пойдёт ли в прокси,
# и открывается ли он с роутера напрямую и через ноду.
R_DOM_CHECK="$R_DOM_VERIFY"'
d="$1"
echo ":: разбор $d"
echo ""
echo "=== где числится ==="
cur=" $(uci -q get dhcp.@ipset[0].domain) "
case "$cur" in
  *" $d "*) echo "  ✓ в своём списке (проксируемые домены)" ;;
  *) echo "  · в своём списке НЕТ" ;;
esac
if [ -f /etc/dnsmasq.d/geoblock.conf ] && grep -q "^nftset=/$d/" /etc/dnsmasq.d/geoblock.conf; then
  echo "  ✓ есть в автосписке geoblock"
fi
if [ -f /etc/geoblock-exclude.txt ] && printf "%s\n" "$d" | grep -qEf /etc/geoblock-exclude.txt 2>/dev/null; then
  echo "  ! домен под исключением geoblock-exclude — в прокси его пускать запрещено"
fi
echo ""
echo "=== куда резолвится и пойдёт ли в прокси ==="
VERDICT=""
dom_verify "$d"
echo ""
echo "=== открывается ли с роутера ==="
c1=$(curl -s -o /dev/null -w "%{http_code}" -m 12 "https://$d/" 2>/dev/null)
echo "  напрямую: код ${c1:-000}"
c2=$(curl -s -o /dev/null -w "%{http_code}" -m 15 --socks5-hostname 127.0.0.1:1180 "https://$d/" 2>/dev/null)
echo "  через ноду: код ${c2:-000}"
echo ""
case "$VERDICT" in
  hit)  echo "ИТОГ: домен заведён и адреса в прокси." ;;
  part) echo "ИТОГ: часть адресов мимо прокси — у сайта CDN с плавающими IP, обнови страницу." ;;
  miss) echo "ИТОГ: домен резолвится, но адреса не в наборе. Либо он не добавлен, либо dnsmasq отдал ответ из старого кэша." ;;
  nodns) echo "ИТОГ: домен вообще не резолвится с роутера — сначала чинить DNS." ;;
esac
if [ "${c1:-000}" != "000" ] && [ "${c2:-000}" = "000" ]; then
  echo "  Напрямую сайт открывается, через ноду — нет: в прокси его гнать не нужно."
fi
if [ "${c1:-000}" = "000" ] && [ "${c2:-000}" != "000" ]; then
  echo "  Напрямую заблокирован, через ноду открывается — прокси для него правильный путь."
fi
echo "  Если с роутера сайт открывается, а на устройстве нет — дело в кэше DNS устройства"
echo "  или в Secure DNS (DoH) браузера: он ходит мимо роутера, и правило не срабатывает."
'

R_GEO_UPDATE='[ -x /usr/sbin/geoblock-update ] && /usr/sbin/geoblock-update || sh /usr/sbin/geoblock-update'
R_GEO_COUNT='[ -f /etc/dnsmasq.d/geoblock.conf ] && echo "geoblock: $(grep -c proxy4 /etc/dnsmasq.d/geoblock.conf) доменов" || echo "файла /etc/dnsmasq.d/geoblock.conf нет"'
R_GEO_LIST='
f=/etc/dnsmasq.d/geoblock.conf
[ -f "$f" ] || { echo "файла geoblock нет"; exit 0; }
n=$(sed -n "s|^nftset=/\([^/]*\)/.*|\1|p" "$f" | sort -u)
echo ":: geoblock — автосписок ушедших из РФ сервисов ($(printf "%s\n" "$n" | grep -c .) доменов)"
echo "   обновляется кроном; тянется с itdoginfo/allow-domains"
echo ""
printf "%s\n" "$n" | grep . | awk "{printf \"%4d  %s\n\", NR, \$0}"
'
R_WATCHDOG='[ -x /usr/sbin/proxy-watchdog ] && sh /usr/sbin/proxy-watchdog; echo "✓ сторож нод отработал"'

# Твич: набор качеств решает адрес, с которого дёрнут usher.ttvnw.net.
# С российского адреса потолок 720p60, с европейского появляется 1080p60.
# Проверяем оба пути и заодно, попадает ли usher в прокси-набор.
R_TWITCH='
ch="${1:-jynxzi}"
CID=kimne78kx3ncx6brgo4mv6wki5h1ko
HASH=0828119ded1c13477966434e15800ff57ddacf13ba1911c129dc2200705b0712
echo ":: проверяю твич на канале $ch"
echo ""
echo "=== маршрут usher.ttvnw.net ==="
ips=$(nslookup usher.ttvnw.net 127.0.0.1 2>/dev/null |
        sed -n "s/^Address: *//p; s/^Address [0-9]*: *//p" |
        grep -E "^([0-9]{1,3}\.){3}[0-9]{1,3}$" | grep -v "^127\." | sort -u)
inset=0
for ip in $ips; do
  if nft get element inet fw4 proxy4 "{ $ip }" >/dev/null 2>&1; then
    echo "  ✓ $ip → через ноду"; inset=$((inset+1))
  else
    echo "  · $ip → напрямую"
  fi
done
[ -n "$ips" ] || echo "  ✗ usher.ttvnw.net не резолвится"
echo ""
tok=$(curl -s -m 20 -X POST -H "Client-ID: $CID" -H "Content-Type: application/json" \
  -d "{\"operationName\":\"PlaybackAccessToken\",\"variables\":{\"isLive\":true,\"login\":\"$ch\",\"isVod\":false,\"vodID\":\"\",\"playerType\":\"site\"},\"extensions\":{\"persistedQuery\":{\"version\":1,\"sha256Hash\":\"$HASH\"}}}" \
  https://gql.twitch.tv/gql)
sig=$(printf "%s" "$tok" | sed -n "s/.*\"signature\":\"\([^\"]*\)\".*/\1/p")
val=$(printf "%s" "$tok" | sed -n "s/.*\"value\":\"\(.*\)\",\"signature.*/\1/p" | sed "s/\\\\\"/\"/g; s/\\\\\\\\/\\\\/g")
[ -n "$sig" ] || { echo "✗ твич не отдал токен (канала $ch нет?)"; exit 0; }
echo "=== что отдаёт usher ==="
for way in прямо нода; do
  px=""; [ "$way" = нода ] && px="--socks5-hostname 127.0.0.1:1180"
  f=/tmp/rctl-tw-$way.m3u8
  code=$(curl -s -m 25 $px -o "$f" -w "%{http_code}" -G \
    --data-urlencode "token=$val" --data-urlencode "sig=$sig" \
    --data "allow_source=true&allow_audio_only=true&fast_bread=true&player_backend=mediaplayer&playlist_include_framerate=true&supported_codecs=av1,h265,h264&transcode_mode=cbr_v1" \
    "https://usher.ttvnw.net/api/channel/hls/$ch.m3u8")
  if [ "$code" != 200 ]; then
    echo "  $way: код $code (канал сейчас не в эфире?)"
    continue
  fi
  cc=$(sed -n "s/.*USER-COUNTRY=\"\([A-Z]*\)\".*/\1/p" "$f" | head -1)
  hd=$(grep -c "RESOLUTION=1920x1080" "$f")
  qs=$(grep -o "RESOLUTION=[0-9x]*" "$f" | sed "s/RESOLUTION=//" | sort -u | tr "\n" " ")
  if [ "$hd" -gt 0 ]; then echo "  $way: страна $cc, есть 1080p  [$qs]"
  else echo "  $way: страна $cc, потолок 720p  [$qs]"; fi
  rm -f "$f"
done
echo ""
if [ "$inset" -gt 0 ]; then
  echo "ИТОГ: роутер отправляет usher через ноду, 1080p должен быть."
  echo "  Если в браузере всё равно 720p, значит запрос ушёл мимо роутера:"
  echo "  выключи Secure DNS (DoH) в браузере и перезайди на стрим."
  echo "  Проверка DNS с устройства: открой http://dnscheck.lan:8080/"
  echo "  Откроется пульт, значит DNS идёт через роутер. Не откроется, значит нет."
else
  echo "ИТОГ: usher идёт напрямую, потолок останется 720p."
  echo "  Лечится: добавить usher.ttvnw.net в список сайтов через прокси."
fi
'

# telegram-cidr: MTProto ходит по IP, список статикой лежит в 20-proxy.nft (+доп.файл 21-*).
# Read-only счётчик — просто считает CIDR-подобные токены в файлах (не разбирает структуру).
R_TGCIDR_COUNT='
f=/etc/nftables.d/20-proxy.nft; e=/etc/nftables.d/21-telegram-cidr-extra.nft
[ -f "$f" ] || { echo "нет $f — статика Telegram CIDR на этом роутере не заведена этим путём"; exit 0; }
v4=$(grep -ohE "[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}" "$f" $e 2>/dev/null | sort -u | wc -l)
v6=$(grep -ohE "[0-9a-fA-F:]+:[0-9a-fA-F:]*/[0-9]{1,3}" "$f" $e 2>/dev/null | sort -u | wc -l)
extra=""; [ -f "$e" ] && extra=" (+доп.файл 21-telegram-cidr-extra.nft)"
echo "telegram CIDR: v4=$v4 v6=$v6$extra"
'
# Обновление — ТОЛЬКО аддитивное: новый список сверяется с уже применённым (base+extra),
# новые диапазоны идут отдельным доп.файлом через "add element" (nft), исходный 20-proxy.nft не трогаем.
R_TGCIDR_UPDATE='
BASE=/etc/nftables.d/20-proxy.nft
EXTRA=/etc/nftables.d/21-telegram-cidr-extra.nft
URL=https://core.telegram.org/resources/cidr.txt
TMP=/tmp/tg-cidr-live.txt
[ -f "$BASE" ] || { echo "✗ нет $BASE — тут нет базовой настройки proxy4/6, обновлять некуда"; exit 1; }
cerr=$(curl -fsSL -m 30 "$URL" -o "$TMP" 2>&1); crc=$?
if [ "$crc" != 0 ]; then
  echo "✗ скачать $URL не вышло (curl код $crc)"
  [ -n "$cerr" ] && echo "  $cerr"
  ip=$(nslookup core.telegram.org 127.0.0.1 2>/dev/null | awk "/^Address/{print \$NF}" | grep -v "#" | grep "\." | tail -1)
  if [ -n "$ip" ]; then echo "  DNS резолвит core.telegram.org -> $ip — дело не в DNS (TLS/сеть/блок на IP?)"
  else echo "  DNS НЕ резолвит core.telegram.org — см. rctl status (DoH жив?) или домен блокируется отдельно"; fi
  ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && echo "  интернет на роутере есть (1.1.1.1 пингуется)" || echo "  ! даже 1.1.1.1 не пингуется — интернета на роутере нет?"
  exit 1
fi
v4n=$({ grep -cE "^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$" "$TMP" 2>/dev/null || echo 0; } | head -1)
[ "$v4n" -ge 5 ] 2>/dev/null || { echo "✗ список подозрительно мал (v4=$v4n) — не трогаю"; exit 1; }
cur=$(cat "$BASE" "$EXTRA" 2>/dev/null)
new4=$(grep -E "^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$" "$TMP" | while IFS= read -r c; do printf "%s\n" "$cur" | grep -qF "$c" || echo "$c"; done)
new6=$(grep -E "^[0-9a-fA-F:]+/[0-9]{1,3}$" "$TMP" | while IFS= read -r c; do printf "%s\n" "$cur" | grep -qF "$c" || echo "$c"; done)
if [ -z "$new4" ] && [ -z "$new6" ]; then echo "✓ уже актуально, новых CIDR нет"; exit 0; fi
{
  echo "# rctl telegram-cidr update $(date +%F), офиц. список $URL — доп.элементы, base-файл не менялся"
  [ -n "$new4" ] && printf "add element inet fw4 proxy4 { %s }\n" "$(printf "%s\n" "$new4" | grep . | paste -sd, -)"
  [ -n "$new6" ] && printf "add element inet fw4 proxy6 { %s }\n" "$(printf "%s\n" "$new6" | grep . | paste -sd, -)"
} >> "$EXTRA"
if nft -f "$EXTRA" 2>/tmp/nft-tgcidr.err; then
