#!/bin/sh
# Подбор рабочей стратегии nfqws штатным blockcheck.sh из zapret.
#
# Запускается в фоне, состояние пишет в файлы — панель и бот их читают,
# чтобы показывать прогресс и было видно, что процесс не завис.
#
#   zapret-tune start [ДОМЕН] [УРОВЕНЬ]   уровень: quick | standard | force
#   zapret-tune status                    фаза, сколько прошло, найденное
#   zapret-tune result                    только список рабочих стратегий
#   zapret-tune stop                      прервать и вернуть zapret на место
#   zapret-tune apply "СТРАТЕГИЯ"         применить к TCP 443 с откатом
#
# ВАЖНО: blockcheck меряет честно только при остановленном zapret — он сам
# поднимает nfqws со своими параметрами. Значит на время подбора обход у всех
# в доме отключается. Скрипт всегда возвращает zapret обратно: и штатно,
# и по trap при обрыве.
set -u

BC=/opt/zapret/blockcheck.sh
CFG=/opt/zapret/config
LOG=/tmp/zapret-tune.log
STATE=/tmp/zapret-tune.state
PIDF=/tmp/zapret-tune.pid

log_state() { echo "$1" > "$STATE"; }

cmd_start() {
  dom=${1:-youtube.com}
  level=${2:-standard}
  case "$level" in quick|standard|force) : ;; *) echo "уровень: quick|standard|force"; exit 1 ;; esac
  [ -f "$BC" ] || { echo "нет $BC — zapret стоит не отсюда"; exit 1; }

  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
    echo "подбор уже идёт (pid $(cat "$PIDF"))"; exit 1
  fi

  : > "$LOG"
  log_state "start $(date +%s) $dom $level"
  echo "✓ подбор запущен: домен $dom, уровень $level"
  echo "  обход на время подбора отключён, вернётся сам"

  # сам прогон уходит в фон: blockcheck идёт минутами
  (
    trap 'log_state "aborted $(date +%s)"; /etc/init.d/zapret start >/dev/null 2>&1; rm -f "$PIDF"' INT TERM
    echo ":: останавливаю zapret — иначе его собственный десинк искажает замеры" >> "$LOG"
    /etc/init.d/zapret stop >> "$LOG" 2>&1
    sleep 1
    echo ":: запускаю blockcheck (домен $dom, уровень $level)" >> "$LOG"
    # Имена переменных — как в blockcheck.sh: IPVS (не IPV6),
    # ENABLE_HTTPS_TLS12/TLS13 (ENABLE_HTTPS такой переменной нет вообще).
    # TLS 1.3 включаем явно: ТСПУ с 2026 фильтрует его отдельно от 1.2,
    # а дефолт blockcheck — 0, то есть его бы не проверили.
    # Дефолтный CURL_MAX_TIME=2 на замедленной линии врёт: и baseline, и все
    # стратегии одинаково упираются в таймаут 2002 мс, на выходе «ничего не
    # работает». 5 секунд отделяет реально мёртвое от просто медленного.
    BATCH=1 \
    CURL_MAX_TIME="${TUNE_CURL_TIME:-5}" \
    DOMAINS="$dom" \
    SCANLEVEL="$level" \
    REPEATS=2 \
    PARALLEL=0 \
    ENABLE_HTTP=0 \
    ENABLE_HTTPS_TLS12=1 \
    ENABLE_HTTPS_TLS13=1 \
    ENABLE_HTTP3=0 \
    IPVS=4 \
    SKIP_TPWS=1 \
    sh "$BC" >> "$LOG" 2>&1
    rc=$?
    echo ":: возвращаю zapret" >> "$LOG"
    /etc/init.d/zapret start >> "$LOG" 2>&1
    log_state "done $(date +%s) rc=$rc"
    rm -f "$PIDF"
  ) &
  echo $! > "$PIDF"
}

# сколько рабочих стратегий уже найдено и на какой фазе идём
cmd_status() {
  [ -f "$STATE" ] || { echo "подбор ни разу не запускался"; exit 0; }
  set -- $(cat "$STATE")
  st=$1; ts=${2:-0}
  now=$(date +%s)
  el=$((now - ts))
  running=0
  [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null && running=1

  case "$st" in
    start) [ "$running" = 1 ] && echo "фаза: идёт подбор" || echo "фаза: оборвался (процесса нет)" ;;
    done)  echo "фаза: готово" ;;
    aborted) echo "фаза: прерван" ;;
  esac
  echo "прошло: $((el / 60)) мин $((el % 60)) с"
  [ -f "$LOG" ] || return 0
  cur=$(grep -E "^(\*|::)" "$LOG" | tail -1)
  [ -n "$cur" ] && echo "сейчас: $cur"
  # "* …" — фаза (их единицы), "- …" — конкретная проверяемая стратегия.
  # Считать надо вторые, иначе счётчик стоит на месте и кажется, что подбор завис.
  # grep -c при нуле совпадений печатает 0 И выходит с кодом 1 — без head
  # получаются две строки «0 0» в отчёте
  echo "фаз пройдено: $({ grep -c "^\* " "$LOG" 2>/dev/null || echo 0; } | head -1)"
  echo "стратегий проверено: $({ grep -c "^- " "$LOG" 2>/dev/null || echo 0; } | head -1)"
  echo "найдено рабочих: $({ cmd_result | grep -c . 2>/dev/null || echo 0; } | head -1)"
}

# рабочие стратегии из секции SUMMARY: строки вида
#   curl_test_https_tls12 ipv4 youtube.com : nfqws --dpi-desync=...
# неудачные помечены "not working" — их отбрасываем
cmd_result() {
  [ -f "$LOG" ] || return 0
  sed -n '/^\* SUMMARY/,$p' "$LOG" \
    | grep " : nfqws " \
    | grep -v "not working" \
    | sed 's/.* : nfqws //' \
    | sed 's/[[:space:]]*$//' \
    | awk '!seen[$0]++'
}

cmd_stop() {
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
    kill -TERM "$(cat "$PIDF")" 2>/dev/null
    sleep 1
    # blockcheck мог оставить свой nfqws — прибираем и поднимаем штатный
    for p in $(pidof nfqws 2>/dev/null); do kill "$p" 2>/dev/null; done
    /etc/init.d/zapret start >/dev/null 2>&1
    rm -f "$PIDF"
    log_state "aborted $(date +%s)"
    echo "✓ подбор прерван, zapret возвращён"
  else
    echo "подбор не идёт"
  fi
}

# Применяем стратегию к TCP 443 — той строке NFQWS_OPT, что отвечает за https.
# Бэкап, проверка живости, откат если стало хуже.
cmd_apply() {
  s=${1:-}
  [ -n "$s" ] || { echo "нужна строка стратегии"; exit 1; }
  case "$s" in
    *[\`\$\;\&\|]*) echo "✗ подозрительные символы в стратегии, отказ"; exit 1 ;;
  esac
  [ -f "$CFG" ] || { echo "нет $CFG"; exit 1; }

  ts=$(date +%Y%m%d-%H%M%S)
  cp "$CFG" "$CFG.bak-$ts"
  # Бэкапы конфига лежат на флеше роутера и копятся годами: свип с починкой
  # ходят по нескольку раз в сутки. Держим три последних.
  ls -t "$CFG".bak-* 2>/dev/null | tail -n +4 | while read -r old; do rm -f "$old"; done

  before=$(probe)
  echo "до применения: $before"

  # только строка внутри NFQWS_OPT: такие же строки есть в TPWS_OPT и
  # TPWS_SOCKS_OPT, а у tpws другой синтаксис — слепая замена их портит
  if ! awk -v strat="$s" '
    /^NFQWS_OPT="/ { inopt=1; print; next }
    inopt && /^"/  { inopt=0; print; next }
    inopt && /^--filter-tcp=443 / { print "--filter-tcp=443 " strat " <HOSTLIST> --new"; done=1; next }
    { print }
    END { if (!done) exit 3 }
  ' "$CFG.bak-$ts" > /tmp/zapret-config.new; then
    echo "✗ не нашёл строку --filter-tcp=443 внутри NFQWS_OPT — не трогаю"
    rm -f /tmp/zapret-config.new "$CFG.bak-$ts"
    exit 1
  fi

  cp /tmp/zapret-config.new "$CFG"
  /etc/init.d/zapret restart >/dev/null 2>&1
  sleep 3

  if ! pidof nfqws >/dev/null 2>&1; then
    echo "✗ zapret не поднялся — откатываю"
    cp "$CFG.bak-$ts" "$CFG"; /etc/init.d/zapret restart >/dev/null 2>&1
    exit 1
  fi

  after=$(probe)
  echo "после применения: $after"
  if [ "${after%% *}" -ge "${before%% *}" ] 2>/dev/null; then
    echo "✓ применено (бэкап: $CFG.bak-$ts)"
  else
    echo "✗ стало хуже — откатываю"
    cp "$CFG.bak-$ts" "$CFG"; /etc/init.d/zapret restart >/dev/null 2>&1
    echo "  вернул как было"
    exit 1
  fi
}

# Проба «стало лучше или хуже». Скорость страницы плеера тут не годится:
# страницу отдают всегда, при любой стратегии, — по ней все варианты выглядели
# одинаково, и откат срабатывал случайно. Режут именно узлы googlevideo, по
# ним и меряем; скорость страницы оставлена доводчиком между равными.
CDN_HOSTS=${TUNE_CDN_HOSTS:-"rr1---sn-4g5e6nzz rr2---sn-4g5ednse rr3---sn-4g5edned rr4---sn-4g5e6nz7 redirector"}

probe() {
  live=0; total=0
  for h in $CDN_HOSTS; do
    total=$((total + 1))
    c=$(curl -4 -o /dev/null -sS -m 6 -w '%{http_code}' \
          "https://$h.googlevideo.com/generate_204" 2>/dev/null) || c=000
    case "$c" in 200|204) live=$((live + 1)) ;; esac
  done
  r=$(curl -sS -m 25 -o /dev/null -w "%{speed_download} %{http_code}" \
        "https://www.youtube.com/watch?v=aqz-KE-bpKQ" 2>/dev/null) || r="0 000"
  set -- $r
  kb=$(( ${1%%.*} / 1024 ))
  echo "$((live * 1000 + kb)) — $live/$total узлов CDN, $kb КБ/с (код $2)"
}

case "${1:-status}" in
  start)  shift; cmd_start "$@" ;;
  status) cmd_status ;;
  result) cmd_result ;;
  stop)   cmd_stop ;;
  apply)  shift; cmd_apply "$@" ;;
  log)    tail -40 "$LOG" 2>/dev/null || echo "лога нет" ;;
  *) echo "zapret-tune start [домен] [quick|standard|force] | status | result | apply СТРАТЕГИЯ | stop | log" ;;
esac
