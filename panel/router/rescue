#!/bin/sh
# Аварийный канал: забрать новую подписку из условленного места.
#
# Задача одна и узкая. Сказать роутеру новую ссылку можно только через бота, а
# бот ходит в телеграм через прокси — значит, когда прокси мёртв (подписка
# кончилась, ноды отвалились), сказать нечего и некому. Замкнутый круг.
#
# Круг разрывается тем, что роутер САМ дотягивается напрямую, мимо прокси, и до
# обычных сайтов, и до сервера подписки — проверено. Поэтому он раз в четверть
# часа заглядывает в заранее оговорённое место и, если там лежит новая ссылка,
# применяет её сам. Ни телеграма, ни прокси для этого не нужно.
#
# Настройки: /etc/rescue.conf
#   RESCUE_URL=https://…      где лежит записка (адрес знает только хозяин)
#   RESCUE_SECRET=…           общее слово; без него записка не принимается
#
# Формат записки — две строки:
#   <ссылка подписки>
#   <кодовое слово>
#
# Кодовое слово обязательно: адрес записки может стать известен, и без слова
# любой прохожий подменил бы ноды роутера на свои. Слово лежит только на
# роутере и в голове хозяина, в записке его сверяют, а не берут.

CONF=/etc/rescue.conf
LOG=/var/log/rescue.log
STAMP=/etc/rescue.last
NETPULT=/usr/sbin/netpult

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

[ -f "$CONF" ] || exit 0
# shellcheck disable=SC1090
. "$CONF"
[ -n "${RESCUE_URL:-}" ] && [ -n "${RESCUE_SECRET:-}" ] || exit 0

# --noproxy: записку берём в обход всего своего хозяйства. Смысл канала в том,
# что он работает, когда прокси не работает.
body=$(curl -fsS --noproxy '*' --connect-timeout 10 --max-time 25 "$RESCUE_URL" 2>/dev/null) || {
  log "записка не читается — оставляю как есть"
  exit 0
}

url=$(printf '%s\n' "$body" | sed -n '1p' | tr -d ' \r')
word=$(printf '%s\n' "$body" | sed -n '2p' | tr -d ' \r')

case "$url" in
  https://*) : ;;
  *) log "в записке нет ссылки — пропускаю"; exit 0 ;;
esac

if [ "$word" != "$RESCUE_SECRET" ]; then
  # Про причину в журнал пишем скупо: сам секрет туда попасть не должен.
  log "кодовое слово не сошлось — записку не принимаю"
  exit 0
fi

# Ту же ссылку второй раз не применяем: иначе каждые пятнадцать минут роутер
# перезапускал бы ядро на ровном месте.
if [ -f "$STAMP" ] && [ "$(cat "$STAMP")" = "$(printf '%s' "$url" | md5sum | cut -c1-32)" ]; then
  exit 0
fi

log ":: в записке новая ссылка — применяю"
out=$(HOME=/root "$NETPULT" vpn sub "$url" 2>&1)
if [ $? != 0 ]; then
  log "!! подписка не принята: $(printf '%s' "$out" | grep -v 'https://' | tail -2)"
  exit 1
fi
log "   нод разобрано: $(printf '%s' "$out" | sed -n 's/.*Разобрано нод: \([0-9]*\).*/\1/p' | head -1)"

# Дальше обычный путь с проверкой конфига самим sing-box и откатом, если после
# перезапуска наружу не достучаться. Хуже вчерашнего конфига не станет.
out2=$(HOME=/root "$NETPULT" vpn sync 2>&1)
printf '%s\n' "$out2" | sed 's/\x1b\[[0-9;]*m//g' | grep -v 'https://' | while IFS= read -r line; do
  [ -n "$line" ] && log "   $line"
done

printf '%s' "$url" | md5sum | cut -c1-32 > "$STAMP"
chmod 600 "$STAMP"
log ":: готово"

# Журнал не должен расти без края.
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 65536 ]; then
  tail -n 200 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi
