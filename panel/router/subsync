#!/bin/sh
# Ночное обновление нод из подписки.
#
# Сам разбор и слияние делает netpult: он забирает подписку, подменяет в
# конфиге sing-box только ноды, проверяет результат самим sing-box и
# откатывается, если после перезапуска наружу не достучаться. Здесь остаётся
# журнал и уборка старых бэкапов, чтобы overlay не заплыл.

LOG=/var/log/subsync.log
KEEP=5
# Отметка последнего удачного обновления живёт на флеше: после перезагрузки
# роутера она должна пережить чистку /tmp, иначе протухание не отследить.
STAMP=/etc/subsync.stamp
TOLD=/tmp/subsync.told
QUEUE=/tmp/notify.queue
# Через сколько молчания подписки начинать беспокоить хозяина.
MAXAGE=${SUBSYNC_MAXAGE:-604800}

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG"; }

# Сказать хозяину. Прямой путь до телеграма с роутера закрыт по адресу, поэтому
# кладём в общую очередь — её разбирает proxy-watchdog первым здоровым заходом.
# Не чаще раза в сутки: беда тут длится неделями, и незачем повторять её каждую
# ночь.
tell() {
  now=$(date +%s); last=$(cat "$TOLD" 2>/dev/null || echo 0)
  [ $((now - last)) -gt 86400 ] || return 0
  printf '%s %s\n' "$(date '+%d.%m %H:%M') —" "$1" >> "$QUEUE"
  echo "$now" > "$TOLD"
}

log ":: обновляю ноды из подписки"
out=$(HOME=/root /usr/sbin/netpult vpn sync 2>&1)
code=$?
echo "$out" | sed 's/\x1b\[[0-9;]*m//g' | while IFS= read -r line; do
  [ -n "$line" ] && log "   $line"
done

if [ "$code" = 0 ]; then
  log ":: готово"
  date +%s > "$STAMP"
else
  log "!! не вышло (код $code) — конфиг остался прежним"
  # Молчание подписки — самый тихий из способов остаться без интернета. Ноды в
  # конфиге живут, пока провайдер не сменит им uuid при очередной ротации, и
  # тогда умирают все разом. Между «подписка не отвечает» и «ничего не
  # работает» проходят недели, и всё это время видно только строчку в журнале,
  # который никто не читает.
  now=$(date +%s); had=$(cat "$STAMP" 2>/dev/null || echo 0)
  if [ "$had" = 0 ]; then
    tell "Подписка не обновляется (код $code), и удачных обновлений ещё не было. Ноды живут на том, что есть в конфиге."
  else
    age=$(( (now - had) / 86400 ))
    if [ $((now - had)) -gt "$MAXAGE" ]; then
      tell "Подписка не обновляется уже $age сут. Ноды в конфиге доживут до ближайшей ротации ключей, потом лягут все разом. Проверь: netctl sub / rctl."
    fi
  fi
fi

# Бэкапы копятся по одному на запуск: держим последние несколько.
ls -1t /etc/sing-box/config.json.bak-1* 2>/dev/null | tail -n +$((KEEP + 1)) | while IFS= read -r old; do
  rm -f "$old"
  log "   убрал старый бэкап $(basename "$old")"
done

# Журнал тоже не должен расти без края.
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 131072 ]; then
  tail -n 300 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi

exit "$code"
