#!/bin/sh
# ytwatch — непрерывный дневник ютуба.
#
# «Работал, потом завис» разовыми проверками не ловится: когда прибегаешь
# смотреть, уже опять работает. Поэтому раз в несколько минут снимаем три
# показателя и складываем в журнал с временем:
#
#   cdn   — TLS до хоста googlevideo (тот же SNI, что у видео): жив ли путь
#   page  — скорость страницы плеера, ~1 МБ, грубый показатель душилова
#   video — скорость реального куска видео (если Дек подлил свежий адрес,
#           см. ytwatch url); это единственный честный замер видео-потока
#
# Команды:
#   ytwatch sample        один замер, дописать в журнал
#   ytwatch log [N]       последние N строк как таблица для панели
#   ytwatch url ФАЙЛ|-    принять свежий googlevideo-адрес (из ytfeed на Деке)
#   ytwatch stat          сводка: сколько замеров, сколько плохих, когда
#   ytwatch heal          если душилово держится — сам пересобирает стратегию
set -u

LOG=/tmp/ytwatch.log
URLF=/tmp/ytwatch.url
PAGE=${YTWATCH_PAGE:-https://www.youtube.com/watch?v=aqz-KE-bpKQ}
# ниже этого считаем, что поток душат (КБ/с)
SLOW_KB=${YTWATCH_SLOW_KB:-150}
KEEP=${YTWATCH_KEEP:-400}

# Одного хоста CDN мало. googlevideo.com — это сотни узлов, и DNS отдаёт то
# франкфуртский адрес (443 режут наглухо), то финский (проходит). Проверка по
# одному имени поэтому давала рваный журнал — то 204, то 000 — без всякой
# связи с тем, идёт видео или нет, и самолечение на таком шуме не срабатывало.
# Берём несколько имён сразу: доля пробившихся — устойчивый показатель.
CDN_HOSTS=${YTWATCH_CDN_HOSTS:-"rr1---sn-4g5e6nzz rr2---sn-4g5ednse rr3---sn-4g5edned rr4---sn-4g5e6nz7 redirector"}
# ниже этой доли живых узлов считаем путь до видео перекрытым (в процентах)
CDN_MIN=${YTWATCH_CDN_MIN:-60}

kbps() { echo $(( ${1%%.*} / 1024 )); }

# Список выше — угаданные имена, и это его слабое место: краевой узел выдаётся
# под сеть и под сессию, у другого провайдера половина этих имён не отвечает
# никогда. Поэтому, если Дек подлил свежий адрес видео (ytwatch url), берём имя
# прямо из него: это ровно тот узел, с которого шло бы видео здесь и сейчас.
cdn_hosts() {
  h=""
  if [ -f "$URLF" ]; then
    h=$(sed -n 's#^https\{0,1\}://\([^/]*\)\.googlevideo\.com/.*#\1#p' "$URLF" | head -1)
  fi
  if [ -n "$h" ]; then
    printf '%s\n' "$h"
    for x in $CDN_HOSTS; do [ "$x" = "$h" ] || printf '%s\n' "$x"; done | head -4
  else
    printf '%s\n' $CDN_HOSTS
  fi
}

# Печатает «живых всего мс». Трафика почти нет: только TLS-рукопожатие и
# пустой ответ 204 на каждый узел.
cdn_probe() {
  live=0; total=0; ms=0
  for h in $(cdn_hosts); do
    total=$((total + 1))
    r=$(curl -4 -o /dev/null -sS -m 6 -w '%{http_code} %{time_total}' \
          "https://$h.googlevideo.com/generate_204" 2>/dev/null) || r="000 6"
    set -- $r
    case "$1" in
      200|204)
        live=$((live + 1))
        [ "$ms" = 0 ] && ms=$(awk -v x="$2" 'BEGIN{printf "%d", x*1000}')
        ;;
    esac
  done
  echo "$live $total $ms"
}

# $1 = light: только хендшейк до CDN. Полный замер качает мегабайты, и в
# кроне раз в 10 минут это под гигабайт в сутки чужого трафика — поэтому
# часто ходим налегке, а тяжёлый замер делаем раз в пару часов.
cmd_sample() {
  light=${1:-}
  ts=$(date +%s)

  # 1. путь до видео: рукопожатие до нескольких узлов CDN, трафика почти нет
  set -- $(cdn_probe)
  cdn_live=$1; cdn_total=$2; cdn_ms=$3
  [ "$cdn_live" -gt 0 ] && cdn_code=204 || cdn_code=000

  if [ "$light" = light ]; then
    echo "$ts $cdn_code $cdn_ms - -1 - -1 $cdn_live/$cdn_total" >> "$LOG"
    tail -"$KEEP" "$LOG" > "$LOG.trim" 2>/dev/null && mv "$LOG.trim" "$LOG"
    cmd_log 1
    return 0
  fi

  # 2. страница плеера: идёт тем же путём, что и видео
  r=$(curl -sS -o /dev/null -m 40 -w '%{http_code} %{speed_download}' "$PAGE" 2>/dev/null) || r="000 0"
  set -- $r
  page_code=$1; page_kb=$(kbps "$2")

  # 3. настоящий кусок видео — только если адрес свежий (googlevideo даёт
  #    ссылке несколько часов, потом 403; протухшую молча не мерим)
  vid_kb=-1; vid_code="-"
  if [ -f "$URLF" ]; then
    u=$(cat "$URLF")
    exp=$(printf '%s' "$u" | sed -n 's/.*[?&]expire=\([0-9]*\).*/\1/p')
    if [ -n "$exp" ] && [ "$exp" -gt "$ts" ] 2>/dev/null; then
      r=$(curl -L -sS -o /dev/null -m 45 -w '%{http_code} %{speed_download}' "$u&range=0-6291455" 2>/dev/null) || r="000 0"
      set -- $r
      vid_code=$1; vid_kb=$(kbps "$2")
    fi
  fi

  echo "$ts $cdn_code $cdn_ms $page_code $page_kb $vid_code $vid_kb $cdn_live/$cdn_total" >> "$LOG"
  # журнал живёт в tmpfs, не даём ему расти бесконечно
  tail -"$KEEP" "$LOG" > "$LOG.trim" 2>/dev/null && mv "$LOG.trim" "$LOG"

  cmd_log 1
}

verdict() { # $1 cdn_code $2 page_kb $3 vid_kb $4 живых/всего (может не быть)
  if [ "$1" != 204 ] && [ "$1" != 200 ]; then echo "путь до CDN лёг"; return; fi
  # Частичная доступность — это и есть нынешнее блокирование: часть узлов
  # googlevideo отвечает, часть режут по адресу. Плеер выбирает узел сам, и
  # попадание на перекрытый выглядит как «видео зависло на ровном месте».
  case "${4:-}" in
    */*)
      l=${4%%/*}; t=${4##*/}
      if [ "$t" -gt 0 ] 2>/dev/null && [ $((l * 100 / t)) -lt "$CDN_MIN" ]; then
        echo "CDN режут ($4)"; return
      fi
      ;;
  esac
  if [ "$2" = "-1" ] && [ "$3" = "-1" ]; then echo "путь жив (лёгкая проверка)"; return; fi
  if [ "$3" -ge 0 ] 2>/dev/null; then
    [ "$3" -lt "$SLOW_KB" ] && { echo "видео душат"; return; }
    echo "норма"; return
  fi
  [ "$2" -lt "$SLOW_KB" ] 2>/dev/null && { echo "страница еле тянет"; return; }
  echo "норма"
}

cmd_log() {
  n=${1:-24}
  [ -f "$LOG" ] || { echo "замеров ещё не было"; return 0; }
  echo "tbl|время|узлы CDN|страница|видео|итог"
  tail -"$n" "$LOG" | while read -r ts cc cms pc pkb vc vkb cdn; do
    t=$(date -d "@$ts" '+%d.%m %H:%M' 2>/dev/null || date -r "$ts" '+%d.%m %H:%M' 2>/dev/null || echo "$ts")
    [ "$vkb" -ge 0 ] 2>/dev/null && v="$vkb КБ/с" || v="—"
    [ "$pkb" -ge 0 ] 2>/dev/null && p="$pkb КБ/с" || p="—"
    # строки, записанные до перехода на несколько узлов, поля «живых» не имеют
    [ -n "${cdn:-}" ] && c="$cdn живых / $cms мс" || c="$cc / $cms мс"
    echo "tbl|$t|$c|$p|$v|$(verdict "$cc" "$pkb" "$vkb" "${cdn:-}")"
  done
}

cmd_url() {
  f=${1:-}
  [ -n "$f" ] || { echo "ytwatch url ФАЙЛ | -"; exit 1; }
  if [ "$f" = "-" ]; then cat > "$URLF"; else cp "$f" "$URLF"; fi
  u=$(cat "$URLF")
  case "$u" in
    https://*googlevideo.com/*) : ;;
    *) rm -f "$URLF"; echo "✗ это не googlevideo-адрес"; exit 1 ;;
  esac
  exp=$(printf '%s' "$u" | sed -n 's/.*[?&]expire=\([0-9]*\).*/\1/p')
  if [ -n "$exp" ]; then
    left=$(( exp - $(date +%s) ))
    echo "✓ адрес принят, годен ещё $((left / 3600)) ч $(((left % 3600) / 60)) мин"
  else
    echo "✓ адрес принят (срок годности в нём не указан)"
  fi
}

cmd_stat() {
  [ -f "$LOG" ] || { echo "замеров ещё не было"; return 0; }
  total=$(wc -l < "$LOG")
  bad=$(awk -v s="$SLOW_KB" '($2!=204 && $2!=200) || ($7>=0 && $7<s) || ($7<0 && $5>=0 && $5<s)' "$LOG" | wc -l)
  echo ":: замеров: $total, плохих: $bad"
  [ "$bad" -gt 0 ] && {
    echo ""
    echo "последние плохие:"
    awk -v s="$SLOW_KB" '($2!=204 && $2!=200) || ($7>=0 && $7<s) || ($7<0 && $5>=0 && $5<s) {print $1}' "$LOG" |
      tail -5 | while read -r ts; do
        echo "  $(date -d "@$ts" '+%d.%m %H:%M' 2>/dev/null || echo "$ts")"
      done
  }
  echo ""
  echo "средняя скорость страницы: $(awk '$5>=0{s+=$5; n++} END{if(n) printf "%d", s/n}' "$LOG") КБ/с"
  v=$(awk '$7>=0{s+=$7; n++} END{if(n) printf "%d", s/n}' "$LOG")
  [ -n "$v" ] && echo "средняя скорость видео:    $v КБ/с" ||
    echo "видео ни разу не мерили — подлей адрес с Дека (tools/ytfeed.sh)"
}

# Самолечение: если журнал подряд показывает душилово, стратегия перестала
# пробивать (ТСПУ их периодически переучивают). Тогда сами запускаем свип —
# он гоняет кандидатов на живом обходе и оставляет самого быстрого.
# Ноду не трогаем: видео идёт мимо неё.
HEAL_STAMP=/tmp/ytwatch.heal
TUNE_STAMP=/tmp/ytwatch.tune
# blockcheck гасит обход всему дому, поэтому у него свой, более редкий срок
TUNE_COOLDOWN=${YTWATCH_TUNE_COOLDOWN:-43200}
HEAL_WINDOW=${YTWATCH_HEAL_WINDOW:-12}   # сколько последних замеров смотрим
HEAL_AFTER=${YTWATCH_HEAL_AFTER:-5}      # плохих в этом окне — повод лечить
HEAL_COOLDOWN=${YTWATCH_HEAL_COOLDOWN:-21600}   # не чаще раза в 6 часов
HEAL_HOUR_FROM=${YTWATCH_HEAL_HOUR_FROM:-3}     # окно, когда можно гасить обход
HEAL_HOUR_TO=${YTWATCH_HEAL_HOUR_TO:-7}
# Подбирать стратегию надо под то, что реально режут. youtube.com открывается
# всегда, поэтому blockcheck по нему находил «рабочими» полсотни стратегий,
# ни одна из которых не чинила видео.
HEAL_DOMAIN=${YTWATCH_HEAL_DOMAIN:-rr1---sn-4g5e6nzz.googlevideo.com}

cmd_heal() {
  [ -f "$LOG" ] || { echo "замеров ещё не было"; return 0; }

  # Раньше считался ХВОСТ подряд идущих плохих замеров — и не срабатывало
  # никогда: перекрыта часть узлов CDN, а не все, так что журнал чередует
  # плохое с хорошим и счётчик обнуляется на каждом удачном замере. Считаем
  # долю плохих в окне последних замеров — рваная картина как раз и есть
  # признак болезни, а не здоровья.
  bad=$(awk -v s="$SLOW_KB" -v w="$HEAL_WINDOW" -v cmin="$CDN_MIN" '
    { line[++n] = row() }
    function row(   l, t) {
      if ($2 != 204 && $2 != 200) return 1                # путь до CDN лёг
      if ($8 ~ /\//) {                                    # доля живых узлов
        split($8, a, "/"); l = a[1]; t = a[2]
        if (t > 0 && l * 100 / t < cmin) return 1
      }
      if ($5 == "-1" && $7 == "-1") return 0              # лёгкая проверка
      if ($7 >= 0) return ($7 < s) ? 1 : 0                # честный кусок видео
      return ($5 >= 0 && $5 < s) ? 1 : 0                  # иначе страница
    }
    END { c = 0; for (i = n; i >= 1 && i > n - w; i--) c += line[i]; print c }
  ' "$LOG")

  if [ "${bad:-0}" -lt "$HEAL_AFTER" ]; then
    echo ":: плохих замеров: ${bad:-0} из последних $HEAL_WINDOW (лечим от $HEAL_AFTER) — лечить нечего"
    return 0
  fi

  now=$(date +%s)
  last=$(cat "$HEAL_STAMP" 2>/dev/null || echo 0)
  if [ $((now - last)) -lt "$HEAL_COOLDOWN" ]; then
    echo ":: душилово держится ($bad из $HEAL_WINDOW), но свип уже гоняли $(( (now - last) / 60 )) мин назад — жду"
    return 0
  fi

  echo ":: плохих $bad из последних $HEAL_WINDOW — разбираюсь"

  # Связи может не быть вовсе: WAN отвалился, провайдер лёг, роутер только что
  # загрузился. Тогда узлы CDN «мертвы» совсем по другой причине, и подбор
  # стратегии только зря погасит обход и сожжёт полчаса.
  c=$(curl -s -o /dev/null -m 8 -w '%{http_code}' https://www.gstatic.com/generate_204 2>/dev/null)
  case "$c" in
    2??|3??) : ;;
    *) echo ":: наружу не отвечает и gstatic (код ${c:-000}) — это не про стратегию, жду связь"; return 0 ;;
  esac

  # Свежие кандидаты есть только после blockcheck. Но blockcheck на время
  # работы гасит zapret — у всех в доме отваливается обход на несколько
  # минут. Днём это делать нельзя, поэтому ждём тихого часа. Исключение:
  # если не отвечает НИ ОДИН узел CDN, обход и так уже ничего не даёт,
  # и терять нечего.
  if ! /usr/sbin/zapret-tune result 2>/dev/null | grep -q .; then
    tlast=$(cat "$TUNE_STAMP" 2>/dev/null || echo 0)
    if [ $((now - tlast)) -lt "$TUNE_COOLDOWN" ]; then
      echo ":: blockcheck гоняли $(( (now - tlast) / 3600 )) ч назад и кандидатов он не дал — жду"
      return 0
    fi
    h=$(date +%H)
    dead=$(tail -1 "$LOG" | awk '{split($8,a,"/"); print (a[1]=="0") ? 1 : 0}')
    if [ "${dead:-0}" != 1 ] && { [ "$h" -lt "$HEAL_HOUR_FROM" ] || [ "$h" -ge "$HEAL_HOUR_TO" ]; }; then
      echo ":: кандидатов нет, а blockcheck гасит обход — жду тихого часа ($HEAL_HOUR_FROM:00-$HEAL_HOUR_TO:00)"
      return 0
    fi
    echo ":: кандидатов нет, запускаю blockcheck (обход на это время отключится)"
    echo "$now" > "$TUNE_STAMP"
    /usr/sbin/zapret-tune start "$HEAL_DOMAIN" quick
    # Кандидаты появятся минут через десять-двадцать. Кулдаун свипа тут НЕ
    # ставим: иначе найденные стратегии полдня лежат неприменёнными — так уже
    # было, blockcheck отрабатывал ночью, а свип ждал шести часов впустую.
    return 0
  fi

  # Свип не гасит обход: гоняет кандидатов на живом zapret и оставляет
  # лучшего — его можно и днём.
  echo "$now" > "$HEAL_STAMP"
  /usr/sbin/zapret-sweep start 8
}

case "${1:-sample}" in
  heal)   cmd_heal ;;
  sample) shift 2>/dev/null; cmd_sample "${1:-}" ;;
  log)    shift; cmd_log "${1:-24}" ;;
  url)    shift; cmd_url "${1:--}" ;;
  stat)   cmd_stat ;;
  *) echo "ytwatch sample [light]|log [N]|url ФАЙЛ|stat|heal"; exit 1 ;;
esac
