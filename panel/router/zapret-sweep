#!/bin/sh
# zapret-sweep — выбор стратегии по скорости, а не по «открылось/не открылось».
#
# Зачем отдельно от zapret-tune: blockcheck отвечает только «доступно/недоступно».
# На душилове ТСПУ страница открывается всегда, поэтому blockcheck честно
# выдаёт полсотни «рабочих» стратегий, из которых видео тянет одна-две.
# Свип гонит кандидатов по очереди на живом zapret и меряет реальную скорость
# на странице плеера (~1 МБ, тот же путь, что и видео).
#
#   zapret-sweep start [N]   прогнать N кандидатов (по умолчанию 12)
#   zapret-sweep status      прогресс
#   zapret-sweep result      таблица «скорость — стратегия»
#   zapret-sweep stop        прервать и вернуть исходный конфиг
#
# Конфиг всегда возвращается: и штатно, и по trap при обрыве.
set -u

CFG=/opt/zapret/config
OUT=/tmp/zapret-sweep.out
STATE=/tmp/zapret-sweep.state
PIDF=/tmp/zapret-sweep.pid
ORIG=/tmp/zapret-sweep.orig
VIDEO=${SWEEP_URL:-https://www.youtube.com/watch?v=aqz-KE-bpKQ}

# Кандидаты: берём из результата blockcheck, но прореживаем по семействам —
# двадцать вариантов одного fooling меряют одно и то же и жрут время.
candidates() {
  /usr/sbin/zapret-tune result 2>/dev/null |
    sed 's/[[:space:]]*$//' |
    awk '!seen[$0]++' |
    awk '{
      fam=""
      for (i=1;i<=NF;i++) if ($i ~ /^--dpi-desync=/) fam=$i
      key=fam
      for (i=1;i<=NF;i++) if ($i ~ /^--dpi-desync-(split-pos|fooling|autottl)=/) key=key" "$i
      if (!(key in seenkey)) { seenkey[key]=1; print }
    }'
}

# Узлы CDN для проверки доступности видео-пути. Скорость страницы плеера
# сама по себе ничего не решает: страницу отдают всегда, поэтому по ней все
# кандидаты выглядели одинаково хорошо и свип каждый раз оставлял прежнюю
# стратегию. Режут именно googlevideo, по нему и меряем.
CDN_HOSTS=${SWEEP_CDN_HOSTS:-"rr1---sn-4g5e6nzz rr2---sn-4g5ednse rr3---sn-4g5edned rr4---sn-4g5e6nz7 redirector"}

# Сколько узлов CDN пробилось. Это главный показатель: стратегия либо
# проходит фильтр, либо нет.
cdn_live() {
  live=0; total=0
  for h in $CDN_HOSTS; do
    total=$((total + 1))
    c=$(curl -4 -o /dev/null -sS -m 6 -w '%{http_code}' \
          "https://$h.googlevideo.com/generate_204" 2>/dev/null) || c=000
    case "$c" in 200|204) live=$((live + 1)) ;; esac
  done
  echo "$live $total"
}

# Одна проба: «очки живых_из_всех КБ/с код». Очки = узлы*1000 + КБ/с, чтобы
# доступность решала, а скорость страницы служила только доводчиком между
# кандидатами, пробившими одинаковое число узлов.
speed() {
  set -- $(cdn_live)
  live=$1; total=$2
  r=$(curl -sS -m 40 -o /tmp/sweep.page -w '%{http_code} %{speed_download}' "$VIDEO" 2>/dev/null) || r="000 0"
  set -- $r
  code=$1
  [ "$code" = 200 ] && kb=$(( ${2%%.*} / 1024 )) || kb=0
  echo "$((live * 1000 + kb)) $live/$total $kb $code"
}

# Меняем строку 443 ТОЛЬКО внутри NFQWS_OPT. Строки с тем же началом есть
# ещё в TPWS_OPT и TPWS_SOCKS_OPT — у tpws другой синтаксис, и слепая замена
# по всему файлу их портит (ловил на живом конфиге).
apply_strategy() {
  awk -v strat="$1" '
    /^NFQWS_OPT="/ { inopt=1; print; next }
    inopt && /^"/  { inopt=0; print; next }
    inopt && /^--filter-tcp=443 / { print "--filter-tcp=443 " strat " <HOSTLIST> --new"; done=1; next }
    { print }
    END { if (!done) exit 3 }
  ' "$ORIG" > /tmp/sweep-config.new || return 1
  cp /tmp/sweep-config.new "$CFG"
  /etc/init.d/zapret restart >/dev/null 2>&1
  sleep 4
  pidof nfqws >/dev/null 2>&1
}

restore() {
  [ -f "$ORIG" ] && cp "$ORIG" "$CFG"
  /etc/init.d/zapret restart >/dev/null 2>&1
}

cmd_start() {
  n=${1:-12}
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
    echo "свип уже идёт (pid $(cat "$PIDF"))"; exit 1
  fi
  cp "$CFG" "$ORIG"
  cp "$CFG" "$CFG.bak-sweep-$(date +%Y%m%d-%H%M%S)"
  # Бэкапы конфига лежат на флеше роутера и копятся годами: свип с починкой
  # ходят по нескольку раз в сутки. Держим три последних.
  ls -t "$CFG".bak-* 2>/dev/null | tail -n +4 | while read -r old; do rm -f "$old"; done
  : > "$OUT"
  echo "start $(date +%s) $n" > "$STATE"

  cands=$(candidates | head -"$n")
  [ -n "$cands" ] || { echo "нет кандидатов — сначала прогони подбор (zapret-tune start)"; exit 1; }

  echo "✓ свип запущен: $(echo "$cands" | wc -l) кандидатов, ~50 с на каждого"
  echo "  обход остаётся включённым, меняется только стратегия TCP 443"

  (
    trap 'restore; echo "aborted $(date +%s)" > "$STATE"; rm -f "$PIDF"' INT TERM

    # базовая точка: текущая стратегия, чтобы было с чем сравнивать
    echo "base $(speed) (текущая стратегия)" >> "$OUT"

    echo "$cands" | while read -r s; do
      [ -n "$s" ] || continue
      if apply_strategy "$s"; then
        set -- $(speed)
        sc=$1; nodes=$2; kb=$3; code=$4
        # вторая проба: линия флапает, одиночный замер врёт
        set -- $(speed)
        [ "$1" -gt "$sc" ] 2>/dev/null && { sc=$1; nodes=$2; kb=$3; code=$4; }
        echo "cand $sc $nodes $kb $code $s" >> "$OUT"
      else
        echo "cand 0 0/0 0 cfg $s" >> "$OUT"
      fi
    done

    # победитель: максимум очков среди кандидатов
    best=$(grep '^cand ' "$OUT" | sort -k2 -nr | head -1)
    bkb=$(echo "$best" | awk '{print $2}')
    basekb=$(grep '^base ' "$OUT" | awk '{print $2}')
    bstrat=$(echo "$best" | cut -d' ' -f6-)

    if [ -n "$bkb" ] && [ "$bkb" -gt "$basekb" ] 2>/dev/null; then
      apply_strategy "$bstrat" || restore
      echo "winner $bkb $bstrat" >> "$OUT"
      echo "done $(date +%s) applied" > "$STATE"
    else
      restore
      echo "winner - текущая стратегия не хуже кандидатов" >> "$OUT"
      echo "done $(date +%s) kept" > "$STATE"
    fi
    rm -f "$PIDF" /tmp/sweep.page
  ) &
  echo $! > "$PIDF"
}

cmd_status() {
  [ -f "$STATE" ] || { echo "свип ни разу не запускался"; exit 0; }
  set -- $(cat "$STATE")
  st=$1; ts=${2:-0}; tail3=${3:-}
  # в строке start третье поле — сколько кандидатов, в done — что сделали
  # grep -c при нуле совпадений печатает 0 И выходит 1 — без head выйдут две строки
  case "$st" in start) total=$tail3 ;; *) total=$({ grep -c '^cand ' "$OUT" 2>/dev/null || echo '?'; } | head -1) ;; esac
  el=$(( $(date +%s) - ts ))
  running=0
  [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null && running=1
  case "$st" in
    start) [ "$running" = 1 ] && echo "фаза: идёт свип" || echo "фаза: оборвался (процесса нет)" ;;
    done)  echo "фаза: готово ($(case "$tail3" in applied) echo "стратегия заменена" ;; kept) echo "оставил прежнюю" ;; *) echo "$tail3" ;; esac))" ;;
    aborted) echo "фаза: прерван" ;;
  esac
  echo "прошло: $((el / 60)) мин $((el % 60)) с"
  echo "проверено кандидатов: $({ grep -c '^cand ' "$OUT" 2>/dev/null || echo 0; } | head -1) из $total"
  b=$(grep '^base ' "$OUT" 2>/dev/null | awk '{print $3" узлов, "$4" КБ/с"}')
  [ -n "$b" ] && echo "было: $b"
  best=$(grep '^cand ' "$OUT" 2>/dev/null | sort -k2 -nr | head -1 | awk '{print $3" узлов, "$4" КБ/с"}')
  [ -n "$best" ] && echo "лучшее пока: $best"
  w=$(grep '^winner ' "$OUT" 2>/dev/null)
  [ -n "$w" ] && echo "итог: $(echo "$w" | cut -d' ' -f2-)"
}

cmd_result() {
  [ -f "$OUT" ] || { echo "результатов нет"; exit 0; }
  b=$(grep '^base ' "$OUT" | awk '{print $3" узлов CDN, "$4" КБ/с"}')
  echo "было: ${b:-?}"
  echo ""
  # "tbl|" — панель нарисует настоящую таблицу (см. свод в svcprobe scorelog)
  echo "tbl|узлы CDN|скорость|код|стратегия"
  grep '^cand ' "$OUT" | sort -k2 -nr |
    while read -r _ _ nodes kb code strat; do
      echo "tbl|$nodes|$kb КБ/с|$code|$strat"
    done
  w=$(grep '^winner ' "$OUT")
  [ -n "$w" ] && { echo ""; echo "итог: $(echo "$w" | cut -d' ' -f2-)"; }
}

cmd_stop() {
  if [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF" 2>/dev/null)" 2>/dev/null; then
    kill -TERM "$(cat "$PIDF")" 2>/dev/null
    sleep 1
    restore
    rm -f "$PIDF"
    echo "aborted $(date +%s)" > "$STATE"
    echo "✓ свип прерван, конфиг возвращён"
  else
    echo "свип не идёт"
  fi
}

case "${1:-status}" in
  start)  shift; cmd_start "$@" ;;
  status) cmd_status ;;
  result) cmd_result ;;
  stop)   cmd_stop ;;
  *) echo "zapret-sweep start [N] | status | result | stop"; exit 1 ;;
esac
