#!/bin/sh
# rudns-guard — следит, что российские зоны вообще резолвятся.
#
# Зачем отдельный сторож. РФ-зоны ходят через свой https-dns-proxy
# (127.0.0.1:5055 → https://77.88.8.8/dns-query): открытый 53 с августа 2026
# перехватывает ТСПУ и отвечает вместо того, кого спросили. Но у шифрованного
# канала появилась цена. Пока он был открытым UDP, умирать там было нечему —
# а теперь падение одного процесса уносит с собой весь .ru: банки, госуслуги,
# vk. Снаружи это выглядит как «интернет есть, а сбербанк не открывается», и
# ищется долго.
#
# Состояние канала спрашиваем у самого резолвера на 5055, а не у dnsmasq.
# Обычно правило обратное — проверять надо ту дорогу, по которой идёт трафик, —
# но здесь на этой дороге стоит кеш dnsmasq с чужими TTL: у sberbank.ru он
# больше получаса. Мёртвый канал столько бы прятался за кешем, и сторож всё
# это время рапортовал бы «всё хорошо». Поэтому канал меряется напрямую, а
# реальный путь через dnsmasq проверяется после лечения — как подтверждение
# того, что дом действительно снова резолвит.
#
# Лечение по шагам: сперва перезапуск https-dns-proxy, и только если не помог —
# откат на открытый 53. Откат хуже по достоверности, но рабочий DNS важнее
# шифрованного: без него у хозяина просто не открываются банки. Откат помечен
# штампом, и как только DoH оживает, сторож возвращает шифрованный канал сам —
# иначе роутер молча остался бы на открытом 53 навсегда, и «починка» вышла бы
# такой же пустой, как диагноз без действия.
set -u

# Пути и порт берутся из окружения, чтобы сторожа можно было прогнать вхолостую
# на копии конфига. Иначе единственный способ проверить лечение — сломать живой
# DNS всему дому, а сторож, чью починку никто не видел работающей, ничем не
# лучше отсутствующего.
SPLITD=${SPLITD:-/etc/dnsmasq.d/split-ru.conf}
DRYRUN=${RUDNS_DRYRUN:-0}
RU_DOH_PORT=${RU_DOH_PORT:-5055}
RU_DNS=${RU_DNS:-77.88.8.8}
# Штамп отката живёт на флеше, а не в /tmp. В /tmp он не пережил бы
# перезагрузку: конфиг с открытым 53 остаётся на месте, штамп исчезает, и
# сторож при следующем заходе считает открытый 53 выбором хозяина. РФ-зоны
# тогда навсегда остаются на пути, где отвечает ТСПУ, и никто об этом не
# узнает — откат без возврата хуже, чем отсутствие отката.
FALLBACK=${FALLBACK:-/etc/rudns.fallback}
TELL_STAMP=${TELL_STAMP:-/tmp/rudns.tell}
QUEUE=${QUEUE:-/tmp/notify.queue}
LOCK=${LOCK:-/tmp/rudns-guard.lock}
NAMES="www.vtb.ru sberbank.ru gosuslugi.ru"

[ -f "$SPLITD" ] || exit 0

# Замок: перезапуск dnsmasq занимает секунды, а крон приходит каждые пять
# минут — два одновременных отката переписали бы файл друг под другом.
if [ -f "$LOCK" ] && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; then exit 0; fi
echo $$ > "$LOCK"
trap 'rm -f "$LOCK"' EXIT INT TERM

log() { logger -t rudns-guard "$1"; }

# Сообщение хозяину. Прямой путь до телеграма с этого роутера закрыт по
# адресу, поэтому просто кладём в общую очередь — её разбирает proxy-watchdog
# на ближайшем здоровом заходе. Не чаще раза в час, чтобы не спамить.
tell() {
  now=$(date +%s); last=$(cat "$TELL_STAMP" 2>/dev/null || echo 0)
  [ $((now - last)) -gt 3600 ] || return 0
  printf '%s %s\n' "$(date '+%d.%m %H:%M') —" "$1" >> "$QUEUE"
  echo "$now" > "$TELL_STAMP"
}

# Адрес РФ-имени так, как его увидит любой клиент в доме.
ip_of() {
  nslookup "$1" "${2:-127.0.0.1}" 2>/dev/null |
    awk '/^Address/{print $NF}' | grep -v '#' | grep '\.' | tail -1
}

# Резолвит ли шифрованный канал. Спрашиваем его в обход dnsmasq: у того свой
# кеш с чужими TTL, и мёртвый канал прятался бы за ним до получаса.
# https-dns-proxy своего кеша не держит, так что каждый такой запрос — честный
# поход по HTTPS. Двух имён хватает: у отдельного сайта бывает свой сбой, а нам
# важен канал, а не конкретный банк.
channel_ok() {
  for n in $NAMES; do
    [ -n "$(ip_of "$n" "127.0.0.1:$RU_DOH_PORT")" ] && return 0
  done
  return 1
}

# Резолвится ли РФ-имя так, как его увидит любой клиент в доме. Этим
# подтверждаем результат лечения: канал каналом, а дому важен весь путь.
path_ok() {
  for n in $NAMES; do
    [ -n "$(ip_of "$n")" ] && return 0
  done
  return 1
}

on_doh() { grep -q "^server=/.*/127\.0\.0\.1#$RU_DOH_PORT$" "$SPLITD"; }

restart_dnsmasq() {
  [ "$DRYRUN" = 1 ] && { log "холостой ход: dnsmasq не трогаю"; return 0; }
  /etc/init.d/dnsmasq restart >/dev/null 2>&1
  sleep 3
}

restart_doh() {
  [ "$DRYRUN" = 1 ] && { log "холостой ход: https-dns-proxy не трогаю"; return 0; }
  /etc/init.d/https-dns-proxy restart >/dev/null 2>&1
  sleep 5
}

# Пишем через временный файл РЯДОМ с целью и mv, а не cp из /tmp. cp
# обрезает файл и льёт содержимое частями: пропадёт питание в этот миг — на
# флеше останется обрубок, dnsmasq с битым include не стартует, и весь дом
# остаётся без DNS вообще. mv в пределах одной файловой системы атомарен:
# либо старый файл, либо новый, промежутка нет.
# Временный файл — с точки в начале имени. dnsmasq читает conf-dir целиком,
# без фильтра по расширению: любой файл, оставшийся тут после обрыва, станет
# живым куском конфига. Имена с точки dnsmasq пропускает, поэтому обрубок
# после отключения питания просто полежит мусором, а не подцепится upstream'ом.
TMPD=$(dirname "$SPLITD")/.$(basename "$SPLITD").tmp

put() { # put -> заменить $SPLITD подготовленным TMPD
  mv "$TMPD" "$SPLITD"
}

to_plain() {
  sed "s|^server=/\(.*\)/127\.0\.0\.1#$RU_DOH_PORT\$|server=/\1/$RU_DNS|" "$SPLITD" > "$TMPD" &&
    put
  restart_dnsmasq
}

to_doh() {
  sed "s|^server=/\(.*\)/77\.88\.8\.[0-9]*\$|server=/\1/127.0.0.1#$RU_DOH_PORT|" "$SPLITD" |
    awk '/^server=/ { if (seen[$0]++) next } { print }' > "$TMPD" &&
    put
  restart_dnsmasq
}

if on_doh; then
  channel_ok && exit 0

  log "шифрованный резолвер РФ-зон молчит — перезапускаю https-dns-proxy"
  restart_doh
  if channel_ok; then
    log "помог перезапуск https-dns-proxy"
    tell "РФ-зоны переставали резолвиться, помог перезапуск шифрованного резолвера. Сейчас работают."
    exit 0
  fi

  log "перезапуск не помог — возвращаю РФ-зоны на открытый 53"
  to_plain
  touch "$FALLBACK"
  if path_ok; then
    log "откат сработал: РФ-зоны на открытом 53"
    tell "Шифрованный резолвер РФ-зон ($RU_DNS по DoH) не поднимается. Вернул их на открытый 53 — банки работают, но ответы на этом пути подменяет ТСПУ. Верну обратно сам, как только канал оживёт."
  else
    log "РФ-имена не резолвятся ни через DoH, ни напрямую"
    tell "РФ-зоны не резолвятся ни через DoH, ни через открытый 53. Похоже, дело не в резолвере — смотри logread -e dnsmasq."
  fi
  exit 0
fi

# Мы на открытом 53. Либо так и задумано хозяином, либо это наш откат —
# второе видно по штампу, и только его мы пытаемся отыграть назад.
[ -f "$FALLBACK" ] || exit 0
channel_ok || exit 0

log "шифрованный резолвер ожил — возвращаю РФ-зоны на него"
to_doh
if path_ok; then
  rm -f "$FALLBACK"
  log "РФ-зоны снова на шифрованном канале"
  tell "Шифрованный резолвер РФ-зон ожил — вернул их обратно на него."
else
  log "вернуть не вышло — остаюсь на открытом 53"
  to_plain
fi
