#!/bin/sh
# Telegram-бот к роутеру. Живёт на самом роутере, только исходящие соединения —
# ни портов наружу, ни пробросов. В API ходит через локальный SOCKS sing-box,
# потому что api.telegram.org с роутера напрямую не открывается.
#
# Настройки: /etc/rctl-bot.conf
#   BOT_TOKEN=123456:AA...      токен от @BotFather
#   BOT_ALLOW="11111 22222"     владельцы (полный доступ)
#   BOT_PROXY=127.0.0.1:1180    локальный SOCKS sing-box
#   BOT_DEBUG=1                 писать сырые ответы API в лог
#
# Доступ семьи: /etc/rctl-bot.acl, строки вида "123456:family:Мама".
# Незнакомец пишет боту — владельцу прилетает запрос с кнопками.
#
# Оформление: Bot API 10.1 sendRichMessage — markdown с настоящими таблицами.
# Если rich не прошёл, сообщение уходит обычным sendMessage в HTML.
set -u

CONF=/etc/rctl-bot.conf
ACL=/etc/rctl-bot.acl
[ -f "$CONF" ] || { echo "нет $CONF"; exit 1; }
# shellcheck disable=SC1090
. "$CONF"

RCTL=/usr/sbin/rctl
TUNE=/usr/sbin/zapret-tune
NETPULT=/usr/sbin/netpult
export RCTL_LOCAL=1
BOT_PROXY="${BOT_PROXY:-127.0.0.1:1180}"
BOT_ALLOW="${BOT_ALLOW:-}"
OFFSET_FILE=/tmp/rctl-bot.offset
API="https://api.telegram.org/bot$BOT_TOKEN"
KB='{"keyboard":[["Статус","Починить"],["Ютуб","Серверы"]],"resize_keyboard":true}'

log() { logger -t rctl-bot "$*"; }

tg() { m=$1; shift; curl -s --max-time 70 --socks5-hostname "$BOT_PROXY" "$API/$m" "$@"; }

# ---------- отправка ----------------------------------------------------------

# текст -> строковый литерал JSON (без кавычек по краям)
json_esc() {
  sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' \
  | awk 'BEGIN{ORS=""} {if (NR>1) printf "\\n"; print}'
}

esc_html() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# Красивый ответ: markdown с таблицами через sendRichMessage.
# Возвращает message_id (или пусто).
# Сообщения одного типа не копятся: новое стирает предыдущее того же типа.
# id последнего храним в файле на чат и тип.
send_typed() { # send_typed CHAT ТИП MARKDOWN [KEYBOARD]
  f="/tmp/rctl-bot.msg.$1.$2"
  old=$(cat "$f" 2>/dev/null)
  id=$(rich "$1" "$3" "${4:-}")
  # сначала шлём новое, потом убираем старое — чтобы чат не мигал пустотой
  [ -n "$old" ] && tg deleteMessage -o /dev/null \
      --data-urlencode "chat_id=$1" --data-urlencode "message_id=$old"
  [ -n "$id" ] && echo "$id" > "$f"
}

rich() { # rich CHAT MARKDOWN [KEYBOARD] -> печатает message_id
  body="{\"markdown\":\"$(printf '%s' "$2" | json_esc)\"}"
  # клавиатуру передаём файлом: в её JSON есть пробелы, а подстановка
  # аргументов через ${3:+...} порвала бы строку на куски
  if [ -n "${3:-}" ]; then
    printf '%s' "$3" > /tmp/rctl-bot.kbd
    r=$(tg sendRichMessage \
          --data-urlencode "chat_id=$1" \
          --data-urlencode "rich_message=$body" \
          --data-urlencode "reply_markup@/tmp/rctl-bot.kbd")
  else
    r=$(tg sendRichMessage \
          --data-urlencode "chat_id=$1" \
          --data-urlencode "rich_message=$body")
  fi
  case "$r" in
    *'"ok":true'*)
      printf '%s' "$r" | sed -n 's/.*"message_id":\([0-9]*\).*/\1/p' | head -1
      return 0 ;;
  esac
  log "rich не прошёл: $(printf '%s' "$r" | head -c 160) — падаю на HTML"
  send_html "$1" "$(printf '%s' "$2" | esc_html)" "${3:-}"
}

send_html() { # send_html CHAT HTML [KEYBOARD]
  printf '%s' "$2" | head -c 3800 > /tmp/rctl-bot.msg
  r=$(tg sendMessage \
        --data-urlencode "chat_id=$1" \
        --data-urlencode "text@/tmp/rctl-bot.msg" \
        --data-urlencode "parse_mode=HTML" \
        --data-urlencode "reply_markup=${3:-$KB}")
  rm -f /tmp/rctl-bot.msg
  printf '%s' "$r" | sed -n 's/.*"message_id":\([0-9]*\).*/\1/p' | head -1
}

edit_html() { # edit_html CHAT MSGID HTML
  printf '%s' "$3" | head -c 3800 > /tmp/rctl-bot.edit
  tg editMessageText -o /dev/null \
    --data-urlencode "chat_id=$1" \
    --data-urlencode "message_id=$2" \
    --data-urlencode "text@/tmp/rctl-bot.edit" \
    --data-urlencode "parse_mode=HTML"
  rm -f /tmp/rctl-bot.edit
}

answer() { tg answerCallbackQuery -o /dev/null --data-urlencode "callback_query_id=$1" --data-urlencode "text=${2:-}"; }

# Telegram отдаёт кириллицу как \uXXXX, busybox printf %b такое не разворачивает
unesc() {
  awk '{
    s=$0; out="";
    while (match(s, /\\u[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]/)) {
      out = out substr(s, 1, RSTART-1);
      h = tolower(substr(s, RSTART+2, 4));
      c = 0;
      for (i = 1; i <= 4; i++) c = c * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1;
      if (c < 128)       out = out sprintf("%c", c);
      else if (c < 2048) out = out sprintf("%c%c", 192 + int(c/64), 128 + (c%64));
      else               out = out sprintf("%c%c%c", 224 + int(c/4096), 128 + int(c/64)%64, 128 + (c%64));
      s = substr(s, RSTART + RLENGTH);
    }
    print out s;
  }'
}

# ---------- доступ ------------------------------------------------------------

# owner — всё; family — только безопасное; пусто — чужой
role_of() {
  for c in $BOT_ALLOW; do [ "$c" = "$1" ] && { echo owner; return; }; done
  [ -f "$ACL" ] || return
  awk -F: -v id="$1" '$1 == id { print $2; exit }' "$ACL"
}

acl_add() { # acl_add ID РОЛЬ ИМЯ
  touch "$ACL"; chmod 600 "$ACL"
  acl_del "$1"
  printf '%s:%s:%s\n' "$1" "$2" "$3" >> "$ACL"
}
acl_del() {
  [ -f "$ACL" ] || return 0
  grep -v "^$1:" "$ACL" > "$ACL.tmp" 2>/dev/null; mv "$ACL.tmp" "$ACL"; chmod 600 "$ACL"
}

owners() { echo "$BOT_ALLOW"; }

# ---------- вывод -------------------------------------------------------------

md_status() {
  s=$($RCTL status 2>&1)
  mark() { printf '%s' "$s" | grep -q "^$1 ●" && echo "🟢 работает" || echo "🔴 лежит"; }
  node=$(printf '%s' "$s" | sed -n 's/^активная нода: \(.*\)$/\1/p')
  dom=$(printf '%s' "$s" | sed -n 's/^проксируемых доменов (uci): \(.*\)$/\1/p')
  geo=$(printf '%s' "$s" | sed -n 's/^geoblock: \([0-9]*\).*/\1/p')
  quic=$(printf '%s' "$s" | grep -q "QUIC-блок: включён" && echo "включён" || echo "выключен")
  down=$(printf '%s' "$s" | grep -c "✗ stopped")
  [ "$down" = 0 ] && head="## 🟢 Всё работает" || head="## 🔴 Что-то лежит"

  cat <<EOF
$head

| служба | состояние |
|---|---|
| прокси | $(mark sing-box) |
| zapret | $(mark zapret) |
| DNS | $(mark DoH) |
| dnsmasq | $(mark dnsmasq) |

**Сервер:** \`${node:-неизвестен}\` · **QUIC:** $quic
**Домены:** ${dom:-0} своих + ${geo:-0} geoblock
EOF
}

