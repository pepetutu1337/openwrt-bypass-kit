  chat=$1; role=$2; text=$3; msgid=${4:-}
  case "$text" in
    /start|/help|help|Помощь)
      [ "$role" = owner ] && send_typed "$chat" help "$HELP_OWNER" || send_typed "$chat" help "$HELP_FAMILY" ;;
    /status|Статус|статус)  send_typed "$chat" status "$(md_status)" ;;
    /fix|Починить|починить)  with_progress "$chat" fix "Починка" $RCTL fix ;;
    /yt|/yttest|Ютуб|ютуб)   with_progress "$chat" yt "Тест ютуба" $RCTL yttest ;;
    /nodes|Серверы|серверы)
      m=$(md_nodes)
      send_typed "$chat" nodes "$m" "$(cat /tmp/rctl-bot.kb 2>/dev/null)" ;;
    /best|Лучший)  with_progress "$chat" node "Выбор быстрейшего" $RCTL nodes best ;;
    /auto)         with_progress "$chat" node "Автовыбор" $RCTL nodes auto ;;
    /use\ *)
      n=${text#/use }
      if echo "$n" | grep -qE '^[A-Za-z0-9._-]{1,64}$'; then
        with_progress "$chat" node "Смена сервера" $RCTL nodes use "$n"
      else
        rich "$chat" "Кривое имя сервера." >/dev/null
      fi ;;

    # --- дальше только владелец ---
    /subupd|/subupdate)
      if [ "$role" = owner ]; then
        with_progress "$chat" sub "Обновление подписки" $NETPULT vpn sync
      else rich "$chat" "Это только для хозяина роутера." >/dev/null; fi ;;
    /sub\ *)
      if [ "$role" != owner ]; then rich "$chat" "Это только для хозяина роутера." >/dev/null; return; fi
      url=${text#/sub }
      # Ссылка подписки — это ключ. Сообщение с ней убираем из чата сразу,
      # ещё до работы: чтобы оно не осталось в переписке и в облаке телеграма.
      [ -n "$msgid" ] && tg deleteMessage -o /dev/null \
          --data-urlencode "chat_id=$chat" --data-urlencode "message_id=$msgid"
      case "$url" in
        https://*)
          # Никакого eval: ссылка уходит отдельным аргументом. Проверяем только
          # набор знаков, чтобы в аргумент не заехали пробелы и кавычки.
          if echo "$url" | grep -qE '^https://[A-Za-z0-9._~:/?#@!$&*+,;=%()-]{8,600}$'; then
            sub_apply "$chat" "$url"
          else
            rich "$chat" "В ссылке посторонние знаки — пришли её целиком, одной строкой." >/dev/null
          fi ;;
        *) rich "$chat" "Нужна ссылка на подписку, начинается с https://" >/dev/null ;;
      esac ;;
    /logs)  [ "$role" = owner ] && with_progress "$chat" logs "Лог прокси" $RCTL logs sing-box || rich "$chat" "Это только для хозяина роутера." >/dev/null ;;
    /info)  [ "$role" = owner ] && with_progress "$chat" info "Система" $RCTL info || rich "$chat" "Это только для хозяина роутера." >/dev/null ;;
    /family)
      [ "$role" = owner ] && send_typed "$chat" family "$(md_family)" || rich "$chat" "Это только для хозяина роутера." >/dev/null ;;
    /kick\ *)
      if [ "$role" = owner ]; then
        id=${text#/kick }
        if echo "$id" | grep -qE '^-?[0-9]+$'; then acl_del "$id"; rich "$chat" "Доступ у \`$id\` отобран." >/dev/null
        else rich "$chat" "Нужен числовой id." >/dev/null; fi
      else rich "$chat" "Это только для хозяина роутера." >/dev/null; fi ;;
    /tune|/tune\ *)
      if [ "$role" != owner ]; then rich "$chat" "Это только для хозяина роутера." >/dev/null; return; fi
      lvl=${text#/tune}; lvl=${lvl# }
      case "$lvl" in
        quick|standard|force) tune_start "$chat" "$lvl" ;;
        stop) send_typed "$chat" tune "$(md_block 'Подбор' "$($TUNE stop 2>&1)")" ;;
        status) send_typed "$chat" tune "$(md_block 'Подбор' "$($TUNE status 2>&1)")" ;;
        *)
          rich "$chat" "## Подбор стратегии zapret

Гоняет штатный \`blockcheck\` и ищет параметры обхода, которые сейчас пробивают блокировку.

**Важно:** на время подбора обход отключается — blockcheck поднимает собственный nfqws. У всех дома интернет будет как без обхода. Вернётся само.

| уровень | сколько ждать |
|---|---|
| быстрый | пара минут, берёт первое рабочее |
| обычный | 5–15 минут, ищет получше |
| полный | долго, перебирает всё |" \
          '{"inline_keyboard":[[{"text":"⚡ Быстрый","callback_data":"tunelvl:quick"},{"text":"⚖ Обычный","callback_data":"tunelvl:standard"}],[{"text":"🐢 Полный","callback_data":"tunelvl:force"}]]}' ;;
      esac ;;
    *) rich "$chat" "Не понял. Кнопки внизу или /help" >/dev/null ;;
  esac
}

handle_cb() { # handle_cb CHAT РОЛЬ CBID DATA
  chat=$1; role=$2; cbid=$3; data=$4
  case "$data" in
    use:*)
      n=${data#use:}
      if echo "$n" | grep -qE '^[A-Za-z0-9._-]{1,64}$'; then
        answer "$cbid" "переключаю на $n…"
        with_progress "$chat" node "Сервер → $n" $RCTL nodes use "$n"
      else answer "$cbid" "кривое имя"; fi ;;
    act:best) answer "$cbid" "меряю…"; with_progress "$chat" node "Выбор быстрейшего" $RCTL nodes best ;;
    act:auto) answer "$cbid" "переключаю…"; with_progress "$chat" node "Автовыбор" $RCTL nodes auto ;;
    tunelvl:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      answer "$cbid" "запускаю подбор"
      tune_start "$chat" "${data#tunelvl:}" ;;
    tune:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      n=${data#tune:}
      s=$(sed -n "${n}p" /tmp/rctl-bot.tune 2>/dev/null)
      if [ -n "$s" ]; then
        answer "$cbid" "применяю…"
        with_progress "$chat" tuneres "Применение стратегии" $TUNE apply "$s"
      else answer "$cbid" "стратегия потерялась, запусти подбор заново"; fi ;;
    grant:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      id=${data#grant:}
      nm=$(cat "/tmp/rctl-bot.pending.$id" 2>/dev/null || echo "без имени")
      acl_add "$id" family "$nm"
      rm -f "/tmp/rctl-bot.pending.$id"
      answer "$cbid" "пустил"
      rich "$chat" "\`$id\` ($nm) теперь может пользоваться ботом." >/dev/null
      send_typed "$id" help "$HELP_FAMILY" ;;
    deny:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      id=${data#deny:}
      rm -f "/tmp/rctl-bot.pending.$id"
      answer "$cbid" "отказал" ;;
    *) answer "$cbid" "неизвестная кнопка" ;;
  esac
}

# чужак постучался — спрашиваем владельца
ask_owner() { # ask_owner ID ИМЯ ТЕКСТ
  echo "$2" > "/tmp/rctl-bot.pending.$1"
  for o in $(owners); do
    rich "$o" "## Стучится незнакомец

**Имя:** $2
**id:** \`$1\`
**Написал:** $3

Пустить — получит статус, починку, тест ютуба и выбор сервера. Настройки и стратегии останутся только тебе." \
      "{\"inline_keyboard\":[[{\"text\":\"✅ Пустить\",\"callback_data\":\"grant:$1\"},{\"text\":\"⛔ Отказать\",\"callback_data\":\"deny:$1\"}]]}"
  done
}

# ---------- основной цикл -----------------------------------------------------

# отладочный режим: rctl-bot selftest CHAT_ID — шлёт пример оформления и выходит,
# не поднимая основной цикл (иначе будет драка за getUpdates со службой)
case "${1:-}" in
  selftest)
    [ -n "${2:-}" ] || { echo "rctl-bot selftest CHAT_ID"; exit 1; }
    send_typed "$2" status "$(md_status)" && echo "статус отправлен"
    m=$(md_nodes)
    send_typed "$2" nodes "$m" "$(cat /tmp/rctl-bot.kb 2>/dev/null)" && echo "серверы отправлены"
    exit 0 ;;
esac

log "старт (proxy $BOT_PROXY)"
offset=$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)

if [ "$offset" = 0 ]; then
  r=$(tg getUpdates --data-urlencode "offset=-1" --data-urlencode "timeout=0")
  last=$(printf '%s' "$r" | tr -d '\n\r' | sed -n 's/.*"update_id":\([0-9]*\).*/\1/p' | tail -1)
  [ -n "$last" ] && offset=$((last + 1))
fi

while :; do
  r=$(tg getUpdates --data-urlencode "offset=$offset" --data-urlencode "timeout=50" \
        --data-urlencode 'allowed_updates=["message","callback_query"]')
  if [ -z "$r" ]; then sleep 5; continue; fi
  case "$r" in
    *'"ok":true'*) : ;;
    *) log "API ответил не ок: $(printf '%s' "$r" | head -c 200)"; sleep 15; continue ;;
  esac

  [ "${BOT_DEBUG:-0}" = 1 ] && log "сырой ответ: $(printf '%s' "$r" | tr -d '\n' | head -c 300)"

  # ответ приходит с переносами строк внутри объектов — склеиваем в одну строку,
  # иначе разбиение по update_id даёт огрызки
  printf '%s' "$r" | tr -d '\n\r' | sed 's/{"update_id":/\
&/g' | grep '"update_id"' | while IFS= read -r u; do
    uid=$(printf '%s' "$u" | sed -n 's/.*"update_id":\([0-9]*\).*/\1/p')
    [ -n "$uid" ] || continue
    echo $((uid + 1)) > "$OFFSET_FILE"
    chat=$(printf '%s' "$u" | sed -n 's/.*"chat":{"id":\(-\{0,1\}[0-9]*\).*/\1/p')
    [ -n "$chat" ] || continue
    role=$(role_of "$chat")

    case "$u" in
      *'"callback_query"'*)
        cbid=$(printf '%s' "$u" | sed -n 's/.*"callback_query":{"id":"\([^"]*\)".*/\1/p')
        data=$(printf '%s' "$u" | sed -n 's/.*"data":"\([^"]*\)".*/\1/p' | unesc)
        [ -n "$cbid" ] && [ -n "$data" ] || { log "пропущен callback $uid"; continue; }
        if [ -n "$role" ]; then
          log "кнопка от $chat ($role): $data"
          handle_cb "$chat" "$role" "$cbid" "$data"
        else
          answer "$cbid" "нет доступа"
        fi ;;
      *)
        text=$(printf '%s' "$u" | sed -n 's/.*"text":"\([^"]*\)".*/\1/p' | unesc)
        if [ -z "$text" ]; then
          log "пропущен апдейт $uid: $(printf '%s' "$u" | head -c 200)"
          continue
        fi
        mid=$(printf '%s' "$u" | sed -n 's/.*"message":{"message_id":\([0-9]*\).*/\1/p')
        if [ -n "$role" ]; then
          # Ссылка подписки — ключ, в системном журнале ей не место.
          case "$text" in
            /sub\ *) log "команда от $chat ($role): /sub <ссылка скрыта>" ;;
            *)       log "команда от $chat ($role): $text" ;;
          esac
          handle "$chat" "$role" "$text" "$mid"
        else
          name=$(printf '%s' "$u" | sed -n 's/.*"from":{"id":[0-9]*,"is_bot":[a-z]*,"first_name":"\([^"]*\)".*/\1/p' | unesc)
          log "чужой чат $chat ($name): $text"
          if [ -f "/tmp/rctl-bot.pending.$chat" ]; then
            send_html "$chat" "Запрос уже отправлен хозяину роутера, подожди."
          else
            ask_owner "$chat" "${name:-без имени}" "$text"
            send_html "$chat" "Спросил хозяина роутера — если пустит, бот сам напишет."
          fi
        fi ;;
    esac
  done
  no=$(cat "$OFFSET_FILE" 2>/dev/null || echo "$offset")
  [ "$no" -gt "$offset" ] 2>/dev/null && offset=$no
done
