#!/bin/sh
# Telegram-бот к роутеру. Живёт на самом роутере, только исходящие соединения —
# ни портов наружу, ни пробросов. Ходит в API через локальный SOCKS sing-box,
# потому что api.telegram.org с роутера напрямую не открывается.
#
# Настройки: /etc/rctl-bot.conf
#   BOT_TOKEN=123456:AA...      токен от @BotFather
#   BOT_ALLOW="11111 22222"     chat_id, кому можно (через пробел)
#   BOT_PROXY=127.0.0.1:1180    локальный SOCKS sing-box
#   BOT_DEBUG=1                 писать сырые ответы API в лог
#
# Кто не в BOT_ALLOW — команд не выполняет. Если список пуст, бот просто
# сообщает свой chat_id, чтобы было что вписать в конфиг.
#
# Оформление: parse_mode=HTML. Таблиц в Telegram нет ни в каком виде, поэтому
# всё табличное идёт моноширинным блоком <pre> с выровненными колонками.
set -u

CONF=/etc/rctl-bot.conf
[ -f "$CONF" ] || { echo "нет $CONF"; exit 1; }
# shellcheck disable=SC1090
. "$CONF"

RCTL=/usr/sbin/rctl
export RCTL_LOCAL=1
BOT_PROXY="${BOT_PROXY:-127.0.0.1:1180}"
BOT_ALLOW="${BOT_ALLOW:-}"
OFFSET_FILE=/tmp/rctl-bot.offset
API="https://api.telegram.org/bot$BOT_TOKEN"
KB='{"keyboard":[["Статус","Починить"],["Ютуб","Серверы"]],"resize_keyboard":true}'

log() { logger -t rctl-bot "$*"; }

tg() { # tg МЕТОД [curl-args…]
  m=$1; shift
  curl -s --max-time 70 --socks5-hostname "$BOT_PROXY" "$API/$m" "$@"
}

# < > & ломают HTML-разметку Telegram
esc() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

send() { # send CHAT ТЕКСТ [РАЗМЕТКА-КНОПОК]
  printf '%s' "$2" | head -c 3800 > /tmp/rctl-bot.msg
  tg sendMessage -o /dev/null \
    --data-urlencode "chat_id=$1" \
    --data-urlencode "text@/tmp/rctl-bot.msg" \
    --data-urlencode "parse_mode=HTML" \
    --data-urlencode "reply_markup=${3:-$KB}" \
  || log "не отправилось в $1"
  rm -f /tmp/rctl-bot.msg
}

# всплывашка на нажатие инлайн-кнопки, чтобы часики в клиенте не крутились
answer() { tg answerCallbackQuery -o /dev/null --data-urlencode "callback_query_id=$1" --data-urlencode "text=${2:-}"; }

# Telegram отдаёт кириллицу как \uXXXX, а busybox printf %b такое не понимает.
# Разворачиваем сами: hex -> codepoint -> байты UTF-8.
unesc() {
  awk '{
    s=$0; out="";
    while (match(s, /\\u[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]/)) {
      out = out substr(s, 1, RSTART-1);
      h = tolower(substr(s, RSTART+2, 4));
      c = 0;
      for (i = 1; i <= 4; i++) c = c * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1;
      if (c < 128)       out = out sprintf("%c", c);
      else if (c < 2048) out = out sprintf("%c%c", 192 + int(c/64), 128 + (c%64));
      else               out = out sprintf("%c%c%c", 224 + int(c/4096), 128 + int(c/64)%64, 128 + (c%64));
      s = substr(s, RSTART + RLENGTH);
    }
    print out s;
  }'
}

allowed() {
  [ -n "$BOT_ALLOW" ] || return 1
  for c in $BOT_ALLOW; do [ "$c" = "$1" ] && return 0; done
  return 1
}

# ---------- красивые ответы ---------------------------------------------------

fmt_status() {
  s=$($RCTL status 2>&1)
  ok() { printf '%s' "$s" | grep -q "^$1 ●" && echo "✅" || echo "❌"; }
  node=$(printf '%s' "$s" | sed -n 's/^активная нода: \(.*\)$/\1/p')
  dom=$(printf '%s' "$s" | sed -n 's/^проксируемых доменов (uci): \(.*\)$/\1/p')
  geo=$(printf '%s' "$s" | sed -n 's/^geoblock: \([0-9]*\).*/\1/p')
  quic=$(printf '%s' "$s" | grep -q "QUIC-блок: включён" && echo "включён" || echo "выключен")
  down=$(printf '%s' "$s" | grep -c "✗ stopped")

  if [ "$down" = 0 ]; then head="🟢 <b>Всё работает</b>"; else head="🔴 <b>Что-то лежит</b>"; fi

  printf '%s\n\n' "$head"
  printf '<pre>%s\n' "служба      состояние"
  printf '%s\n' "прокси      $(ok sing-box)"
  printf '%s\n' "zapret      $(ok zapret)"
  printf '%s\n' "DNS         $(ok DoH)"
  printf '%s\n' "dnsmasq     $(ok dnsmasq)"
  printf '</pre>\n'
  printf 'Сервер: <b>%s</b>\n' "${node:-неизвестен}"
  printf 'Домены: <code>%s</code> своих + <code>%s</code> geoblock\n' "${dom:-0}" "${geo:-0}"
  printf 'QUIC: %s\n' "$quic"
}

# Таблица серверов + инлайн-кнопки выбора. Кнопки только для живых.
fmt_nodes() { # печатает текст; JSON кнопок кладёт в /tmp/rctl-bot.kb
  n=$($RCTL nodes list 2>&1)
  printf '%s' "$n" | awk '
    /^(=>|  )[[:space:]]*[A-Za-z0-9._-]+[[:space:]]/ {
      act = ($1 == "=>");
      name = act ? $2 : $1;
      ms = act ? $3 : $2;
      if (ms == "-") { dead[++d] = name; next }
      alive[++a] = name; pings[a] = ms + 0;
    }
    END {
      print "<b>Серверы обхода</b>";
      print "";
      # printf выравнивает по байтам, а кириллица двухбайтовая — поэтому шапку
      # доводим пробелами вручную, иначе колонка уезжает
      print "<pre>сервер       пинг";
      # сортировка пузырьком: список короткий, зато без зависимостей
      for (i = 1; i <= a; i++) for (j = i+1; j <= a; j++)
        if (pings[j] < pings[i]) {
          t = pings[i]; pings[i] = pings[j]; pings[j] = t;
          t = alive[i]; alive[i] = alive[j]; alive[j] = t;
        }
      for (i = 1; i <= a; i++) printf "%-12s %4d мс\n", alive[i], pings[i];
      print "</pre>";
      if (d > 0) {
        printf "Молчат (%d): <i>", d;
        for (i = 1; i <= d; i++) printf "%s%s", dead[i], (i < d ? ", " : "");
        print "</i>";
      }
      print "";
      print "Кнопкой ниже — закрепить сервер.";

      # клавиатура: по три кнопки в ряд, в порядке возрастания пинга
      kb = "{\"inline_keyboard\":[";
      row = ""; rows = ""; cnt = 0;
      for (i = 1; i <= a; i++) {
        b = "{\"text\":\"" alive[i] " · " pings[i] "\",\"callback_data\":\"use:" alive[i] "\"}";
        row = row (cnt % 3 == 0 ? "" : ",") b;
        cnt++;
        if (cnt % 3 == 0) { rows = rows (rows == "" ? "" : ",") "[" row "]"; row = "" }
      }
      if (row != "") rows = rows (rows == "" ? "" : ",") "[" row "]";
      extra = "[{\"text\":\"⚡ Самый быстрый\",\"callback_data\":\"act:best\"},{\"text\":\"🎲 Автовыбор\",\"callback_data\":\"act:auto\"}]";
      rows = rows (rows == "" ? "" : ",") extra;
      kb = kb rows "]}";
      print kb > "/tmp/rctl-bot.kb";
    }'
}

fmt_plain() { # заголовок + вывод команды моноширинно
  printf '<b>%s</b>\n\n<pre>%s</pre>\n' "$1" "$(printf '%s' "$2" | esc)"
}

HELP='<b>Пульт к роутеру</b>

<b>Статус</b> — что работает прямо сейчас
<b>Починить</b> — поднять упавшее, уйти с мёртвого сервера
<b>Ютуб</b> — почему не идёт видео
<b>Серверы</b> — таблица с пингом и кнопки выбора

Ещё: /use ИМЯ, /best, /auto, /logs, /info'

handle() { # handle CHAT ТЕКСТ
  chat=$1; text=$2
  case "$text" in
    /start|/help|help|Помощь)  send "$chat" "$HELP" ;;
    /status|Статус|статус)     send "$chat" "$(fmt_status)" ;;
    /fix|Починить|починить)    send "$chat" "$(fmt_plain 'Починка' "$($RCTL fix 2>&1)")" ;;
    /yt|/yttest|Ютуб|ютуб)     send "$chat" "$(fmt_plain 'Тест ютуба' "$($RCTL yttest 2>&1)")" ;;
    /nodes|Серверы|серверы)
      t=$(fmt_nodes)
      send "$chat" "$t" "$(cat /tmp/rctl-bot.kb 2>/dev/null || echo "$KB")" ;;
    /best|Лучший)              send "$chat" "$(fmt_plain 'Выбор быстрейшего' "$($RCTL nodes best 2>&1)")" ;;
    /auto)                     send "$chat" "$(fmt_plain 'Автовыбор' "$($RCTL nodes auto 2>&1)")" ;;
    /logs)                     send "$chat" "$(fmt_plain 'Лог прокси' "$($RCTL logs sing-box 2>&1 | tail -25)")" ;;
    /info)                     send "$chat" "$(fmt_plain 'Система' "$($RCTL info 2>&1)")" ;;
    /use\ *)
      n=${text#/use }
      if echo "$n" | grep -qE '^[A-Za-z0-9._-]{1,64}$'; then
        send "$chat" "$(fmt_plain 'Смена сервера' "$($RCTL nodes use "$n" 2>&1)")"
      else
        send "$chat" "Кривое имя сервера."
      fi ;;
    *) send "$chat" "Не понял. Кнопки внизу или /help" ;;
  esac
}

handle_cb() { # handle_cb CHAT CALLBACK_ID DATA
  chat=$1; cbid=$2; data=$3
  case "$data" in
    use:*)
      n=${data#use:}
      if echo "$n" | grep -qE '^[A-Za-z0-9._-]{1,64}$'; then
        out=$($RCTL nodes use "$n" 2>&1)
        answer "$cbid" "$(printf '%s' "$out" | head -c 180)"
        send "$chat" "$(fmt_plain "Сервер → $n" "$out")"
      else
        answer "$cbid" "кривое имя"
      fi ;;
    act:best)
      answer "$cbid" "меряю…"
      send "$chat" "$(fmt_plain 'Выбор быстрейшего' "$($RCTL nodes best 2>&1)")" ;;
    act:auto)
      answer "$cbid" "переключаю…"
      send "$chat" "$(fmt_plain 'Автовыбор' "$($RCTL nodes auto 2>&1)")" ;;
    *) answer "$cbid" "неизвестная кнопка" ;;
  esac
}

log "старт (proxy $BOT_PROXY)"
offset=$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)

# на первом запуске пропускаем всё, что накопилось, пока бот лежал
if [ "$offset" = 0 ]; then
  r=$(tg getUpdates --data-urlencode "offset=-1" --data-urlencode "timeout=0")
  last=$(printf '%s' "$r" | tr -d '\n\r' | sed -n 's/.*"update_id":\([0-9]*\).*/\1/p' | tail -1)
  [ -n "$last" ] && offset=$((last + 1))
fi

while :; do
  r=$(tg getUpdates --data-urlencode "offset=$offset" --data-urlencode "timeout=50" \
        --data-urlencode 'allowed_updates=["message","callback_query"]')
  if [ -z "$r" ]; then sleep 5; continue; fi
  case "$r" in
    *'"ok":true'*) : ;;
    *) log "API ответил не ок: $(printf '%s' "$r" | head -c 200)"; sleep 15; continue ;;
  esac

  [ "${BOT_DEBUG:-0}" = 1 ] && log "сырой ответ: $(printf '%s' "$r" | tr -d '\n' | head -c 300)"

  # ответ приходит с переносами строк внутри объектов — склеиваем в одну строку,
  # иначе разбиение по update_id даёт огрызки
  printf '%s' "$r" | tr -d '\n\r' | sed 's/{"update_id":/\
&/g' | grep '"update_id"' | while IFS= read -r u; do
    uid=$(printf '%s' "$u" | sed -n 's/.*"update_id":\([0-9]*\).*/\1/p')
    [ -n "$uid" ] || continue
    echo $((uid + 1)) > "$OFFSET_FILE"
    chat=$(printf '%s' "$u" | sed -n 's/.*"chat":{"id":\(-\{0,1\}[0-9]*\).*/\1/p')
    [ -n "$chat" ] || continue

    case "$u" in
      *'"callback_query"'*)
        cbid=$(printf '%s' "$u" | sed -n 's/.*"callback_query":{"id":"\([^"]*\)".*/\1/p')
        data=$(printf '%s' "$u" | sed -n 's/.*"data":"\([^"]*\)".*/\1/p' | unesc)
        [ -n "$cbid" ] && [ -n "$data" ] || { log "пропущен callback $uid"; continue; }
        if allowed "$chat"; then
          log "кнопка от $chat: $data"
          handle_cb "$chat" "$cbid" "$data"
        else
          answer "$cbid" "не для тебя"
        fi ;;
      *)
        text=$(printf '%s' "$u" | sed -n 's/.*"text":"\([^"]*\)".*/\1/p' | unesc)
        if [ -z "$text" ]; then
          log "пропущен апдейт $uid: $(printf '%s' "$u" | head -c 200)"
          continue
        fi
        if allowed "$chat"; then
          log "команда от $chat: $text"
          handle "$chat" "$text"
        else
          log "чужой чат $chat: $text"
          send "$chat" "Этот бот только для своих.
Твой chat_id: <code>$chat</code>
Впиши его в BOT_ALLOW в /etc/rctl-bot.conf и перезапусти: /etc/init.d/rctl-bot restart"
        fi ;;
    esac
  done
  no=$(cat "$OFFSET_FILE" 2>/dev/null || echo "$offset")
  [ "$no" -gt "$offset" ] 2>/dev/null && offset=$no
done
