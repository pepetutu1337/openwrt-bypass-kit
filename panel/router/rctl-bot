handle() { # handle CHAT РОЛЬ ТЕКСТ [MESSAGE_ID] [ИМЯ]
  chat=$1; role=$2; text=$3; msgid=${4:-}; sender_name=${5:-}
  case "$text" in
    /start|/help|help|Помощь)
      [ "$role" = owner ] && send_typed "$chat" help "$HELP_OWNER" || send_typed "$chat" help "$HELP_FAMILY" ;;
    /status|Статус|статус)  send_typed "$chat" status "$(md_status)" ;;
    /fix|Починить|починить)  with_progress "$chat" fix "Починка" $RCTL fix ;;
    /yt|/yttest|Ютуб|ютуб)   with_progress "$chat" yt "Тест ютуба" $RCTL yttest ;;
    /nodes|Серверы|серверы)
      nodes_live "$chat" & ;;
    /best|Лучший)  with_progress "$chat" node "Выбор быстрейшего" $RCTL nodes best ;;
    /auto)         with_progress "$chat" node "Автовыбор" $RCTL nodes auto ;;
