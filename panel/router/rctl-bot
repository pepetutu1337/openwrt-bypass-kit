handle_cb() { # handle_cb CHAT РОЛЬ CBID DATA
  chat=$1; role=$2; cbid=$3; data=$4
  case "$data" in
    use:*)
      n=${data#use:}
      if echo "$n" | grep -qE '^[A-Za-z0-9._-]{1,64}$'; then
        answer "$cbid" "переключаю на $n…"
        with_progress "$chat" node "Сервер → $n" $RCTL nodes use "$n"
      else answer "$cbid" "кривое имя"; fi ;;
    act:best) answer "$cbid" "меряю…"; with_progress "$chat" node "Выбор быстрейшего" $RCTL nodes best ;;
    act:auto) answer "$cbid" "переключаю…"; with_progress "$chat" node "Автовыбор" $RCTL nodes auto ;;
    tunelvl:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      answer "$cbid" "запускаю подбор"
      tune_start "$chat" "${data#tunelvl:}" ;;
    tune:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      n=${data#tune:}
      s=$(sed -n "${n}p" /tmp/rctl-bot.tune 2>/dev/null)
      if [ -n "$s" ]; then
        answer "$cbid" "применяю…"
        with_progress "$chat" tuneres "Применение стратегии" $TUNE apply "$s"
      else answer "$cbid" "стратегия потерялась, запусти подбор заново"; fi ;;
    grant:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      id=${data#grant:}
      nm=$(cat "/tmp/rctl-bot.pending.$id" 2>/dev/null || echo "без имени")
      acl_add "$id" family "$nm"
      rm -f "/tmp/rctl-bot.pending.$id"
      answer "$cbid" "пустил"
      rich "$chat" "\`$id\` ($nm) теперь может пользоваться ботом." >/dev/null
      send_typed "$id" help "$HELP_FAMILY" ;;
    deny:*)
      [ "$role" = owner ] || { answer "$cbid" "только хозяину"; return; }
      id=${data#deny:}
      rm -f "/tmp/rctl-bot.pending.$id"
      answer "$cbid" "отказал" ;;
    *) answer "$cbid" "неизвестная кнопка" ;;
  esac
}

