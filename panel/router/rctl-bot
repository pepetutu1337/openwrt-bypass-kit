**Написал:** $3

Пустить — получит статус, починку, тест ютуба и выбор сервера. Настройки и стратегии останутся только тебе." \
      "{\"inline_keyboard\":[[{\"text\":\"✅ Пустить\",\"callback_data\":\"grant:$1\"},{\"text\":\"⛔ Отказать\",\"callback_data\":\"deny:$1\"}]]}"
  done
}

# ---------- основной цикл -----------------------------------------------------

# отладочный режим: rctl-bot selftest CHAT_ID — шлёт пример оформления и выходит,
# не поднимая основной цикл (иначе будет драка за getUpdates со службой)
case "${1:-}" in
  selftest)
    [ -n "${2:-}" ] || { echo "rctl-bot selftest CHAT_ID"; exit 1; }
    send_typed "$2" status "$(md_status)" && echo "статус отправлен"
    m=$($RCTL nodes list 2>&1 | md_nodes)
    send_typed "$2" nodes "$m" "$(cat /tmp/rctl-bot.kb 2>/dev/null)" && echo "серверы отправлены"
    exit 0 ;;
esac

log "старт (proxy $BOT_PROXY)"
offset=$(cat "$OFFSET_FILE" 2>/dev/null || echo 0)

if [ "$offset" = 0 ]; then
  r=$(tg getUpdates --data-urlencode "offset=-1" --data-urlencode "timeout=0")
  last=$(printf '%s' "$r" | tr -d '\n\r' | sed -n 's/.*"update_id":\([0-9]*\).*/\1/p' | tail -1)
  [ -n "$last" ] && offset=$((last + 1))
fi

while :; do
  r=$(tg getUpdates --data-urlencode "offset=$offset" --data-urlencode "timeout=50" \
        --data-urlencode 'allowed_updates=["message","callback_query"]')
  if [ -z "$r" ]; then sleep 5; continue; fi
  case "$r" in
    *'"ok":true'*) : ;;
    *) log "API ответил не ок: $(printf '%s' "$r" | head -c 200)"; sleep 15; continue ;;
  esac

  [ "${BOT_DEBUG:-0}" = 1 ] && log "сырой ответ: $(printf '%s' "$r" | tr -d '\n' | head -c 300)"

  # ответ приходит с переносами строк внутри объектов — склеиваем в одну строку,
  # иначе разбиение по update_id даёт огрызки
  printf '%s' "$r" | tr -d '\n\r' | sed 's/{"update_id":/\
&/g' | grep '"update_id"' | while IFS= read -r u; do
    uid=$(printf '%s' "$u" | sed -n 's/.*"update_id":\([0-9]*\).*/\1/p')
    [ -n "$uid" ] || continue
    echo $((uid + 1)) > "$OFFSET_FILE"
    chat=$(printf '%s' "$u" | sed -n 's/.*"chat":{"id":\(-\{0,1\}[0-9]*\).*/\1/p')
    [ -n "$chat" ] || continue
    # Права считаем по ОТПРАВИТЕЛЮ, а не по чату. В личке это одно и то же, а
    # в группе chat.id — это группа: пустив её однажды, пустишь заодно всех,
    # кто в ней есть и кого туда добавят потом. Первое вхождение "from" — это
    # автор сообщения (в нажатой кнопке — тот, кто нажал); последующие
    # принадлежат вложенным объектам, включая самого бота.
    who=$(printf '%s' "$u" | grep -o '"from":{"id":-\{0,1\}[0-9]*' | head -1 | grep -o -- '-\{0,1\}[0-9]*$')
    role=$(role_of "${who:-$chat}")

    case "$u" in
      *'"callback_query"'*)
        cbid=$(printf '%s' "$u" | sed -n 's/.*"callback_query":{"id":"\([^"]*\)".*/\1/p')
        data=$(printf '%s' "$u" | sed -n 's/.*"data":"\([^"]*\)".*/\1/p' | unesc)
        [ -n "$cbid" ] && [ -n "$data" ] || { log "пропущен callback $uid"; continue; }
        if [ -n "$role" ]; then
          log "кнопка от $chat ($role): $data"
          handle_cb "$chat" "$role" "$cbid" "$data"
        else
          answer "$cbid" "нет доступа"
        fi ;;
      *)
        text=$(printf '%s' "$u" | sed -n 's/.*"text":"\([^"]*\)".*/\1/p' | unesc)
        if [ -z "$text" ]; then
          log "пропущен апдейт $uid: $(printf '%s' "$u" | head -c 200)"
          continue
        fi
        mid=$(printf '%s' "$u" | sed -n 's/.*"message":{"message_id":\([0-9]*\).*/\1/p')
        name=$(printf '%s' "$u" | sed -n 's/.*"first_name":"\([^"]*\)".*/\1/p' | unesc)
        # `/join` обязан доходить и от того, у кого прав ещё нет: это и есть
        # дверь. Остальное от неизвестных по-прежнему уходит хозяину запросом.
        case "$text" in
          /join\ *|/join|/leave)
            log "дверь от $chat: $(echo "$text" | cut -d" " -f1)"
            handle "$chat" "$role" "$text" "$mid" "$name" "$name"
            continue ;;
        esac
        if [ -n "$role" ]; then
          # Ссылка подписки — ключ, в системном журнале ей не место.
          case "$text" in
            /sub\ *) log "команда от $chat ($role): /sub <ссылка скрыта>" ;;
            *)       log "команда от $chat ($role): $text" ;;
          esac
          handle "$chat" "$role" "$text" "$mid" "$name"
        else
          log "чужой чат $chat ($name): $text"
          pend=$(ls /tmp/rctl-bot.pending.* 2>/dev/null | wc -l)
          if [ -f "/tmp/rctl-bot.pending.$chat" ]; then
            send_html "$chat" "Запрос уже отправлен хозяину роутера, подожди."
          elif [ "$pend" -ge 5 ]; then
            # Иначе любой прохожий может завалить хозяина запросами, а /tmp —
            # файлами. Пятерых ожидающих достаточно для семьи; лишним просто
            # молчим, чтобы не подтверждать, что бот вообще живой.
            log "чужак $chat отброшен: уже $pend висящих запросов"
          else
            ask_owner "$chat" "${name:-без имени}" "$text"
            send_html "$chat" "Спросил хозяина роутера — если пустит, бот сам напишет."
          fi
        fi ;;
    esac
  done
  no=$(cat "$OFFSET_FILE" 2>/dev/null || echo "$offset")
  [ "$no" -gt "$offset" ] 2>/dev/null && offset=$no
done
