# ---------- долгие операции с прогрессом --------------------------------------

# Показывает «идёт работа», обновляя одно сообщение, пока команда считается.
with_progress() { # with_progress CHAT ТИП ЗАГОЛОВОК КОМАНДА…
  chat=$1; type=$2; title=$3; shift 3
  mid=$(send_html "$chat" "⏳ <b>$title</b>
<i>началось…</i>")
  out=/tmp/rctl-bot.out.$$
  ( "$@" > "$out" 2>&1; echo done > "$out.flag" ) &
  worker=$!
  i=0
  while kill -0 "$worker" 2>/dev/null; do
    sleep 3
    i=$((i + 3))
    last=$(tail -1 "$out" 2>/dev/null | esc_html | head -c 120)
    [ -n "$mid" ] && edit_html "$chat" "$mid" "⏳ <b>$title</b>
идёт ${i}с
<code>${last:-подождём…}</code>"
    [ "$i" -gt 900 ] && break
  done
  wait "$worker" 2>/dev/null
  res=$(cat "$out" 2>/dev/null)
  rm -f "$out" "$out.flag"
  [ -n "$mid" ] && tg deleteMessage -o /dev/null --data-urlencode "chat_id=$chat" --data-urlencode "message_id=$mid"
  send_typed "$chat" "$type" "$(md_block "$title" "$res")"
}

# Подбор стратегии: предупреждение -> запуск -> живой прогресс -> кнопки применения
tune_start() { # tune_start CHAT УРОВЕНЬ
  chat=$1; level=$2
  out=$($TUNE start youtube.com "$level" 2>&1)
  case "$out" in
    *"уже идёт"*) send_typed "$chat" tune "$(md_block 'Подбор стратегии' "$out")"; return ;;
  esac
  mid=$(send_html "$chat" "⏳ <b>Подбираю стратегию</b>
<i>обход сейчас отключён, вернётся сам</i>")
  (
    i=0
    while :; do
      sleep 15
      i=$((i + 15))
      st=$($TUNE status 2>&1)
      phase=$(printf '%s' "$st" | sed -n 's/^фаза: //p')
      cur=$(printf '%s' "$st" | sed -n 's/^сейчас: //p' | esc_html | head -c 100)
      found=$(printf '%s' "$st" | sed -n 's/^найдено рабочих: //p')
      [ -n "$mid" ] && edit_html "$chat" "$mid" "⏳ <b>Подбираю стратегию</b>
фаза: ${phase:-?} · идёт $((i / 60)) мин
найдено рабочих: ${found:-0}
<code>${cur:-…}</code>
<i>обход отключён на время подбора</i>"
      case "$phase" in готово|прерван|оборвался*) break ;; esac
      [ "$i" -gt 2700 ] && break
    done
    [ -n "$mid" ] && tg deleteMessage -o /dev/null --data-urlencode "chat_id=$chat" --data-urlencode "message_id=$mid"
    res=$($TUNE result 2>&1 | head -8)
    if [ -z "$res" ]; then
      send_typed "$chat" tuneres "## Подбор закончен

Рабочих стратегий не нашлось. Либо блокировки сейчас нет вовсе, либо нужен уровень \`force\` — он дольше, но перебирает всё.

Запустить: /tune force"
    else
      printf '%s\n' "$res" > /tmp/rctl-bot.tune
      md="## Подбор закончен

Нашлось рабочих: $(printf '%s\n' "$res" | grep -c .)

| № | стратегия |
|---:|---|
"
      n=0
      kb='{"inline_keyboard":['
      first=1
      while IFS= read -r line; do
        n=$((n + 1))
        md="$md| $n | \`$line\` |
"
        [ "$first" = 1 ] || kb="$kb,"
        kb="$kb[{\"text\":\"Применить №$n\",\"callback_data\":\"tune:$n\"}]"
        first=0
      done <<EOT
$res
EOT
      kb="$kb]}"
      md="$md
Применение правит только строку TCP 443, конфиг бэкапится, при ухудшении откат автоматический."
      send_typed "$chat" tuneres "$md" "$kb"
    fi
  ) &
}

# Сменить подписку и применить её к конфигу роутера.
#
# Два шага не случайно. `vpn sub` только запоминает ссылку и разбирает ноды в
# своё хозяйство; конфиг роутера правит `vpn sync` — с проверкой самим sing-box,
# бэкапом и откатом, если после перезапуска наружу не достучаться. Так смена
# подписки из другого города не может оставить квартиру без интернета: худшее,
# что выйдет, — останется вчерашний конфиг.
sub_apply() { # sub_apply CHAT URL
  _chat=$1; _url=$2
  ( send_typed "$_chat" sub "$(md_block 'Подписка' 'Забираю ноды по новой ссылке…')"
    out=$(HOME=/root $NETPULT vpn sub "$_url" 2>&1)
    code=$?
    if [ "$code" != 0 ]; then
      # Ссылку в ответ не возвращаем: она ключ, и в чате ей делать нечего.
      send_typed "$_chat" sub "$(md_block 'Подписка не принята' "$(printf '%s' "$out" | grep -v 'https://' | tail -5)")"
      exit 0
    fi
    got=$(printf '%s' "$out" | sed -n 's/.*Разобрано нод: \([0-9]*\).*/\1/p' | head -1)
    send_typed "$_chat" sub "$(md_block 'Подписка' "Нод в новой подписке: ${got:-?}
Применяю к роутеру…")"
    out2=$(HOME=/root $NETPULT vpn sync 2>&1)
    send_typed "$_chat" sub "$(md_block 'Подписка' "$(printf '%s' "$out2" | grep -v 'https://' | tail -6)")"
  ) &
}

