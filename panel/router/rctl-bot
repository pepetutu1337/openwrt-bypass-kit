#!/bin/sh
# Telegram-бот к роутеру. Живёт на самом роутере, только исходящие соединения —
# ни портов наружу, ни пробросов. В API ходит через локальный SOCKS sing-box,
# потому что api.telegram.org с роутера напрямую не открывается.
#
# Настройки: /etc/rctl-bot.conf
#   BOT_TOKEN=123456:AA...      токен от @BotFather
#   BOT_ALLOW="11111 22222"     владельцы (полный доступ)
#   BOT_PROXY=127.0.0.1:1180    локальный SOCKS sing-box
#   BOT_DEBUG=1                 писать сырые ответы API в лог
#
# Доступ семьи: /etc/rctl-bot.acl, строки вида "123456:family:Мама".
# Незнакомец пишет боту — владельцу прилетает запрос с кнопками.
#
# Оформление: Bot API 10.1 sendRichMessage — markdown с настоящими таблицами.
# Если rich не прошёл, сообщение уходит обычным sendMessage в HTML.
set -u

CONF=/etc/rctl-bot.conf
ACL=/etc/rctl-bot.acl
CODES=/etc/rctl-bot.codes
[ -f "$CONF" ] || { echo "нет $CONF"; exit 1; }
# shellcheck disable=SC1090
. "$CONF"

RCTL=/usr/sbin/rctl
TUNE=/usr/sbin/zapret-tune
NETPULT=/usr/sbin/netpult

# Как этот роутер зовут в чате. Бот живёт на роутере, значит один бот — один
# роутер: «войти в юрисдикцию» и означает подключиться именно к нему. Имя
# нужно, чтобы, обслуживая несколько роутеров, не перепутать, кому пишешь.
ROUTER_NAME="${ROUTER_NAME:-$(cat /tmp/sysinfo/model 2>/dev/null || uname -n)}"
export RCTL_LOCAL=1
BOT_PROXY="${BOT_PROXY:-127.0.0.1:1180}"
BOT_ALLOW="${BOT_ALLOW:-}"
OFFSET_FILE=/tmp/rctl-bot.offset
API="https://api.telegram.org/bot$BOT_TOKEN"
KB='{"keyboard":[["Статус","Починить"],["Ютуб","Серверы"]],"resize_keyboard":true}'

log() { logger -t rctl-bot "$*"; }

tg() { m=$1; shift; curl -s --max-time 70 --socks5-hostname "$BOT_PROXY" "$API/$m" "$@"; }

# ---------- отправка ----------------------------------------------------------

# текст -> строковый литерал JSON (без кавычек по краям)
json_esc() {
  sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\r//g' \
  | awk 'BEGIN{ORS=""} {if (NR>1) printf "\\n"; print}'
}

esc_html() { sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'; }

# Красивый ответ: markdown с таблицами через sendRichMessage.
# Возвращает message_id (или пусто).
# Сообщения одного типа не копятся: новое стирает предыдущее того же типа.
# id последнего храним в файле на чат и тип.
send_typed() { # send_typed CHAT ТИП MARKDOWN [KEYBOARD]
  f="/tmp/rctl-bot.msg.$1.$2"
  old=$(cat "$f" 2>/dev/null)
  id=$(rich "$1" "$3" "${4:-}")
  # сначала шлём новое, потом убираем старое — чтобы чат не мигал пустотой
  [ -n "$old" ] && tg deleteMessage -o /dev/null \
      --data-urlencode "chat_id=$1" --data-urlencode "message_id=$old"
  [ -n "$id" ] && echo "$id" > "$f"
}

rich() { # rich CHAT MARKDOWN [KEYBOARD] -> печатает message_id
  body="{\"markdown\":\"$(printf '%s' "$2" | json_esc)\"}"
  # клавиатуру передаём файлом: в её JSON есть пробелы, а подстановка
  # аргументов через ${3:+...} порвала бы строку на куски
  if [ -n "${3:-}" ]; then
    printf '%s' "$3" > /tmp/rctl-bot.kbd
    r=$(tg sendRichMessage \
          --data-urlencode "chat_id=$1" \
          --data-urlencode "rich_message=$body" \
          --data-urlencode "reply_markup@/tmp/rctl-bot.kbd")
  else
    r=$(tg sendRichMessage \
          --data-urlencode "chat_id=$1" \
          --data-urlencode "rich_message=$body")
  fi
  case "$r" in
    *'"ok":true'*)
      printf '%s' "$r" | sed -n 's/.*"message_id":\([0-9]*\).*/\1/p' | head -1
      return 0 ;;
  esac
  log "rich не прошёл: $(printf '%s' "$r" | head -c 160) — падаю на HTML"
  send_html "$1" "$(printf '%s' "$2" | esc_html)" "${3:-}"
}

send_html() { # send_html CHAT HTML [KEYBOARD]
  printf '%s' "$2" | head -c 3800 > /tmp/rctl-bot.msg
  r=$(tg sendMessage \
        --data-urlencode "chat_id=$1" \
        --data-urlencode "text@/tmp/rctl-bot.msg" \
        --data-urlencode "parse_mode=HTML" \
        --data-urlencode "reply_markup=${3:-$KB}")
  rm -f /tmp/rctl-bot.msg
  printf '%s' "$r" | sed -n 's/.*"message_id":\([0-9]*\).*/\1/p' | head -1
}

edit_html() { # edit_html CHAT MSGID HTML
  printf '%s' "$3" | head -c 3800 > /tmp/rctl-bot.edit
  tg editMessageText -o /dev/null \
    --data-urlencode "chat_id=$1" \
    --data-urlencode "message_id=$2" \
    --data-urlencode "text@/tmp/rctl-bot.edit" \
    --data-urlencode "parse_mode=HTML"
  rm -f /tmp/rctl-bot.edit
}

answer() { tg answerCallbackQuery -o /dev/null --data-urlencode "callback_query_id=$1" --data-urlencode "text=${2:-}"; }

# Telegram отдаёт кириллицу как \uXXXX, busybox printf %b такое не разворачивает
unesc() {
  awk '{
    s=$0; out="";
    while (match(s, /\\u[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]/)) {
      out = out substr(s, 1, RSTART-1);
      h = tolower(substr(s, RSTART+2, 4));
      c = 0;
      for (i = 1; i <= 4; i++) c = c * 16 + index("0123456789abcdef", substr(h, i, 1)) - 1;
      if (c < 128)       out = out sprintf("%c", c);
      else if (c < 2048) out = out sprintf("%c%c", 192 + int(c/64), 128 + (c%64));
      else               out = out sprintf("%c%c%c", 224 + int(c/4096), 128 + int(c/64)%64, 128 + (c%64));
      s = substr(s, RSTART + RLENGTH);
    }
    print out s;
  }'
}

# ---------- доступ ------------------------------------------------------------

# owner — всё; family — только безопасное; пусто — чужой
role_of() {
  for c in $BOT_ALLOW; do [ "$c" = "$1" ] && { echo owner; return; }; done
  [ -f "$ACL" ] || return
  awk -F: -v id="$1" '$1 == id { print $2; exit }' "$ACL"
}

acl_add() { # acl_add ID РОЛЬ ИМЯ
  touch "$ACL"; chmod 600 "$ACL"
  acl_del "$1"
  printf '%s:%s:%s\n' "$1" "$2" "$3" >> "$ACL"
}
acl_del() {
  [ -f "$ACL" ] || return 0
  grep -v "^$1:" "$ACL" > "$ACL.tmp" 2>/dev/null; mv "$ACL.tmp" "$ACL"; chmod 600 "$ACL"
}

owners() {
  # Постоянные владельцы из конфига плюс те, кто вошёл по коду владельца.
  echo "$BOT_ALLOW"
  [ -f "$ACL" ] && awk -F: '$2 == "owner" { print $1 }' "$ACL"
}

# ---------- коды-приглашения --------------------------------------------------
#
# Раньше пускать человека можно было только двумя путями: вписать его id в
# конфиг руками или дождаться, пока он сам напишет боту, и нажать кнопку. Оба
# требуют знать чужой числовой id заранее, а он человеку неизвестен.
#
# Код проще: хозяин выпускает строку, отдаёт её любым способом, человек шлёт
# `/join КОД`. Код одноразовый и живёт сутки — утёкший в переписке код должен
# протухать сам, а не ждать, пока о нём вспомнят.

codes_gc() { # выбросить протухшие и израсходованные
  [ -f "$CODES" ] || return 0
  now=$(date +%s)
  awk -F: -v now="$now" '$3 > now && $4 > 0' "$CODES" > "$CODES.tmp" 2>/dev/null
  mv "$CODES.tmp" "$CODES"; chmod 600 "$CODES"
}

code_new() { # code_new РОЛЬ ЧАСОВ ПРИМЕНЕНИЙ -> код
  touch "$CODES"; chmod 600 "$CODES"
  codes_gc
  # Без похожих знаков: ноль и О, единица и I человек путает, диктуя код вслух.
  c=$(tr -dc 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789' < /dev/urandom | head -c 8)
  printf '%s:%s:%s:%s\n' "$c" "$1" "$(( $(date +%s) + $2 * 3600 ))" "$3" >> "$CODES"
  echo "$c"
}

code_take() { # code_take КОД -> РОЛЬ (и списывает применение)
  [ -f "$CODES" ] || return 1
  codes_gc
  line=$(awk -F: -v c="$1" '$1 == c { print; exit }' "$CODES")
  [ -n "$line" ] || return 1
  r=$(echo "$line" | cut -d: -f2)
  left=$(echo "$line" | cut -d: -f4)
  rest=$(( left - 1 ))
  if [ "$rest" -le 0 ]; then
    grep -v "^$1:" "$CODES" > "$CODES.tmp"; mv "$CODES.tmp" "$CODES"
  else
    awk -F: -v c="$1" -v n="$rest" 'BEGIN{OFS=":"} $1==c{$4=n} {print}' "$CODES" > "$CODES.tmp"
    mv "$CODES.tmp" "$CODES"
  fi
  chmod 600 "$CODES"
  echo "$r"
}

md_codes() {
  codes_gc
  echo "## Действующие коды"
  echo ""
  if [ ! -s "$CODES" ]; then
    echo "Ни одного. Выпустить: \`/invite\` — гостю, \`/invite owner\` — второму хозяину."
    return
  fi
  echo "| код | права | осталось часов | применений |"
  echo "|---|---|---|---|"
  now=$(date +%s)
  awk -F: -v now="$now" '{ printf "| `%s` | %s | %d | %s |\n", $1, ($2=="owner"?"хозяин":"гость"), ($3-now)/3600, $4 }' "$CODES"
  echo ""
  echo "Отозвать: \`/revoke КОД\`"
}

# ---------- вывод -------------------------------------------------------------

md_status() {
  s=$($RCTL status 2>&1)
  mark() { printf '%s' "$s" | grep -q "^$1 ●" && echo "🟢 работает" || echo "🔴 лежит"; }
  node=$(printf '%s' "$s" | sed -n 's/^активная нода: \(.*\)$/\1/p')
  dom=$(printf '%s' "$s" | sed -n 's/^проксируемых доменов (uci): \(.*\)$/\1/p')
  geo=$(printf '%s' "$s" | sed -n 's/^geoblock: \([0-9]*\).*/\1/p')
  quic=$(printf '%s' "$s" | grep -q "QUIC-блок: включён" && echo "включён" || echo "выключен")
  down=$(printf '%s' "$s" | grep -c "✗ stopped")
  [ "$down" = 0 ] && head="## 🟢 Всё работает" || head="## 🔴 Что-то лежит"

  cat <<EOF
$head

| служба | состояние |
|---|---|
| прокси | $(mark sing-box) |
| zapret | $(mark zapret) |
| DNS | $(mark DoH) |
| dnsmasq | $(mark dnsmasq) |

**Сервер:** \`${node:-неизвестен}\` · **QUIC:** $quic
**Домены:** ${dom:-0} своих + ${geo:-0} geoblock
EOF
}

# Таблица серверов + инлайн-кнопки. Кнопки только для живых.
# На кнопках — только флаги, как просил хозяин. Цифра добавляется, когда в
# стране больше одной ноды: иначе четыре одинаковых 🇩🇪 подряд и выбор вслепую.
md_nodes() { # читает вывод `rctl nodes list` со stdin; клавиатуру кладёт в /tmp/rctl-bot.kb
  awk '
    BEGIN {
      F["albania"]="🇦🇱";     F["al"]="🇦🇱";
      F["cz"]="🇨🇿";          F["czech"]="🇨🇿";
      F["finland"]="🇫🇮";     F["fi"]="🇫🇮";
      F["france"]="🇫🇷";      F["fr"]="🇫🇷";
      F["germany"]="🇩🇪";     F["de"]="🇩🇪";
      F["india"]="🇮🇳";       F["in"]="🇮🇳";
      F["japan"]="🇯🇵";       F["jp"]="🇯🇵";
      F["kazakhstan"]="🇰🇿";  F["kz"]="🇰🇿";
      F["netherlands"]="🇳🇱"; F["nl"]="🇳🇱";
      F["poland"]="🇵🇱";      F["pl"]="🇵🇱";
      F["riga"]="🇱🇻";        F["lv"]="🇱🇻";  F["latvia"]="🇱🇻";
      F["spain"]="🇪🇸";       F["es"]="🇪🇸";
      F["sweden"]="🇸🇪";      F["se"]="🇸🇪";
      F["tallin"]="🇪🇪";      F["tallinn"]="🇪🇪"; F["ee"]="🇪🇪"; F["estonia"]="🇪🇪";
      F["turkye"]="🇹🇷";      F["turkey"]="🇹🇷";  F["tr"]="🇹🇷";
      F["usa"]="🇺🇸";         F["us"]="🇺🇸";
      F["uk"]="🇬🇧";          F["britain"]="🇬🇧";
      F["italy"]="🇮🇹";       F["it"]="🇮🇹";
      F["russia"]="🇷🇺";      F["ru"]="🇷🇺";
      F["ukraine"]="🇺🇦";     F["ua"]="🇺🇦";
      F["swiss"]="🇨🇭";       F["ch"]="🇨🇭";  F["switzerland"]="🇨🇭";
      F["austria"]="🇦🇹";     F["at"]="🇦🇹";
      F["norway"]="🇳🇴";      F["no"]="🇳🇴";
      F["denmark"]="🇩🇰";     F["dk"]="🇩🇰";
      F["canada"]="🇨🇦";      F["ca"]="🇨🇦";
      F["singapore"]="🇸🇬";   F["sg"]="🇸🇬";
      F["hongkong"]="🇭🇰";    F["hk"]="🇭🇰";
      F["korea"]="🇰🇷";       F["kr"]="🇰🇷";
      F["armenia"]="🇦🇲";     F["am"]="🇦🇲";
      F["georgia"]="🇬🇪";     F["ge"]="🇬🇪";
      F["serbia"]="🇷🇸";      F["rs"]="🇷🇸";
      F["romania"]="🇷🇴";     F["ro"]="🇷🇴";
      F["hungary"]="🇭🇺";     F["hu"]="🇭🇺";
      F["bulgaria"]="🇧🇬";    F["bg"]="🇧🇬";
      F["lithuania"]="🇱🇹";   F["lt"]="🇱🇹";
      F["moldova"]="🇲🇩";     F["md"]="🇲🇩";
      F["belarus"]="🇧🇾";     F["by"]="🇧🇾";
    }
    function base(n,   b) { b = tolower(n); sub(/[0-9]+$/, "", b); return b }
    # Имена из подписки уже начинаются с флага страны — второй рядом лишний.
    # Признак простой: первый знак не латиница и не цифра.
    function flag(n,   b) {
      if (substr(n, 1, 1) !~ /[A-Za-z0-9]/) return "";
      b = base(n); return (b in F) ? F[b] : "🏳"
    }
    function suffix(n,   s) { s = n; if (match(s, /[0-9]+$/)) return substr(s, RSTART); return "" }
    # rctl печатает ноды строками "tbl|имя|пинг|заметка" — это же читает и
    # веб-панель. Раньше тут разбирался прежний, двухколоночный вывод, и после
    # перехода на таблицы бот молча показывал пустой список: строки просто ни
    # с чем не совпадали.
    /^tbl\|/ {
      n = split($0, c, "|");
      name = c[2];
      if (name == "сервер" || name == "") next;      # шапка таблицы
      ms = c[3];
      note = (n >= 4 ? c[4] : "");
      act = (index(note, "работаем через") > 0);
      if (ms !~ /^[0-9]/) { dead[++d] = name; next }
      sub(/[^0-9].*$/, "", ms);
      alive[++a] = name; pings[a] = ms + 0; active[a] = act;
    }
    END {
      for (i = 1; i <= a; i++) for (j = i+1; j <= a; j++)
        if (pings[j] < pings[i]) {
          t = pings[i]; pings[i] = pings[j]; pings[j] = t;
          t = alive[i]; alive[i] = alive[j]; alive[j] = t;
          t = active[i]; active[i] = active[j]; active[j] = t;
        }
      # сколько живых нод в каждой стране — от этого зависит, нужна ли цифра
      for (i = 1; i <= a; i++) cc[base(alive[i])]++;

      print "## Серверы обхода";
      print "";
      print "| | сервер | пинг | |";
      print "|---|---|---:|---|";
      for (i = 1; i <= a; i++)
        printf "| %s | %s | %d мс | %s |\n", flag(alive[i]), alive[i], pings[i],
               (active[i] ? "сейчас" : (pings[i] < 250 ? "быстрый" : ""));
      print "";
      if (d > 0) {
        printf "<details><summary>Молчат: %d</summary>\n\n", d;
        for (i = 1; i <= d; i++) printf "%s %s%s", flag(dead[i]), dead[i], (i < d ? ", " : "\n");
        print "";
        print "</details>";
        print "";
      }
      print "Кнопки — по флагу страны, цифра стоит там, где серверов в стране больше одного.";

      kb = "{\"inline_keyboard\":[";
      row = ""; rows = ""; cnt = 0;
      for (i = 1; i <= a; i++) {
        label = flag(alive[i]);
        if (cc[base(alive[i])] > 1) label = label suffix(alive[i]);
        if (active[i]) label = label " ✓";
        b = "{\"text\":\"" label "\",\"callback_data\":\"use:" alive[i] "\"}";
        row = row (cnt % 4 == 0 ? "" : ",") b;
        cnt++;
        if (cnt % 4 == 0) { rows = rows (rows == "" ? "" : ",") "[" row "]"; row = "" }
      }
      if (row != "") rows = rows (rows == "" ? "" : ",") "[" row "]";
      rows = rows (rows == "" ? "" : ",") "[{\"text\":\"⚡ Самый быстрый\",\"callback_data\":\"act:best\"},{\"text\":\"🎲 Автовыбор\",\"callback_data\":\"act:auto\"}]";
      print kb rows "]}" > "/tmp/rctl-bot.kb";
    }'
}

