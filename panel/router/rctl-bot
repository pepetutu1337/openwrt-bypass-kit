# Сменить подписку и применить её к конфигу роутера.
#
# Два шага не случайно. `vpn sub` только запоминает ссылку и разбирает ноды в
# своё хозяйство; конфиг роутера правит `vpn sync` — с проверкой самим sing-box,
# бэкапом и откатом, если после перезапуска наружу не достучаться. Так смена
# подписки из другого города не может оставить квартиру без интернета: худшее,
# что выйдет, — останется вчерашний конфиг.
sub_apply() { # sub_apply CHAT URL
  _chat=$1; _url=$2
  ( send_typed "$_chat" sub "$(md_block 'Подписка' 'Забираю ноды по новой ссылке…')"
    out=$(HOME=/root $NETPULT vpn sub "$_url" 2>&1)
    code=$?
    if [ "$code" != 0 ]; then
      # Ссылку в ответ не возвращаем: она ключ, и в чате ей делать нечего.
      send_typed "$_chat" sub "$(md_block 'Подписка не принята' "$(printf '%s' "$out" | grep -v 'https://' | tail -5)")"
      exit 0
    fi
    got=$(printf '%s' "$out" | sed -n 's/.*Разобрано нод: \([0-9]*\).*/\1/p' | head -1)
    send_typed "$_chat" sub "$(md_block 'Подписка' "Нод в новой подписке: ${got:-?}
Применяю к роутеру…")"
    out2=$(HOME=/root $NETPULT vpn sync 2>&1)
    send_typed "$_chat" sub "$(md_block 'Подписка' "$(printf '%s' "$out2" | grep -v 'https://' | tail -6)")"
  ) &
}

# Замер серверов идёт под минуту: групповой запрос, потом поштучная дожимка
# промолчавших. Раньше бот всё это время молчал, и выглядело как поломка —
# особенно когда нод стало сорок пять. Теперь одно сообщение обновляется на
# ходу: сколько проверено, кто проверяется сейчас.
nodes_live() { # nodes_live CHAT
  _chat=$1
  out=/tmp/rctl-bot.nodes.$_chat
  ( $RCTL nodes list > "$out" 2>&1 ) &
  worker=$!
  mid=$(send_html "$_chat" "⏳ <b>Меряю серверы</b>
<i>групповой замер, до 30 с…</i>")
  i=0
  while kill -0 "$worker" 2>/dev/null; do
    sleep 3
    i=$((i + 3))
    # Строки дожимки выглядят как "   7/25  Чехия — 241 мс".
    line=$(grep -E '^ +[0-9]+/[0-9]+ ' "$out" 2>/dev/null | tail -1)
    if [ -n "$line" ]; then
      seen=$(printf '%s' "$line" | sed -E 's/^ +([0-9]+)\/([0-9]+).*/\1 из \2/')
      who=$(printf '%s' "$line" | sed -E 's/^ +[0-9]+\/[0-9]+ +//' | esc_html | head -c 60)
      body="проверено $seen
<code>$who</code>"
    else
      body="<i>групповой замер, до 30 с…</i>"
    fi
    [ -n "$mid" ] && edit_html "$_chat" "$mid" "⏳ <b>Меряю серверы</b>
идёт ${i}с
$body"
    [ "$i" -gt 300 ] && break
  done
  wait "$worker" 2>/dev/null
  [ -n "$mid" ] && tg deleteMessage -o /dev/null \
      --data-urlencode "chat_id=$_chat" --data-urlencode "message_id=$mid"
  m=$(md_nodes < "$out")
  rm -f "$out"
  send_typed "$_chat" nodes "$m" "$(cat /tmp/rctl-bot.kb 2>/dev/null)"
}

