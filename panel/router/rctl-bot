      if [ -n "$role" ]; then
        rich "$chat" "Ты и так подключён к «$ROUTER_NAME» как $( [ "$role" = owner ] && echo хозяин || echo гость)." >/dev/null
        return
      fi
      got=$(code_take "$code") || got=""
      if [ -z "$got" ]; then
