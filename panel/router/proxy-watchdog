#!/bin/sh
# proxy-watchdog — следит за тем, что через ноду реально ходит трафик.
#
# Прежний сторож спрашивал у clash задержку группы `auto`. Но селектор почти
# всегда закреплён на конкретной ноде — руками, кнопкой «самый быстрый» или
# ботом, — и тогда `auto` меряет ноду, через которую не идёт ни один пакет.
# Ловилось живьём: active_node нода легла, инстаграм, клод и телеграм отвалились
# все разом, а сторож каждые три минуты рапортовал «всё хорошо».
#
# Поэтому проверка идёт по той же дороге, что и трафик людей: запрос через
# SOCKS ноды. Что через него не прошло — не пройдёт и у человека.
#
# Порядок лечения: сначала пересесть на живую ноду (это чинит настоящую
# причину), и только если не помогло — перезапускать ядро.
set -u

SOCKS=${PW_SOCKS:-127.0.0.1:1180}
API=${CLASH_API:-127.0.0.1:9090}
RCTL=/usr/sbin/rctl
STAMP=/tmp/proxy-watchdog.last

# Две мишени разных владельцев: одна может лежать сама по себе, обе разом —
# уже дорога.
T1=${PW_T1:-https://www.gstatic.com/generate_204}
T2=${PW_T2:-https://www.instagram.com/}

say() { logger -t proxy-watchdog "$1"; }

# Кому доложить. Сторож молчит, пока всё хорошо, и пишет один раз по факту
# починки: иначе о поломке узнаёшь, только когда сам полез проверять.
# Недоставленное не выбрасываем. Сообщение шлётся ровно тогда, когда через
# ноду ничего не ходит, а напрямую до телеграма с роутера не достучаться
# вообще (проверено). Значит единственный честный путь — отложить и отдать,
# когда прокси вернётся: лучше узнать в 9 утра, что ночью полчаса ничего не
# работало, чем не узнать никогда.
QUEUE=/tmp/notify.queue

# /dev/null обязан быть устройством. На этом роутере он однажды оказался
# обычным файлом на tmpfs в 512 КБ: узел кто-то снёс, а первый же
# `curl -o /dev/null` создал на его месте файл. После этого всё, что пишет
# больше полумегабайта, обрывалось на ENOSPC — curl выходил с ошибкой записи
# при живом ответе 200. Замеры скорости ютуба врали, а проверки объявляли
# рабочие сервисы мёртвыми и звали чинить zapret. Симптом виден везде, причина
# не видна нигде, поэтому чиним молча и сразу.
#
# Новый узел создаётся под другим именем и переносится поверх старого: rename
# атомарен, и не будет мгновения, когда /dev/null не существует вовсе — иначе
# любой пишущий в этот миг процесс создал бы файл заново.
fix_devnull() {
  [ -c /dev/null ] && return 0
  logger -t proxy-watchdog "/dev/null не устройство, а $(ls -ld /dev/null 2>/dev/null | cut -c1) — пересоздаю"
  if mknod -m 666 /dev/null.new c 1 3 2>/dev/null && mv /dev/null.new /dev/null 2>/dev/null; then
    logger -t proxy-watchdog "/dev/null восстановлен"
  else
    rm -f /dev/null.new
    logger -t proxy-watchdog "не смог пересоздать /dev/null — замеры скорости будут врать"
  fi
}
fix_devnull

send_one() { # send_one ТЕКСТ -> 0, если доставлено хоть кому-то
  s=1
  for chat in $BOT_ALLOW; do
    for way in "--socks5-hostname ${BOT_PROXY:-$SOCKS}" ""; do
      # shellcheck disable=SC2086
      c=$(curl -s -o /dev/null -m 15 -w '%{http_code}' $way \
        "https://api.telegram.org/bot$BOT_TOKEN/sendMessage" \
        --data-urlencode "chat_id=$chat" \
        --data-urlencode "text=$1" 2>/dev/null)
      [ "$c" = 200 ] && { s=0; break; }
    done
  done
  return $s
}

flush_queue() {
  [ -s "$QUEUE" ] || return 0
  [ -f /etc/rctl-bot.conf ] || return 0
  # shellcheck disable=SC1091
  . /etc/rctl-bot.conf 2>/dev/null || return 0
  [ -n "${BOT_TOKEN:-}" ] && [ -n "${BOT_ALLOW:-}" ] || return 0
  left=/tmp/notify.queue.left; : > "$left"
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    send_one "$line" || printf '%s\n' "$line" >> "$left"
  done < "$QUEUE"
  mv "$left" "$QUEUE"
  [ -s "$QUEUE" ] || rm -f "$QUEUE"
}

tell() {
  [ -f /etc/rctl-bot.conf ] || return 0
  # shellcheck disable=SC1091
  . /etc/rctl-bot.conf 2>/dev/null || return 0
  [ -n "${BOT_TOKEN:-}" ] && [ -n "${BOT_ALLOW:-}" ] || return 0
  if send_one "$1"; then
    return 0
  fi
  # не дошло — в очередь, с отметкой времени, чтобы потом было понятно, о чём речь
  printf '%s %s\n' "$(date '+%d.%m %H:%M') —" "$1" >> "$QUEUE"
  return 1
}

# Один заход по настоящей дороге: код ответа через SOCKS ноды.
# Имена функций тут латиницей не для красоты: busybox ash не принимает в них
# кириллицу — вызов превращается в «not found», и сторож начинает лечить
# здорового. Поймал при первом же прогоне на роутере.
via_node() {
  curl -s -o /dev/null -m "${2:-12}" -w '%{http_code}' \
    --socks5-hostname "$SOCKS" "$1" 2>/dev/null
}

passes() {
  c1=$(via_node "$T1"); case "$c1" in 2??|3??) return 0 ;; esac
  c2=$(via_node "$T2"); case "$c2" in 2??|3??) return 0 ;; esac
  return 1
}

active_node() {
  sel=$(curl -s -m 4 "http://$API/proxies/proxy" | sed -n 's/.*"now": *"\([^"]*\)".*/\1/p')
  [ "$sel" = auto ] && sel=$(curl -s -m 4 "http://$API/proxies/auto" | sed -n 's/.*"now": *"\([^"]*\)".*/\1/p')
  echo "$sel"
}

# Звонки Telegram: голос идёт по UDP и уходит в ноду через tproxy. Провод у
# этого пути тонкий и молчаливый — правило метки и локальный маршрут живут в
# памяти, а не в конфиге. Пропали — переписка работает, звонки нет, и снаружи
# всё выглядит здоровым. Поэтому проверяем сам провод, а не трафик.
calls_wired() {
  nft list chain inet fw4 tg_tproxy 2>/dev/null | grep -q tproxy || return 1
  ip rule show 2>/dev/null | grep -q "fwmark 0x1 lookup 100" || return 1
  ip route show table 100 2>/dev/null | grep -q "local default" || return 1
  netstat -lnup 2>/dev/null | grep -q ":1101 " || return 1
  return 0
}

if [ -f /etc/hotplug.d/iface/99-kit-tproxy ] && ! calls_wired; then
  say "путь звонков разобран — собираю обратно"
  ACTION=ifup sh /etc/hotplug.d/iface/99-kit-tproxy >/dev/null 2>&1
  nft list chain inet fw4 tg_tproxy 2>/dev/null | grep -q tproxy || fw4 reload >/dev/null 2>&1
  netstat -lnup 2>/dev/null | grep -q ":1101 " || /etc/init.d/sing-box restart >/dev/null 2>&1
  if calls_wired; then
    say "путь звонков восстановлен"
  else
    say "путь звонков собрать не вышло — нужен разбор руками"
  fi
fi

# Здоровый заход — самое время отдать то, что не ушло в прошлый раз.
if passes; then flush_queue; exit 0; fi
sleep 4
if passes; then flush_queue; exit 0; fi

was=$(active_node)
say "через ноду ($was) не проходит ни одна мишень — пересаживаюсь"

# 1. Пересесть на живую. Это лечит саму причину: нода умерла, а селектор на ней.
RCTL_LOCAL=1 $RCTL nodes best >/dev/null 2>&1
sleep 3
if passes; then
  now_node=$(active_node)
  say "помогло: $was -> $now_node"
  # не частим: одно сообщение в час, даже если ноды сыплются одна за другой
  now=$(date +%s); last=$(cat "$STAMP" 2>/dev/null || echo 0)
  if [ $((now - last)) -gt 3600 ]; then
    # штамп ставим по факту доставки: недоставленное сообщение не должно
    # запирать канал на час
    tell "Нода «$was» перестала пропускать трафик — пересел на «$now_node». Сайты через прокси снова работают." && echo "$now" > "$STAMP"
  fi
  exit 0
fi

# 2. Не помогло — перезапустить ядро.
say "смена ноды не помогла — перезапускаю sing-box"
/etc/init.d/sing-box restart >/dev/null 2>&1
sleep 8
if passes; then
  say "поднялось после перезапуска (нода $(active_node))"
  exit 0
fi

say "через ноду по-прежнему не проходит — нужен разбор руками"
now=$(date +%s); last=$(cat "$STAMP" 2>/dev/null || echo 0)
if [ $((now - last)) -gt 3600 ]; then
  tell "Прокси не работает: ни одна нода не пропускает трафик, перезапуск ядра не помог. Проверь подписку — /nodes, /status." && echo "$now" > "$STAMP"
fi
