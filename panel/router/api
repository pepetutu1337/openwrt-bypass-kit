#!/bin/sh
# CGI-бэкенд панели, живущей на самом роутере (uhttpd, без python).
# Отдаёт text/plain — фронт просто печатает ответ в консоль.
# Наружу торчать не должен: uhttpd-инстанс слушает только LAN, см. install.sh.
#
# Принцип тот же, что у панели на Деке: не «выполни что дали», а строгий
# список разрешённых действий. Всё, что приходит из браузера, проверяется
# регуляркой до того, как попасть в аргументы rctl.

RCTL=/usr/sbin/rctl
export RCTL_LOCAL=1

printf 'Content-Type: text/plain; charset=utf-8\r\n'
printf 'Cache-Control: no-store\r\n'
printf 'X-Content-Type-Options: nosniff\r\n'
printf '\r\n'

# --- разбор query string -----------------------------------------------------
qs="${QUERY_STRING:-}"
field() {
  printf '%s' "$qs" | tr '&' '\n' | sed -n "s/^$1=//p" | head -1 |
    sed 's/+/ /g; s/%\(..\)/\\x\1/g' | ( printf '%b' "$(cat)" )
}

a=$(field a)
v=$(field v)

DOM_RE='^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$'

die() { echo "✗ $1"; exit 0; }

# Из браузера домен приезжает как попало: со схемой, слэшем, www, заглавными,
# иногда с портом. Приводим к голому имени ДО проверки регуляркой — иначе
# «https://militarysummary.com/» отлетало как «это не похоже на домен».
norm_dom() {
  printf '%s' "$1" |
    tr 'A-Z' 'a-z' |
    sed 's|^[[:space:]]*||; s|[[:space:]]*$||
         s|^[a-z][a-z0-9+.-]*://||
         s|^[^/@]*@||
         s|[/?#].*$||
         s|:[0-9]*$||
         s|^www\.||
         s|\.$||'
}

case "$a" in
  # --- только чтение ---
  status)    exec "$RCTL" status ;;
  doctor)    exec "$RCTL" doctor ;;
  yttest)    exec "$RCTL" yttest ;;
  twitch)
    if [ -n "$v" ]; then
      echo "$v" | grep -qE '^[A-Za-z0-9_]{2,32}$' || die "кривое имя канала: $v"
      exec "$RCTL" twitch "$v"
    fi
    exec "$RCTL" twitch ;;
  info)      exec "$RCTL" info ;;
  meta)      exec "$RCTL" meta ;;
  nodes)     exec "$RCTL" nodes list ;;
  nodenames) exec "$RCTL" nodes names ;;
  domains)   exec "$RCTL" domains list ;;
  geolist)   exec "$RCTL" geoblock list ;;
  geocount)  exec "$RCTL" geoblock count ;;
  tgcount)   exec "$RCTL" telegram-cidr count ;;
  logs)
    case "$v" in
      sing-box|zapret|dns) exec "$RCTL" logs "$v" ;;
      *) die "неизвестный лог: $v" ;;
    esac ;;

  # --- живая проверка сервисов (долгое уходит в фон, панель тянет прогресс) ---
  svcshow)     exec /usr/sbin/svcprobe show ;;
  svcrun)      exec /usr/sbin/svcprobe run bg ;;
  svcscore)    exec /usr/sbin/svcprobe score bg ;;
  svcscorelog) exec /usr/sbin/svcprobe scorelog ;;
  svclog)      exec /usr/sbin/svcprobe log ;;

  # --- дневник ютуба ---
  ytlog)    exec /usr/sbin/ytwatch log 30 ;;
  ytstat)   exec /usr/sbin/ytwatch stat ;;
  ytsample) exec /usr/sbin/ytwatch sample ;;

  # --- свип стратегий по скорости ---
  sweepstatus) exec /usr/sbin/zapret-sweep status ;;
  sweepresult) exec /usr/sbin/zapret-sweep result ;;
  sweeplog)
    # статус + текущая таблица: одним куском, чтобы панель просто печатала
    /usr/sbin/zapret-sweep status
    echo ""
    exec /usr/sbin/zapret-sweep result ;;
  sweepstop)   exec /usr/sbin/zapret-sweep stop ;;
  sweepstart)
    echo "$v" | grep -qE '^[0-9]{1,2}$' || v=12
    exec /usr/sbin/zapret-sweep start "$v" ;;

  # --- подбор стратегии zapret ---
  tunestatus) exec /usr/sbin/zapret-tune status ;;
  tuneprogress)
    # статус + хвост живого лога blockcheck: видно, что перебор реально идёт
    /usr/sbin/zapret-tune status
    echo ""
    exec /usr/sbin/zapret-tune log ;;
  tuneresult) exec /usr/sbin/zapret-tune result ;;
  tunelog)    exec /usr/sbin/zapret-tune log ;;
  tunestop)   exec /usr/sbin/zapret-tune stop ;;
  tunestart)
    case "$v" in
      quick|standard|force) exec /usr/sbin/zapret-tune start youtube.com "$v" ;;
      *) die "уровень: quick|standard|force" ;;
    esac ;;
  tuneapply)
    # по номеру строки из result, чтобы строка стратегии не ездила через браузер
    echo "$v" | grep -qE '^[0-9]{1,2}$' || die "нужен номер стратегии"
    s=$(/usr/sbin/zapret-tune result | sed -n "${v}p")
    [ -n "$s" ] || die "нет стратегии №$v — перезапусти подбор"
    exec /usr/sbin/zapret-tune apply "$s" ;;

  # --- меняют состояние, но безопасно и обратимо ---
  fix)       exec "$RCTL" fix ;;
  best)      exec "$RCTL" nodes best ;;
  auto)      exec "$RCTL" nodes auto ;;
  use)
    # Имена нод приходят из подписки: флаг-эмодзи, кириллица, пробелы, а у
    # некоторых ещё и хвостовой пробел — под прежнюю ASCII-регулярку не
    # подходило ни одно, и панель отвечала «кривое имя ноды» на любую живую
    # ноду. Проверяем не набор символов, а членство в реальном списке:
    # чего нет у clash API, то до rctl не доедет.
    [ -n "$v" ] || die "не задано имя ноды"
    case "$v" in *'"'*|*'\'*) die "кривое имя ноды" ;; esac
    names=$("$RCTL" nodes names | sed -n 's/^node: //p')
    [ -n "$names" ] || die "clash API не ответил — sing-box запущен?"
    printf '%s\n' "$names" | grep -qxF "$v" || die "нет такой ноды: $v"
    exec "$RCTL" nodes use "$v" ;;
  restart)
    case "$v" in
      sing-box|zapret|dnsmasq|https-dns-proxy) exec "$RCTL" restart "$v" ;;
      *) die "нельзя рестартить: $v" ;;
    esac ;;
  quic)
    case "$v" in on|off) exec "$RCTL" quic "$v" ;; *) die "quic on|off" ;; esac ;;
  dnsforce)
    case "$v" in on|off|status|"") exec /usr/sbin/dnsforce "${v:-status}" ;;
      *) die "dnsforce on|off|status" ;; esac ;;
  geoupdate) exec "$RCTL" geoblock update ;;
  tgupdate)  exec "$RCTL" telegram-cidr update ;;
  watchdog)  exec "$RCTL" watchdog ;;
  domadd)
    d=$(norm_dom "$v")
    echo "$d" | grep -qE "$DOM_RE" || die "это не похоже на домен: $v"
    [ "$d" = "$v" ] || echo ":: понял как $d"
    exec "$RCTL" domains add "$d" ;;
  domrm)
    d=$(norm_dom "$v")
    echo "$d" | grep -qE "$DOM_RE" || die "это не похоже на домен: $v"
    [ "$d" = "$v" ] || echo ":: понял как $d"
    exec "$RCTL" domains rm "$d" ;;
  domcheck)
    d=$(norm_dom "$v")
    echo "$d" | grep -qE "$DOM_RE" || die "это не похоже на домен: $v"
    exec "$RCTL" domains check "$d" ;;
  domscout)
    # Разведка спутников: слушаем DNS-запросы того устройства, с которого
    # открыли панель, — сайту почти всегда нужны домены, которых в его имени
    # нет (страница на одном, поток на другом).
    case "$v" in ""|*[!0-9]*) v=45 ;; esac
    exec "$RCTL" domains scout "$v" "${REMOTE_ADDR:--}" ;;

  *) die "неизвестное действие: ${a:-<пусто>}" ;;
esac
