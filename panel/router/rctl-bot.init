#!/bin/sh /etc/rc.common
# procd-сервис для Telegram-бота роутера.
START=99
STOP=10
USE_PROCD=1

start_service() {
    [ -f /etc/rctl-bot.conf ] || return 0
    # без токена не стартуем — иначе бесконечный респавн с ошибкой
    . /etc/rctl-bot.conf
    [ -n "${BOT_TOKEN:-}" ] || return 0

    procd_open_instance
    procd_set_param command /bin/sh /usr/sbin/rctl-bot
    procd_set_param respawn 30 10 0
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger network
}
