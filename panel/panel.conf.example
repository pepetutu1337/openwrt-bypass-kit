# ============================================================
#  panel.conf — как достучаться до ТВОЕГО живого роутера.
#  (это не кит — панель управляет уже настроенным вручную роутером)
# ============================================================
ROUTER_IP="192.168.1.1"
ROUTER_SSH_USER="root"
ROUTER_SSH_PORT="22"
# ROUTER_SSH_KEY="$HOME/.ssh/id_ed25519"   # если нужен конкретный ключ

# clash/sing-box API на роутере (для активной ноды и переключения)
CLASH_API="127.0.0.1:9090"
# тест-домен по умолчанию для «Чекап»
DOCTOR_DOMAIN="claude.ai"
